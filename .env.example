# QMOI Enhanced - Environment Configuration Template
# TEMPLATE: Copy this file to .env.local for development
# For production deployment, create .env.production with actual secrets.

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
APP_NAME=QMOI Enhanced
APP_VERSION=2.0.0

# ============================================================================
# DATABASE
# ============================================================================
# Local SQLite for development (as per schema.prisma)
DATABASE_URL=file:./prisma/dev.db
# Or PostgreSQL for production-like testing:
# DATABASE_URL=postgresql://user:password@localhost:5432/qmoi_dev
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT=30000
DATABASE_LOG_QUERIES=false

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=<CHANGE_ME_IN_PRODUCTION>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OAuth/Social Login (optional)
GOOGLE_CLIENT_ID=your-dev-google-client-id
GOOGLE_CLIENT_SECRET=your-dev-google-client-secret
GITHUB_CLIENT_ID=your-dev-github-client-id
GITHUB_CLIENT_SECRET=your-dev-github-client-secret

# ============================================================================
# EMAIL SERVICE
# ============================================================================
# For development, use 'console' or 'mailhog'
EMAIL_PROVIDER=sendgrid  # For production, use sendgrid or equivalent
EMAIL_FROM=dev@localhost
EMAIL_FROM_NAME=QMOI Dev

# SendGrid (optional)
SENDGRID_API_KEY=<SET_IN_ENV_PRODUCTION>

# AWS SES (optional)
AWS_REGION=us-east-1
AWS_SES_USER=
AWS_SES_PASSWORD=

# SMTP (Local Mailhog or similar)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ============================================================================
# AI SERVICES
# ============================================================================
# OpenAI API (Primary AI Service)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=  # Optional
OPENAI_PROJECT=  # Optional

# Anthropic Claude (Secondary AI Service)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugging Face (For specialized models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_MODEL=qmoi-enhanced-model  # Custom model name

# AI Service Configuration
AI_PROVIDER=auto  # auto, openai, anthropic, huggingface
AI_MODEL=gpt-4-turbo-preview  # Default model
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_FALLBACK_ENABLED=true

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================
# For development, use Stripe test keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
ERROR_TRACKING_URL=
ERROR_TRACKING_TOKEN=

METRICS_URL=
METRICS_TOKEN=

LOG_LEVEL=debug
LOG_FORMAT=simple

# ============================================================================
# STORAGE
# ============================================================================
STORAGE_TYPE=local  # local, s3, gcs, azure
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# ============================================================================
# NOTIFICATIONS
# ============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# VERCEL (Deployment)
# ============================================================================
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
QMOI_AUTO_SETUP_ENABLED=false
QMOI_AUTO_FIX_ENABLED=false
QMOI_AUTODEV_ENABLED=false
QMOI_AUTO_MONITORING_ENABLED=false
QMOI_AUTO_HEALTH_CHECK_ENABLED=false
QMOI_AUTO_RECOVERY_ENABLED=false

VERCEL_AUTO_DEPLOY=false
VERCEL_AUTO_SCALE=false
VERCEL_AUTO_ROLLBACK=false

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================
# Use Redis if available, otherwise in-memory cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL=3600
SESSION_SECRET=dev-session-secret

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=false  # Set to true to test rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# Security Headers
SECURITY_HEADER_CSP=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'
SECURITY_HEADER_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HEADER_X_CONTENT_TYPE_OPTIONS=nosniff

# ============================================================================
# ANALYTICS
# ============================================================================
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
SEGMENT_WRITE_KEY=

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

GITHUB_API_TOKEN=
GITHUB_WEBHOOK_SECRET=

GITLAB_API_TOKEN=
GITLAB_WEBHOOK_SECRET=

# ============================================================================
# AI & ML SERVICES
# ============================================================================
OPENAI_API_KEY=
OPENAI_ORG_ID=

HUGGING_FACE_API_TOKEN=

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
MAX_REQUEST_SIZE=50mb
REQUEST_TIMEOUT=60000
WORKER_THREADS=2

# Prisma
PRISMA_SKIP_PRISMA_VERSION_CHECK=false

# ============================================================================
# DEVELOPMENT-ONLY FLAGS
# ============================================================================
DEBUG=qmoi:*
VERBOSE_LOGGING=true
SKIP_BUILD_VALIDATION=false
