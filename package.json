    "express": "^4.18.2",
    "express-session": "^1.17.0",
    "framer-motion": "^12.23.25",
    "globby": "^13.2.2",
    "imapflow": "^1.2.18",
    "input-otp": "^1.4.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.555.0",
    "next": "^16.2.4",
    "next-themes": "^0.2.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.16.0",
    "otplib": "^12.0.1",
    "paypal-rest-sdk": "^1.8.1",
    "pm2": "^6.0.14",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-query": "^3.39.3",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.13.1",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "vm2": "^3.10.5",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "prodDependencies": {
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
