{
  "name": "qmoi-enhanced-system",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "next start",
    "prod": "next prod",
    "prod:vite": "cd dashboard && vite",
    "build": "next build",
    "build:vite": "cd dashboard && vite build",
    "production:vite": "cd dashboard && vite production",
    "prod:[production_IMPLEMENTED]": "node scripts/prod-[production_IMPLEMENTED].js",
    "prod:health": "./scripts/prod-healthcheck.sh",
    "lint": "eslint -c .eslintrc.cjs \"app/**/*.{js,jsx,ts,tsx}\" \"pages/**/*.{js,jsx,ts,tsx}\" \"app/components/**/*.{js,jsx,ts,tsx}\" --max-warnings 100 || true",
    "lint:fix": "eslint -c .eslintrc.cjs \"**/*.{js,ts,tsx,jsx}\" --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check:unused": "python scripts/check_unused_components.py",
    "fix:types:dry": "node scripts/convert-any-unused.cjs",
    "fix:types": "node scripts/convert-any-unused.cjs --apply",
    "ci:build": "NODE_OPTIONS=--max-old-space-size=8192 CI=false next build",
    "prod:start": "./scripts/prod-start.sh",
    "start:prod:pm2": "npx pm2 start ecosystem.config.cjs --only qmoi-next --env production",
    "stop:prod:pm2": "npx pm2 stop ecosystem.config.js --only qmoi-next",
    "test:auth": "node ./scripts/tests/requireApiKeyTest.js",
    "test:endpoint": "node ./scripts/tests/endpoint_gating_test.js",
    "test:flags": "node ./scripts/tests/route_flags_test.js",
    "test:authpresence": "node ./scripts/tests/auth_gating_presence_test.js",
    "test:all": "npm run test:auth && npm run test:flags && npm run test:authpresence && npm run test:endpoint",
    "ci:test": "npm run ci:build && npm run test:flags && npm run test:auth && npm run test:authpresence && npm run test:endpoint",
    "test:optimized-qmoi": "node scripts/quick_qmoi_checks.js",
    "check:[production_IMPLEMENTED]s": "node scripts/enforce-no-[production_IMPLEMENTED]s.cjs",
    "env-setup": "node scripts/qmoi-env-setup.js",
    "db:setup": "bash scripts/setup-production.sh",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:verify": "bash scripts/verify-startup.sh",
    "dev": "next dev",
    "diagnose:trace": "node ./scripts/diagnostics/parse_next_trace.cjs .next/trace 20",
    "trading:genkey": "node scripts/auto_trading.js --genkey",
    "trading:publicip": "node scripts/auto_trading.js --publicip",
    "trading:check": "node scripts/auto_trading.js",
    "trading:start": "node scripts/auto_trading.js",
    "ci:smoke": "node scripts/smoke-check.js",
    "ci:full": "npm run ci:build && npm run validate:ui && SKIP_COVERAGE_THRESHOLD=true npm run test:coverage --if-present && npm run ci:smoke || true",
    "docker:build": "docker build -t qmoi-enhanced:latest .",
    "ci:verify": "npm run ci:build && npm run lint && npm run validate:ui && npm run test:coverage",
    "serve:static": "node scripts/serve-static.js",
    "balance:start": "node scripts/production-balance-system.ts",
    "balance:status": "node scripts/production-balance-system.ts status",
    "q-balances:start": "node scripts/production-q-balances.ts",
    "q-balances:status": "node scripts/production-q-balances.ts --status",
    "q-balances:stop": "node scripts/production-q-balances.ts --stop",
    "q-balances:start:python": "python3 scripts/production-q-balances.py",
    "q-balances:status:python": "python3 scripts/production-q-balances.py --status",
    "q-balances:stop:python": "python3 scripts/production-q-balances.py --stop",
    "balance:reconcile": "node scripts/production-balance-system.ts reconcile",
    "balance:triggers": "node scripts/production-balance-system.ts triggers",
    "balance:update": "node scripts/production-balance-system.ts update",
    "balance:auto-update": "node scripts/balance-auto-update.ts",
    "balance:monitor": "node scripts/balance-monitoring.ts",
    "e2e:headless": "cypress run --headless",
    "e2e:ci": "cypress run --record --parallel",
    "update-links": "./update_vercel_links.sh",
    "update-links:verbose": "./update_vercel_links.sh --verbose",
    "update-links:force": "./update_vercel_links.sh --force",
    "update-api-docs": "node scripts/update_api_docs.js",
    "autoupdate-api-docs": "bash scripts/autoupdate_api_docs.sh",
    "check-deployment": "node scripts/check-deployment.js",
    "verify-vercel": "npm run update-links && npm run check-deployment",
    "test": "jest",
    "validate:ui": "python3 scripts/comprehensive_ui_validation.py",
    "validate:ui:quiet": "python3 scripts/comprehensive_ui_validation.py > /dev/null 2>&1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
