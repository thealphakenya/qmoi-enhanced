ckground: \"#222\",\n          padding: 8,\n          borderRadius: 6,\n        }}\n      >\n        {messages.map((m, i) => (\n          <div key={i} style={{ marginBottom: 6 }}>\n            <b style={{ color: m.user === \"master\" ? \"#fff\" : \"#0f0\" }}>\n              {m.user}:\n            </b>{\" \"}\n            {m.text}\n          </div>\n        ))}\n        {loading && <div style={{ color: \"#ff0\" }}>Processing...</div>}\n      </div>\n      <form onSubmit={handleSubmit} style={{ display: \"flex\", gap: 8 }}>\n        <input\n          value={input}\n          onChange={(_e) => setInput(_e.target.value)}\n          [PRODUCTION_IMPLEMENTED]=\"/view /edit /append /replace ...\"\n          style={{\n            flex: 1,\n            background: \"#111\",\n            color: \"#e0ffe0\",\n            border: \"1px solid #333\",\n            borderRadius: 4,\n            padding: 8,\n          }}\n        />\n        <button\n          type=\"submit\"\n          style={{\n            background: \"#0f0\",\n            color: \"#111\",\n            border: \"none\",\n            borderRadius: 4,\n            padding: \"0 16px\",\n            fontWeight: 600,\n          }}\n        >\n          Send\n        </button>\n      </form>\n    </div>\n  );\n}\n",
