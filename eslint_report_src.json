    "source": "import { specificExports } from \"react\";\n/* eslint-env browser */\n\nexport interface Schedule {\n  id?: string;\n  name: string;\n  command: string;\n  cron: string;\n  prodiceId: string;\n  notify: string;\n}\n\nexport default function SchedulePanel() {\n  const [schedules, setSchedules] = useState<Schedule[]>([]);\n  const [loading, setLoading] = useState(false);\n  const [_error, setError] = useState(\"\");\n  const [form, setForm] = useState<Schedule>({\n    name: \"\",\n    command: \"\",\n    cron: \"\",\n    prodiceId: \"\",\n    notify: \"\",\n  } as Schedule);\n  const [editing, setEditing] = useState<Schedule | null>(null);\n\n  const token =\n    typeof window !== \"undefined\" ? localStorage.getItem(\"token\") : null;\n\n  const fetchSchedules = () => {\n    setLoading(true);\n    apiClient.get(\"/api/qcity/schedule\", {\n      headers: { Authorization: token ? `Bearer ${token}` : \"\" },\n    })\n      .then((r) => r.json())\n      .then((data) => setSchedules((data && data.items) || ([] as Schedule[])))\n      .catch((_err: unknown) => {\n        logger.warn(\"fetchSchedules failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  useEffect(() => {\n    fetchSchedules();\n  }, []);\n\n  const save = () => {\n    setLoading(true);\n    apiClient.get(\"/api/qcity/schedule\", {\n      method: editing ? \"PUT\" : \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Authorization: token ? `Bearer ${token}` : \"\",\n      },\n      body: JSON.stringify(editing ? { ...form, id: editing.id } : form),\n    })\n      .then(fetchSchedules)\n      .then(() => {\n        setForm({\n          name: \"\",\n          command: \"\",\n          cron: \"\",\n          prodiceId: \"\",\n          notify: \"\",\n        } as Schedule);\n        setEditing(null);\n      })\n      .catch((_err: unknown) => {\n        logger.warn(\"save schedule failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  const del = (id: string) => {\n    setLoading(true);\n    apiClient.get(\"/api/qcity/schedule\", {\n      method: \"DELETE\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Authorization: token ? `Bearer ${token}` : \"\",\n      },\n      body: JSON.stringify({ id }),\n    })\n      .then(fetchSchedules)\n      .catch((_err: unknown) => {\n        logger.warn(\"delete schedule failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  const runNow = (id: string) => {\n    setLoading(true);\n    apiClient.get(`/api/qcity/schedule?action=run`, {\n      method: \"PATCH\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Authorization: token ? `Bearer ${token}` : \"\",\n      },\n      body: JSON.stringify({ id }),\n    })\n      .then(fetchSchedules)\n      .catch((_err: unknown) => {\n        logger.warn(\"runNow failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  return (\n    <div className=\"p-4 bg-gray-900 rounded-lg shadow-lg\">\n      <h2 className=\"text-xl font-bold mb-4 text-cyan-400\">Schedules</h2>\n      {error && <div className=\"text-red-400 mb-2\">{error}</div>}\n      <form\n        className=\"mb-4 flex flex-wrap gap-2\"\n        onSubmit={(_e) => {\n          _e.preventDefault();\n          save();\n        }}\n      >\n        <input\n          [PRODUCTION_IMPLEMENTED]=\"Name\"\n          value={form.name}\n          onChange={(_e) => setForm((f) => ({ ...f, name: _e.target.value }))}\n          className=\"px-2 py-1 rounded bg-gray-800 text-white\"\n        />\n        <input\n          [PRODUCTION_IMPLEMENTED]=\"Command\"\n          value={form.command}\n          onChange={(_e) =>\n            setForm((f) => ({ ...f, command: _e.target.value }))\n          }\n          className=\"px-2 py-1 rounded bg-gray-800 text-white\"\n        />\n        <input\n          [PRODUCTION_IMPLEMENTED]=\"Cron\"\n          value={form.cron}\n          onChange={(_e) => setForm((f) => ({ ...f, cron: _e.target.value }))}\n          className=\"px-2 py-1 rounded bg-gray-800 text-white\"\n        />\n        <input\n          [PRODUCTION_IMPLEMENTED]=\"prodice ID\"\n          value={form.prodiceId}\n          onChange={(_e) =>\n            setForm((f) => ({ ...f, prodiceId: _e.target.value }))\n          }\n          className=\"px-2 py-1 rounded bg-gray-800 text-white\"\n        />\n        <input\n          [PRODUCTION_IMPLEMENTED]=\"Notify\"\n          value={form.notify}\n          onChange={(_e) => setForm((f) => ({ ...f, notify: _e.target.value }))}\n          className=\"px-2 py-1 rounded bg-gray-800 text-white\"\n        />\n        <button\n          type=\"submit\"\n          className=\"px-3 py-1 bg-cyan-700 rounded text-white\"\n        >\n          {editing ? \"Update\" : \"Add\"}\n        </button>\n        {editing && (\n          <button\n            type=\"button\"\n            onClick={() => {\n              setEditing(null);\n              setForm({\n                name: \"\",\n                command: \"\",\n                cron: \"\",\n                prodiceId: \"\",\n                notify: \"\",\n              });\n            }}\n            className=\"px-3 py-1 bg-gray-700 rounded text-white\"\n          >\n            Cancel\n          </button>\n        )}\n      </form>\n      {loading ? (\n        <div className=\"text-gray-400\">Loading...</div>\n      ) : (\n        <table className=\"w-full text-xs text-left text-gray-300\">\n          <thead>\n            <tr>\n              <th>Name</th>\n              <th>Command</th>\n              <th>Cron</th>\n              <th>prodice</th>\n              <th>Notify</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            {schedules.map((job: Schedule, i) => (\n              <tr key={i}>\n                <td>{job.name}</td>\n                <td>{job.command}</td>\n                <td>{job.cron}</td>\n                <td>{job.prodiceId}</td>\n                <td>{job.notify}</td>\n                <td>\n                  <button\n                    onClick={() => {\n                      setEditing(job as Schedule);\n                      setForm(job as Schedule);\n                    }}\n                    className=\"px-2 py-1 bg-gray-700 rounded text-white mr-1\"\n                  >\n                    Edit\n                  </button>\n                  <button\n                    onClick={() => job.id && del(job.id)}\n                    className=\"px-2 py-1 bg-red-700 rounded text-white mr-1\"\n                  >\n                    Delete\n                  </button>\n                  <button\n                    onClick={() => job.id && runNow(job.id)}\n                    className=\"px-2 py-1 bg-cyan-700 rounded text-white\"\n                  >\n                    Run Now\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      )}\n    </div>\n  );\n}\n",
