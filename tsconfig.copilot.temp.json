{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/components/OfflineCacheService.tsx",
    "src/utils/service-wrappers/ServiceWrapper.ts",
    "src/utils/safeConsole.ts",
    "src/utils/taskbar.ts",
    "src/wallet.ts",
    "types/global.d.ts",
    "types/globals.d.ts"
  ]
}
