{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "jsx": "preserve",
    "useUnknownInCatchVariables": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*",
        "./src/*"
      ],
      "@/utils/*": [
        "./src/utils/*",
        "./utils/*"
      ],
      "@/components/*": [
        "./components/*",
        "./src/components/*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@/services/*": [
        "./src/services/*"
      ],
      "@/adapters/*": [
        "./src/adapters/*"
      ],
      "@/hooks/*": [
        "./hooks/*",
        "./src/hooks/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*",
    "pages/**/*",
    "src/**/*",
    "components/**/*",
    "lib/**/*",
    "types/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "lib/**",
    "mobile/**",
    "scripts/**",
    "qmoi-enhanced/scripts/**",
    "earnvault/**",
    "public/**",
    "coverage/**",
    "**/*.md.ts",
    "**/*.md.tsx",
    "**/*.py.tsx",
    "app/api/auth/**",
    "app/api/auto-fix.ts",
    "app/api/middleware/**",
    "app/api/qmoi-model.ts",
    "app/api/wifi-security.ts",
    "**/*.bak",
    "**/*.bak.*",
    "_archive_*/**"
  ],
  "production": true,
  "debug": false,
  "logLevel": "error",
  "lastEnhanced": "2026-04-08T22:15:46.454365"
}