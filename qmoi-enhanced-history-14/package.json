{
  "name": "qmoi-enhanced-system",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "dev:placeholder": "node scripts/dev-placeholder.js",
    "dev:health": "./scripts/dev-healthcheck.sh",
    "build": "next build",
    "lint": "eslint \"**/*.{js,ts,tsx}\" || true",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix || true",
    "fix:types:dry": "node scripts/convert-any-unused.cjs",
    "fix:types": "node scripts/convert-any-unused.cjs --apply",
    "ci:build": "NODE_OPTIONS=--max-old-space-size=8192 CI=false next build",
    "test:coverage": "jest --config=jest.config.cjs --coverage --runInBand --colors",
    "prod:start": "./scripts/prod-start.sh",
    "start:prod:pm2": "npx pm2 start ecosystem.config.cjs --only qmoi-next --env production",
    "stop:prod:pm2": "npx pm2 stop ecosystem.config.js --only qmoi-next",
    "test:auth": "node ./scripts/tests/requireApiKeyTest.js",
    "test:endpoint": "node ./scripts/tests/endpoint_gating_test.js",
    "test:flags": "node ./scripts/tests/route_flags_test.js",
    "test:authpresence": "node ./scripts/tests/auth_gating_presence_test.js",
    "test:all": "npm run test:auth && npm run test:flags && npm run test:authpresence && npm run test:endpoint",
    "ci:test": "npm run ci:build && npm run test:flags && npm run test:auth && npm run test:authpresence && npm run test:endpoint",
    "test:quick-qmoi": "node scripts/quick_qmoi_checks.js",
    "test:qmoi-jest": "node scripts/run_qmoi_test.cjs",
    "env-setup": "node scripts/qmoi-env-setup.js",
    "diagnose:trace": "node ./scripts/diagnostics/parse_next_trace.cjs .next/trace 20",
    "trading:genkey": "node scripts/auto_trading.js --genkey",
    "trading:publicip": "node scripts/auto_trading.js --publicip",
    "trading:check": "node scripts/auto_trading.js",
    "trading:start": "node scripts/auto_trading.js",
    "ci:smoke": "node scripts/smoke-check.js",
    "ci:full": "npm run ci:build && SKIP_COVERAGE_THRESHOLD=true npm run test:coverage --if-present && npm run ci:smoke",
    "docker:build": "docker build -t qmoi-enhanced:latest .",
    "ci:verify": "npm run ci:build && npm run lint && npm run test:coverage",
    "serve:static": "node scripts/serve-static.js",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "e2e": "cypress open",
    "e2e:run": "cypress run",
    "e2e:headless": "cypress run --headless",
    "e2e:ci": "cypress run --record --parallel",
    "update-links": "./update_vercel_links.sh",
    "update-links:verbose": "./update_vercel_links.sh --verbose",
    "update-links:force": "./update_vercel_links.sh --force",
    "check-deployment": "node scripts/check-deployment.js",
    "verify-vercel": "npm run update-links && npm run check-deployment"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/inference": "^4.13.10",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@sendgrid/mail": "^8.1.6",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "framer-motion": "^12.23.25",
    "globby": "^13.2.2",
    "input-otp": "^1.4.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.555.0",
    "next": "^16.3.3",
    "next-themes": "^0.2.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.16.0",
    "otplib": "^12.0.1",
    "paypal-rest-sdk": "^1.8.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-query": "^3.39.3",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "winston": "^3.18.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@tailwindcss/postcss": "^4.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^30.2.0",
    "cypress": "^15.21.1",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.48.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "msw": "^2.12.7",
    "node-fetch": "^2.6.7",
    "pm2": "^6.0.14",
    "prisma": "^6.19.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "web-streams-polyfill": "^4.2.0",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "author": "QMOI Development Team",
