{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "QMOI Space - Decentralized Marketplace",
  "short_name": "QMOI Space",
  "description": "Decentralized marketplace and community platform with integrated payment systems and peer-to-peer commerce",
  "start_url": "/pwa_apps/qmoi-space/",
  "scope": "/pwa_apps/qmoi-space/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#1a0033",
  "theme_color": "#9C27B0",
  "dir": "ltr",
  "lang": "en-US",
  "categories": ["shopping", "business", "social"],
  "icons": [
    {
      "src": "/pwa_apps/qmoi-space/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa_apps/qmoi-space/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa_apps/qmoi-space/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Marketplace",
      "short_name": "Marketplace",
      "description": "Browse QMOI Space marketplace",
      "url": "/pwa_apps/qmoi-space/?page=marketplace"
    },
    {
      "name": "My Sales",
      "short_name": "Sales",
      "description": "View your sales and transactions",
      "url": "/pwa_apps/qmoi-space/?page=sales"
    }
  ],
  "prefer_related_applications": false
}
