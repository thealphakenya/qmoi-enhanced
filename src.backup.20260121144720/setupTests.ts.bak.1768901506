      }
      if (stores.transaction && stores.transaction.size === 0) {
        stores.transaction.set("tx_1", {
          id: "tx_1",
          walletId: "wallet_1",
          amount: 1000,
          type: "deposit",
          status: "completed",
          timestamp: now,
        });
