      configurable: true,
      enumerable: true,
      writable: true,
      value: _url,
    });
    Object.defineProperty(this, "method", {
      configurable: true,
      enumerable: true,
      writable: true,
      value: (init && init.method) || "GET",
    });
    Object.defineProperty(this, "headers", {
      configurable: true,
      enumerable: true,
      writable: true,
      value: new (global as any).Headers(
