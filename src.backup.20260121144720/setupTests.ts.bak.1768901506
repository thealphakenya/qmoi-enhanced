        s: string,
        o?: Record<string, unknown>,
      ) => unknown;
      return new RespCtor(JSON.stringify(body), {
        status: Number((init as Record<string, unknown>)?.status ?? 200),
        headers: { "Content-Type": "application/json", ...headersObj },
