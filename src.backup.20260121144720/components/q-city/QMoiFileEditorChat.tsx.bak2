            <div style={{ marginTop: 8 }}>
              <b>Before:</b>
              {highlightCode(before)}
            </div>
            <div style={{ marginTop: 8 }}>
              <b>After:</b>
              {highlightCode(after)}
            </div>
          </div>
        ) : (
          `Error: ${data._error}`
        );
