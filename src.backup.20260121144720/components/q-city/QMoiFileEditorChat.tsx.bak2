              borderRadius: 4,
              padding: "4px 12px",
              fontWeight: 600,
              marginLeft: 8,
            }}
          >
            Cancel
          </button>
        </div>
      )}
      <div
        style={{
          maxHeight: 240,
          overflowY: "auto",
          marginBottom: 12,
          background: "#222",
          padding: 8,
          borderRadius: 6,
        }}
      >
        {messages.map((m, i) => (
          <div key={i} style={{ marginBottom: 6 }}>
            <b style={{ color: m.user === "master" ? "#fff" : "#0f0" }}>
              {m.user}:
