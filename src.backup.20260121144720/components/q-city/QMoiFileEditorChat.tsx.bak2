            style={{
              width: "60%",
              marginRight: 8,
              background: "#111",
              color: "#e0ffe0",
              border: "1px solid #333",
              borderRadius: 4,
              padding: 4,
            }}
          />
          <input
            value={batchOp}
            onChange={(_e) => setBatchOp(_e.target.value)}
            placeholder="operation (_e.g. lint, format)"
            style={{
