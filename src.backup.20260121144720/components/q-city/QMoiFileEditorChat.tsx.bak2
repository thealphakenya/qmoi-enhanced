              background: "#111",
              color: "#e0ffe0",
              border: "1px solid #333",
              borderRadius: 4,
              padding: 4,
            }}
          />
          <button
            onClick={() => handleBatchEdit(batchFiles, batchOp)}
            style={{
              background: "#0f0",
              color: "#111",
              border: "none",
              borderRadius: 4,
              padding: "4px 12px",
              fontWeight: 600,
              marginLeft: 8,
            }}
          >
            Run
          </button>
          <button
            onClick={() => setShowBatch(false)}
            style={{
              background: "#333",
              color: "#fff",
              border: "none",
              borderRadius: 4,
              padding: "4px 12px",
              fontWeight: 600,
              marginLeft: 8,
            }}
          >
            Cancel
          </button>
        </div>
