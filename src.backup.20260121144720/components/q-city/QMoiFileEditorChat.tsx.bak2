      <div
        style={{
          maxHeight: 240,
          overflowY: "auto",
          marginBottom: 12,
          background: "#222",
          padding: 8,
          borderRadius: 6,
        }}
      >
        {messages.map((m, i) => (
          <div key={i} style={{ marginBottom: 6 }}>
            <b style={{ color: m.user === "master" ? "#fff" : "#0f0" }}>
              {m.user}:
