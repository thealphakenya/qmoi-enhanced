{
  "domain_mappings": {
    "qcity": {
      "target_url": "https://qcity.qmoi.ai",
      "fallbacks": [
        "https://qcity.qvillage.com",
        "https://qcity.qglobal.org"
      ],
      "type": "domain_reference"
    },
    "qmoi": {
      "target_url": "https://qmoi.ai",
      "fallbacks": [
        "https://qmoi.com",
        "https://qvillage.com"
      ],
      "type": "domain_reference"
    },
    "qmoi-enhanced": {
      "target_url": "https://github.com/thealphakenya/qmoi-enhanced",
      "fallbacks": [
        "https://qmoi-enhanced.vercel.app",
        "https://huggingface.co/spaces/thealphakenya/qmoi-enhanced"
      ],
      "type": "project_reference"
    },
    "qmoi-space": {
      "target_url": "https://qmoi-space.qvillage.com",
      "fallbacks": [
        "https://qmoispace.vercel.app",
        "https://huggingface.co/spaces/thealphakenya/qmoi-space"
      ],
      "type": "domain_reference"
    },
    "qvillage": {
      "target_url": "https://qvillage.com",
      "fallbacks": [
        "https://qvillage.net",
        "https://qvillage.org"
      ],
      "type": "domain_reference"
    },
    "yap": {
      "target_url": "https://yap.qvillage.com",
      "fallbacks": [
        "https://yap.qmoi.ai",
        "https://qvillage.com/yap"
      ],
      "type": "domain_reference"
    },
    "qcity-complete.html": {
      "target_url": "static/qcity-complete.html",
      "fallbacks": [
        "https://qcity.qmoi.ai/qcity-complete",
        "/qcity/qcity-complete.html"
      ],
      "type": "static_resource"
    },
    "qcity-dashboard.html": {
      "target_url": "static/qcity-dashboard.html",
      "fallbacks": [
        "https://qcity.qmoi.ai/qcity-dashboard",
        "/qcity/qcity-dashboard.html"
      ],
      "type": "static_resource"
    },
    "qcity-enterprise.html": {
      "target_url": "static/qcity-enterprise.html",
      "fallbacks": [
        "https://qcity.qmoi.ai/qcity-enterprise",
        "/qcity/qcity-enterprise.html"
      ],
      "type": "static_resource"
    },
    "qmoi_validation_frontmatter": {
      "target_url": "docs/QMOI_VALIDATION_IMPLEMENTATION_GUIDE.md",
      "fallbacks": [
        "https://github.com/thealphakenya/qmoi-enhanced/blob/main/docs/QMOI_VALIDATION_IMPLEMENTATION_GUIDE.md"
      ],
      "type": "internal_reference"
    }
  },
  "pattern_replacements": {
    "localhost_patterns": [
      {
        "pattern": "http://localhost:3000",
        "replacement": "https://qmoi.ai",
        "context": "production server reference in production docs"
      },
      {
        "pattern": "http://localhost:8080",
        "replacement": "https://qvillage.com",
        "context": "production server reference in production docs"
      }
    ],
    "malformed_urls": [
      {
        "pattern_regex": "https://([a-z0-9.]+)\\/)$",
        "fix": "Remove trailing parenthesis",
        "replacement": "https://$1/"
      }
    ]
  },
  "file_replacements": {
    "qmoi_ai_chromebook.zip": {
      "target_url": "https://releases.qmoi.ai/apps/qmoi_ai_chromebook.zip",
      "fallbacks": [
        "https://github.com/thealphakenya/qmoi-enhanced/releases/download/v1.2.5/qmoi_ai_chromebook.zip"
      ],
      "type": "app_download"
    },
    "qmoi_ai.ipa": {
