def update_undone_txt(non_production_findings, quality_analysis, improvements):
    """Update undone.txt with remaining production readiness tasks"""
    undone_path = BASE_DIR / 'undone.txt'

    undone_content = f"""# QMOI Production Readiness - Remaining Tasks
# Generated: {datetime.now().isoformat()}

## Non-Production Implementations Found ({non_production_findings['total_issues']} total issues)

"""

    for file_data in non_production_findings['files_with_issues']:
        undone_content += f"### {file_data['file']}\n"
        for issue in file_data['issues']:
            undone_content += f"- {issue['type']}: {issue['count']} instances (lines: {', '.join(map(str, issue['lines'][:5]))}{'...' if len(issue['lines']) > 5 else ''})\n"
        undone_content += "\n"

    undone_content += "## Code Quality Issues\n\n"

    for issue_type, issues in quality_analysis.items():
        if issues:
            undone_content += f"### {issue_type.replace('_', ' ').title()}\n"
            for issue in issues:
                undone_content += f"- {issue['file']}: {issue.get('issue', issue.get('function', 'N/A'))}\n"
            undone_content += "\n"

    undone_content += "## Enhancement Suggestions\n\n"

    for suggestion in improvements['enhancement_suggestions']:
        undone_content += f"- {suggestion['file']}: {suggestion['description']}\n"

    undone_content += "\n## Files Successfully Enhanced\n\n"

    for enhancement in improvements.get('enhancements_applied', []):
        undone_content += f"- {enhancement['file']}: {enhancement['enhancements_applied']} enhancements applied\n"

    undone_path.write_text(undone_content)
    logger.info(f"Updated undone.txt with {non_production_findings['total_issues']} issues and enhancement suggestions")

def generate_production_readiness_report(non_production_findings, quality_analysis, improvements, enhancements_applied):
    """Generate comprehensive production readiness report"""
    report = {
        'timestamp': datetime.now().isoformat(),
        'summary': {
            'files_scanned': non_production_findings['files_scanned'],
            'files_with_issues': len(non_production_findings['files_with_issues']),
            'total_issues': non_production_findings['total_issues'],
            'issues_by_type': non_production_findings['issues_by_type'],
            'files_enhanced': len(enhancements_applied),
            'enhancements_applied': len([e for f in enhancements_applied for e in f.get('enhancements_applied', [])])
        },
        'quality_analysis': quality_analysis,
        'improvements': improvements,
        'enhancements_applied': enhancements_applied
    }

    report_path = BASE_DIR / 'production_readiness_report.json'
    with open(report_path, 'w') as f:
        json.dump(report, f, indent=2, default=str)

    # Generate human-readable summary
    summary_content = f"""# QMOI Production Readiness Audit Report

**Generated:** {report['timestamp']}

## Executive Summary

- **Files Scanned:** {report['summary']['files_scanned']}
- **Files with Issues:** {report['summary']['files_with_issues']}
- **Total Issues Found:** {report['summary']['total_issues']}
- **Files Enhanced:** {report['summary']['files_enhanced']}
- **Enhancements Applied:** {report['summary']['enhancements_applied']}

## Issues by Type

"""
    for issue_type, count in report['summary']['issues_by_type'].items():
        summary_content += f"- {issue_type}: {count}\n"

    summary_content += "\n## Quality Analysis\n\n"

    for issue_type, issues in quality_analysis.items():
        if issues:
            summary_content += f"### {issue_type.replace('_', ' ').title()} ({len(issues)} issues)\n"
            for issue in issues[:10]:  # Show first 10
                summary_content += f"- {issue['file']}: {issue.get('issue', issue.get('function', 'N/A'))}\n"
            if len(issues) > 10:
                summary_content += f"- ... and {len(issues) - 10} more\n"
            summary_content += "\n"

    summary_content += "## Production Status\n\n"

    if report['summary']['total_issues'] == 0:
        summary_content += "🎉 **ALL SYSTEMS PRODUCTION READY**\n\n"
    else:
        remaining_issues = report['summary']['total_issues'] - report['summary']['enhancements_applied']
        if remaining_issues > 0:
            summary_content += f"⚠️ **{remaining_issues} ISSUES REMAIN** - Manual review required\n\n"
        else:
            summary_content += "✅ **ALL ISSUES ADDRESSED** - System production ready\n\n"

    summary_path = BASE_DIR / 'PRODUCTION_READINESS_REPORT.md'
    with open(summary_path, 'w') as f:
        f.write(summary_content)

    logger.info("Generated comprehensive production readiness report")

def main():
    """Main production readiness audit function"""
    logger.info("=" * 80)
    logger.info("QMOI COMPREHENSIVE PRODUCTION READINESS AUDIT")
    logger.info("=" * 80)

    # Phase 1: Scan for non-production code
    non_production_findings = scan_for_non_production_code()

    # Phase 2: Analyze code quality
    quality_analysis = analyze_code_quality()

    # Phase 3: Generate improvement suggestions
    improvements = generate_production_improvements(non_production_findings, quality_analysis)

    # Phase 4: Apply automatic enhancements
    enhancements_applied = apply_production_enhancements(improvements)

    # Phase 5: Update undone.txt and generate reports
    update_undone_txt(non_production_findings, quality_analysis, improvements)
    generate_production_readiness_report(non_production_findings, quality_analysis, improvements, enhancements_applied)

    # Summary
    logger.info("Production readiness audit completed!")
    logger.info(f"Files scanned: {non_production_findings['files_scanned']}")
    logger.info(f"Files with issues: {len(non_production_findings['files_with_issues'])}")
    logger.info(f"Total issues found: {non_production_findings['total_issues']}")
    logger.info(f"Files enhanced: {len(enhancements_applied)}")

    # Update resumefromhere.txt
    resume_file = BASE_DIR / 'resumefromhere.txt'
    if resume_file.exists():
        content = resume_file.read_text()
        issues_remaining = non_production_findings['total_issues'] - len([e for f in enhancements_applied for e in f.get('enhancements_applied', [])])
        status = "✅ COMPLETED" if issues_remaining == 0 else f"⚠️ COMPLETED ({issues_remaining} issues remain in undone.txt)"
        content = content.replace(
            '- Thorough production readiness audit: scan all scripts/features for non-production implementations, update undone.txt, replace with enhanced production implementations. ⏳ STARTING',
            f'- Thorough production readiness audit: scan all scripts/features for non-production implementations, update undone.txt, replace with enhanced production implementations. {status}'
        )
        resume_file.write_text(content)
        logger.info("Updated resumefromhere.txt with production readiness audit results")

    if non_production_findings['total_issues'] == 0:
        logger.info("🎉 SUCCESS: All implementations are production-ready!")
    else:
        logger.info(f"⚠️ AUDIT COMPLETE: {non_production_findings['total_issues']} issues identified and documented in undone.txt")


    main()