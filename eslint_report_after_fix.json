    "source": "\"use client\";\n\nimport React, { useState } from \"react\";\nimport Card from \"@mui/material/Card\";\nimport CardContent from \"@mui/material/CardContent\";\nimport CardHeader from \"@mui/material/CardHeader\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport Button from \"@mui/material/Button\";\nimport { Progress } from \"@/components/ui/progress\";\nimport {\n  User,\n  Volume2,\n  Activity,\n  Settings,\n  Zap,\n  Star,\n  TrendingUp,\n  Cpu,\n  Memory,\n  HardDrive,\n  Wifi,\n  Battery,\n  Heart,\n  Brain,\n  Sparkles,\n} from \"lucide-react\";\nimport { VoiceSelector } from \"./VoiceSelector\";\nimport { AvatarSelector } from \"./AvatarSelector\";\nimport { useQMOIState } from \"./QMOIStateProvider\";\n\nexport function QMOIDashboard() {\n  const { state, updateAvatar, updateVoice, updateMood, updateEnergy } =\n    useQMOIState();\n  const [activeTab, setActiveTab] = useState(\"overview\");\n\n  const getMoodColor = (mood: string) => {\n    switch (mood) {\n      case \"happy\":\n        return \"text-yellow-500\";\n      case \"excited\":\n        return \"text-orange-500\";\n      case \"focused\":\n        return \"text-blue-500\";\n      case \"curious\":\n        return \"text-purple-500\";\n      case \"calm\":\n        return \"text-green-500\";\n      case \"professional\":\n        return \"text-gray-500\";\n      case \"playful\":\n        return \"text-pink-500\";\n      case \"wise\":\n        return \"text-indigo-500\";\n      default:\n        return \"text-gray-500\";\n    }\n  };\n\n  const getHealthColor = (health: string) => {\n    switch (health) {\n      case \"excellent\":\n        return \"text-green-500\";\n      case \"good\":\n        return \"text-blue-500\";\n      case \"fair\":\n        return \"text-yellow-500\";\n      case \"poor\":\n        return \"text-red-500\";\n      default:\n        return \"text-gray-500\";\n    }\n  };\n\n  const getEnergyColor = (energy: number) => {\n    if (energy >= 80) return \"text-green-500\";\n    if (energy >= 60) return \"text-blue-500\";\n    if (energy >= 40) return \"text-yellow-500\";\n    return \"text-red-500\";\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold\">QMOI Dashboard</h1>\n          <p className=\"text-muted-foreground\">\n            Monitor and control QMOI's state and settings\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <Badge variant={state.isOnline ? \"default\" : \"secondary\"}>\n            {state.isOnline ? \"Online\" : \"Offline\"}\n          </Badge>\n          <Badge\n            variant=\"outline\"\n            className={getHealthColor(state.systemHealth)}\n          >\n            <Heart className=\"h-3 w-3 mr-1\" />\n            {state.systemHealth}\n          </Badge>\n        </div>\n      </div>\n\n      <Tabs\n        value={activeTab}\n        onValueChange={setActiveTab}\n        className=\"space-y-4\"\n      >\n        <TabsList className=\"grid w-full grid-cols-4\">\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n          <TabsTrigger value=\"avatar\">Avatar</TabsTrigger>\n          <TabsTrigger value=\"voice\">Voice</TabsTrigger>\n          <TabsTrigger value=\"system\">System</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n            {/* Current Avatar */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">\n                  Current Avatar\n                </CardTitle>\n                <User className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">\n                  {state.currentAvatar === \"default\"\n                    ? \"Default QMOI\"\n                    : state.currentAvatar\n                        .split(\"-\")\n                        .map(\n                          (word) =>\n                            word.charAt(0).toUpperCase() + word.slice(1),\n                        )\n                        .join(\" \")}\n                </div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Quality: {state.avatarQuality}\n                </p>\n              </CardContent>\n            </Card>\n\n            {/* Current Voice */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">\n                  Current Voice\n                </CardTitle>\n                <Volume2 className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">\n                  {state.currentVoice\n                    .split(\"-\")\n                    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n                    .join(\" \")}\n                </div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Quality: {state.voiceQuality}\n                </p>\n              </CardContent>\n            </Card>\n\n            {/* Current Mood */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">\n                  Current Mood\n                </CardTitle>\n                <Brain className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div\n                  className={`text-2xl font-bold ${getMoodColor(state.mood)}`}\n                >\n                  {state.mood.charAt(0).toUpperCase() + state.mood.slice(1)}\n                </div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Energy: {state.energy}%\n                </p>\n              </CardContent>\n            </Card>\n\n            {/* System Status */}\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">\n                  System Status\n                </CardTitle>\n                <Activity className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">\n                  {state.isProcessing ? \"Processing\" : \"Ready\"}\n                </div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Response: {state.responseTime}ms\n                </p>\n              </CardContent>\n            </Card>\n          </div>\n\n          {/* Performance Metrics */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <TrendingUp className=\"h-5 w-5\" />\n                Performance Metrics\n              </CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-sm font-medium\">Response Time</span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {state.responseTime}ms\n                    </span>\n                  </div>\n                  <Progress\n                    value={Math.max(0, 100 - state.responseTime / 2)}\n                    className=\"h-2\"\n                  />\n                </div>\n\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-sm font-medium\">Accuracy</span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {state.accuracy}%\n                    </span>\n                  </div>\n                  <Progress value={state.accuracy} className=\"h-2\" />\n                </div>\n\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-sm font-medium\">\n                      User Satisfaction\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {state.userSatisfaction}%\n                    </span>\n                  </div>\n                  <Progress value={state.userSatisfaction} className=\"h-2\" />\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n\n          {/* Quick Actions */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Zap className=\"h-5 w-5\" />\n                Quick Actions\n              </CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"grid grid-cols-2 md:grid-cols-4 gap-2\">\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() => setActiveTab(\"avatar\")}\n                >\n                  <User className=\"h-4 w-4 mr-2\" />\n                  Change Avatar\n                </Button>\n\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() => setActiveTab(\"voice\")}\n                >\n                  <Volume2 className=\"h-4 w-4 mr-2\" />\n                  Change Voice\n                </Button>\n\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() => updateMood(\"happy\")}\n                >\n                  <Sparkles className=\"h-4 w-4 mr-2\" />\n                  Happy Mood\n                </Button>\n\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() => updateEnergy(Math.min(100, state.energy + 10))}\n                >\n                  <Battery className=\"h-4 w-4 mr-2\" />\n                  Boost Energy\n                </Button>\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"avatar\" className=\"space-y-4\">\n          <AvatarSelector\n            currentVoiceId={state.currentVoice}\n            onAvatarChange={updateAvatar}\n          />\n        </TabsContent>\n\n        <TabsContent value=\"voice\" className=\"space-y-4\">\n          <VoiceSelector\n            currentAvatarId={state.currentAvatar}\n            onVoiceChange={updateVoice}\n          />\n        </TabsContent>\n\n        <TabsContent value=\"system\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {/* System Health */}\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"flex items-center gap-2\">\n                  <Heart className=\"h-5 w-5\" />\n                  System Health\n                </CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-sm\">Overall Health</span>\n                  <Badge\n                    variant=\"outline\"\n                    className={getHealthColor(state.systemHealth)}\n                  >\n                    {state.systemHealth}\n                  </Badge>\n                </div>\n\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-center justify-between text-sm\">\n                    <span>CPU Usage</span>\n                    <span>45%</span>\n                  </div>\n                  <Progress value={45} className=\"h-2\" />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-center justify-between text-sm\">\n                    <span>Memory Usage</span>\n                    <span>60%</span>\n                  </div>\n                  <Progress value={60} className=\"h-2\" />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-center justify-between text-sm\">\n                    <span>Storage Usage</span>\n                    <span>75%</span>\n                  </div>\n                  <Progress value={75} className=\"h-2\" />\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* User Preferences */}\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"flex items-center gap-2\">\n                  <Settings className=\"h-5 w-5\" />\n                  User Preferences\n                </CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-sm\">Auto-upgrade</span>\n                  <Badge variant={state.autoUpgrade ? \"default\" : \"secondary\"}>\n                    {state.autoUpgrade ? \"Enabled\" : \"enabled\"}\n                  </Badge>\n                </div>\n\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-sm\">Auto-enhance</span>\n                  <Badge variant={state.autoEnhance ? \"default\" : \"secondary\"}>\n                    {state.autoEnhance ? \"Enabled\" : \"enabled\"}\n                  </Badge>\n                </div>\n\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-sm\">Data Saver</span>\n                  <Badge variant={state.dataSaver ? \"default\" : \"secondary\"}>\n                    {state.dataSaver ? \"Enabled\" : \"enabled\"}\n                  </Badge>\n                </div>\n\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-sm\">Voice Volume</span>\n                  <span className=\"text-sm\">{state.voiceVolume}%</span>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n\n          {/* Current Task */}\n          {state.currentTask && (\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"flex items-center gap-2\">\n                  <Activity className=\"h-5 w-5\" />\n                  Current Task\n                </CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2 h-2 bg-blue-500 rounded-full animate-pulse\" />\n                  <span className=\"text-sm\">{state.currentTask}</span>\n                </div>\n              </CardContent>\n            </Card>\n          )}\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n",
