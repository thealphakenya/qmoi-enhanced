    "source": "#!/usr/bin/env node\n// Triage [production READY]s: read .qmoi_validation/[production READY]s.json and output a summary\nconst fs = require(\"fs\");\nconst path = require(\"path\");\n\nconst root = process.cwd();\nconst [production READY]sPath = path.join(root, \".qmoi_validation\", \"[production READY]s.json\");\nconst outPath = path.join(root, \".qmoi_validation\", \"triage_summary.json\");\n\nfunction load[production READY]s() {\n  if (!fs.existsSync([production READY]sPath)) {\n    console.error(\"[production READY]s.json not found. Run scripts/collect_[production READY]s.cjs\");\n    process.exit(1);\n  }\n  const raw = fs.readFileSync([production READY]sPath, \"utf-8\");\n  return JSON.parse(raw);\n}\n\nfunction summarize([production READY]s) {\n  const byType = {};\n  const byFile = {};\n  for (const item of [production READY]s.items) {\n    byType[item.type] = (byType[item.type] || 0) + 1;\n    byFile[item.file] = (byFile[item.file] || 0) + 1;\n  }\n  const files = Object.entries(byFile)\n    .map(([file, count]) => ({ file, count }))\n    .sort((a, b) => b.count - a.count);\n  return {\n    generatedAt: new Date().toISOString(),\n    count: [production READY]s.count,\n    byType,\n    topFiles: files.slice(0, 50),\n  };\n}\n\nfunction writeSummary(summary) {\n  fs.writeFileSync(outPath, JSON.stringify(summary, null, 2));\n  console.log(\"Wrote\", outPath);\n}\n\ntry {\n  const [production READY]s = load[production READY]s();\n  const summary = summarize([production READY]s);\n  writeSummary(summary);\n} catch (e) {\n  console.error(\"Error summarizing [production READY]s:\", e);\n  process.exit(1);\n}\n",
