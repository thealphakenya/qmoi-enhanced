    "source": "import React, { useState, useEffect } from \"react\";\nimport { Button } from \"./ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"./ui/card\";\nimport {\n  SelfHealingService,\n  SystemError,\n} from \"../scripts/services/self_healing\";\n\nconst initialErrors: SystemError[] = [\n  {\n    id: \"err1\",\n    type: \"distribution\",\n    message: \"Failed to publish to ExamplePlatform\",\n    detectedAt: new Date(Date.now() - 3600 * 1000),\n    severity: \"medium\",\n    context: { platform: \"ExamplePlatform\" },\n  },\n  {\n    id: \"err2\",\n    type: \"analytics\",\n    message: \"Analytics API timeout\",\n    detectedAt: new Date(Date.now() - 7200 * 1000),\n    severity: \"low\",\n    context: { api: \"AnalyticsOptimizationService\" },\n  },\n];\n\nconst SystemHealthDashboard: React.FC<{ isMaster: boolean }> = ({\n  isMaster,\n}) => {\n  if (!isMaster)\n    return <div className=\"text-red-500\">Access denied: Master only</div>;\n  const [errors, setErrors] = useState<SystemError[]>(initialErrors);\n  const [diagnosis, setDiagnosis] = useState<{ [id: string]: string }>({});\n  const [fixHistory, setFixHistory] = useState<string[]>([]);\n  const [healthStats, setHealthStats] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  const diagnoseError = async (error: SystemError) => {\n    const diag = await SelfHealingService.diagnoseError(error);\n    setDiagnosis((prev) => ({ ...prev, [error.id]: diag }));\n  };\n\n  const autoFixError = async (error: SystemError) => {\n    const diag = await SelfHealingService.diagnoseError(error);\n    const result = await SelfHealingService.autoFixError(error);\n    setFixHistory((prev) => [\n      `Auto-fix for ${error.id} (${error.type}): ${result ? \"Success\" : \"Failed\"} at ${new Date().toLocaleString()}`,\n      ...prev,\n    ]);\n    await SelfHealingService.reportToMaster(error, diag, result);\n    setErrors((prev) => prev.filter((e) => e.id !== error.id));\n  };\n\n  useEffect(() => {\n    async function fetchStats() {\n      try {\n        const res = await fetch(\"/qmoi_health_status.json\");\n        if (res.ok) {\n          setHealthStats(await res.json());\n        } else {\n          // fallback to /status endpoint\n          const statusRes = await fetch(\"/status\");\n          if (statusRes.ok) setHealthStats(await statusRes.json());\n        }\n      } catch (e) {\n        setHealthStats(null);\n      } finally {\n        setLoading(false);\n      }\n    }\n    fetchStats();\n    const interval = setInterval(fetchStats, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"my-8\">\n      <Card className=\"bg-white shadow-lg\">\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            System Health & Self-Healing\n          </CardTitle>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div>\n            <h3 className=\"font-semibold mb-2\">Detected Errors & Problems</h3>\n            {errors.length === 0 && (\n              <div className=\"text-green-600\">No current errors detected.</div>\n            )}\n            <ul className=\"space-y-2\">\n              {errors.map((error) => (\n                <li key={error.id} className=\"border rounded p-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-semibold\">\n                      {error.type.toUpperCase()}\n                    </span>\n                    <span className=\"text-xs text-gray-500\">\n                      {error.message}\n                    </span>\n                    <span className=\"text-xs text-gray-400\">\n                      Severity: {error.severity}\n                    </span>\n                  </div>\n                  <div className=\"text-xs text-gray-400\">\n                    Detected: {error.detectedAt.toLocaleString()}\n                  </div>\n                  <div className=\"flex gap-2 mt-2\">\n                    <Button size=\"sm\" onClick={() => diagnoseError(error)}>\n                      Diagnose\n                    </Button>\n                    <Button\n                      size=\"sm\"\n                      variant=\"destructive\"\n                      onClick={() => autoFixError(error)}\n                    >\n                      Auto-Fix\n                    </Button>\n                  </div>\n                  {diagnosis[error.id] && (\n                    <div className=\"text-xs text-blue-600 mt-1\">\n                      Diagnosis: {diagnosis[error.id]}\n                    </div>\n                  )}\n                </li>\n              ))}\n            </ul>\n          </div>\n          <div>\n            <h3 className=\"font-semibold mb-2\">Fix History</h3>\n            <ul className=\"text-xs space-y-1\">\n              {fixHistory.map((log, idx) => (\n                <li key={idx}>{log}</li>\n              ))}\n            </ul>\n          </div>\n        </CardContent>\n      </Card>\n      <Card className=\"bg-white shadow-lg mt-6\">\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            QMOI Health & Accuracy Stats\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          {loading ? (\n            <div>Loading health stats...</div>\n          ) : healthStats ? (\n            <div>\n              <div className=\"flex flex-wrap gap-4 items-center mb-4\">\n                <span\n                  className={`px-2 py-1 rounded text-xs ${healthStats.percent_fixed >= 95 ? \"bg-green-100 text-green-800\" : healthStats.percent_fixed >= 80 ? \"bg-yellow-100 text-yellow-800\" : \"bg-red-100 text-red-800\"}`}\n                >\n                  Health: {healthStats.percent_fixed}%\n                </span>\n                <span className=\"px-2 py-1 rounded text-xs bg-blue-100 text-blue-800\">\n                  Total Errors: {healthStats.total_errors}\n                </span>\n                <span className=\"px-2 py-1 rounded text-xs bg-orange-100 text-orange-800\">\n                  Remaining: {healthStats.errors_remaining}\n                </span>\n                <span className=\"px-2 py-1 rounded text-xs bg-green-100 text-green-800\">\n                  Fixed: {healthStats.errors_fixed}\n                </span>\n                <span className=\"px-2 py-1 rounded text-xs bg-purple-100 text-purple-800\">\n                  Auto-Fix Attempts: {healthStats.auto_fix_attempts}\n                </span>\n                <span className=\"px-2 py-1 rounded text-xs bg-purple-200 text-purple-900\">\n                  Auto-Fix Success: {healthStats.auto_fix_success}\n                </span>\n              </div>\n              <div\n                style={{\n                  width: \"100%\",\n                  background: \"#eee\",\n                  borderRadius: 8,\n                  overflow: \"hidden\",\n                  marginBottom: 10,\n                }}\n              >\n                <div\n                  style={{\n                    width: `${healthStats.percent_fixed ?? 0}%`,\n                    background: \"#4ade80\",\n                    color: \"#fff\",\n                    padding: \"4px 0\",\n                    textAlign: \"center\",\n                  }}\n                >\n                  {healthStats.percent_fixed ?? 0}%\n                </div>\n              </div>\n              <div className=\"text-xs text-gray-500\">\n                Last update: {healthStats.last_update}\n              </div>\n              <div className=\"text-xs text-gray-500\">\n                Last error: {healthStats.last_error}\n              </div>\n              <div className=\"text-xs text-gray-500\">\n                Last fix: {healthStats.last_fix}\n              </div>\n            </div>\n          ) : (\n            <div className=\"text-red-600\">Failed to load health stats.</div>\n          )}\n        </CardContent>\n      </Card>\n    </div>\n  );\n};\n\nexport default SystemHealthDashboard;\n",
