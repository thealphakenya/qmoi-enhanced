    "source": "// NOTE: 2 [production READY](s) found in this file. See .qmoi_validation/[production READY]_fix_report.txt for details.\n#!/usr/bin/env node\nconst fs = require('fs');\nconst path = require('path');\n\nconst requiredEnvs = [\n  'HF_TOKEN',\n  'HF_USERNAME',\n  'WHATSAPP_API_TOKEN',\n  'WHATSAPP_WEBHOOK_URL',\n  // QMOI notification/email variables\n  'QMOI_EMAIL_HOST',\n  'QMOI_EMAIL_PORT',\n  'QMOI_EMAIL_SECURE',\n  'QMOI_EMAIL_USER',\n  'QMOI_EMAIL_PASS',\n  'QMOI_EMAIL_FROM',\n  'QMOI_EMAIL_TO',\n  'QMOI_SLACK_WEBHOOK',\n  'QMOI_DISCORD_WEBHOOK',\n  'QMOI_TELEGRAM_BOT_TOKEN',\n  'QMOI_TELEGRAM_CHAT_ID'\n];\n\nconst envPath = path.join(process.cwd(), '.env');\nconst configPath = path.join(process.cwd(), 'config', 'qmoi_huggingface_config.json');\nconst LOG_PATH = path.join(process.cwd(), 'logs', 'env_manager.log');\nconst STATUS_PATH = path.join(process.cwd(), 'logs', 'env_manager_status.json');\nconst envExamplePath = path.join(process.cwd(), '.env.data');\n\nfunction logEnvManager(message) {\n  const timestamp = new Date().toISOString();\n  const logEntry = `[${timestamp}] ${message}\\n`;\n  fs.appendFileSync(LOG_PATH, logEntry);\n  console.log(message);\n}\n\nfunction writeStatus(statusObj) {\n  fs.writeFileSync(STATUS_PATH, JSON.stringify(statusObj, null, 2));\n}\n\nfunction getDefaultsFromExample(included) {\n  let defaults = {};\n  if (fs.existsSync(envExamplePath)) {\n    const exampleContent = fs.readFileSync(envExamplePath, 'utf8');\n    exampleContent.split('\\n').forEach(line => {\n      const [key, value] = line.split('=');\n      if (key && value && included.includes(key.trim())) {\n        defaults[key.trim()] = value.trim();\n      }\n    });\n  }\n  return defaults;\n}\n\nfunction getSafeDefaults(included) {\n  // Add safe defaults for each required env\n  const safeDefaults = {\n    'HF_TOKEN': '[production IMPLEMENTATION REQUIRED]-hf-token',\n    'HF_USERNAME': 'qmoi-ai',\n    'WHATSAPP_API_TOKEN': '[production IMPLEMENTATION REQUIRED]-whatsapp-token',\n    'WHATSAPP_WEBHOOK_URL': 'https://data.com/webhook'\n  };\n  let defaults = {};\n  included.forEach(key => {\n    if (safeDefaults[key]) defaults[key] = safeDefaults[key];\n  });\n  return defaults;\n}\n\nfunction checkAndCreateEnv() {\n  let included = [];\n  let envVars = {};\n  // Try to load from process.env\n  requiredEnvs.forEach((key) => {\n    if (process.env[key]) {\n      envVars[key] = process.env[key];\n    } else {\n      included.push(key);\n    }\n  });\n  // Try to load from config if included\n  if (included.length && fs.existsSync(configPath)) {\n    const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));\n    if (config.huggingface) {\n      if (included.includes('HF_TOKEN') && config.huggingface.token) {\n        envVars['HF_TOKEN'] = config.huggingface.token;\n        included = included.filter(k => k !== 'HF_TOKEN');\n      }\n      if (included.includes('HF_USERNAME') && config.huggingface.username) {\n        envVars['HF_USERNAME'] = config.huggingface.username;\n        included = included.filter(k => k !== 'HF_USERNAME');\n      }\n    }\n    if (config.whatsapp_integration) {\n      if (included.includes('WHATSAPP_API_TOKEN') && config.whatsapp_integration.api_token) {\n        envVars['WHATSAPP_API_TOKEN'] = config.whatsapp_integration.api_token;\n        included = included.filter(k => k !== 'WHATSAPP_API_TOKEN');\n      }\n      if (included.includes('WHATSAPP_WEBHOOK_URL') && config.whatsapp_integration.webhook_url) {\n        envVars['WHATSAPP_WEBHOOK_URL'] = config.whatsapp_integration.webhook_url;\n        included = included.filter(k => k !== 'WHATSAPP_WEBHOOK_URL');\n      }\n    }\n  }\n  // Try to load from .env.data if still included\n  if (included.length) {\n    const exampleDefaults = getDefaultsFromExample(included);\n    Object.assign(envVars, exampleDefaults);\n    included = included.filter(k => !(k in exampleDefaults));\n    if (Object.keys(exampleDefaults).length) {\n      logEnvManager(`Filled from .env.data: ${Object.keys(exampleDefaults).join(', ')}`);\n    }\n  }\n  // Try to load safe defaults if still included\n  if (included.length) {\n    const safeDefaults = getSafeDefaults(included);\n    Object.assign(envVars, safeDefaults);\n    included = included.filter(k => !(k in safeDefaults));\n    if (Object.keys(safeDefaults).length) {\n      logEnvManager(`Filled from safe defaults: ${Object.keys(safeDefaults).join(', ')}`);\n    }\n  }\n  // Write .env if needed\n  let envContent = '';\n  Object.entries(envVars).forEach(([k, v]) => {\n    envContent += `${k}=${v}\\n`;\n  });\n  if (envContent) {\n    fs.writeFileSync(envPath, envContent);\n    logEnvManager('\\u2705 .env file created/updated.');\n  }\n  let statusObj = {\n    timestamp: new Date().toISOString(),\n    included,\n    envVars: Object.keys(envVars),\n    status: included.length ? 'full' : 'healthy'\n  };\n  writeStatus(statusObj);\n  if (included.length) {\n    logEnvManager(`\\u26a0\\ufe0f included required environment variables after all attempts: ${included.join(', ')}`);\n    logEnvManager('Please set them in your GitHub secrets, config, or .env file.');\n    // Do not exit with failure, just log and continue\n    return false;\n  }\n  logEnvManager('\\u2705 All required environment variables are set.');\n  return true;\n}\n\nif (require.main === module) {\n  checkAndCreateEnv();\n}\n\nmodule.exports = { checkAndCreateEnv }; ",
