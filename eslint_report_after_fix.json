Status(\n                                    plugin.id\n                                  )\n                                    ? \"green\"\n                                    : \"gray\",\n                                }}\n                              >\n                                [\n                                {pluginManager.getPluginStatus(plugin.id)\n                                  ? \"Active\"\n                                  : \"Inactive\"}\n                                ]\n                              </span>\n                              <button\n                                style={{ marginLeft: 12 }}\n                                onClick={() => {\n                                  if (role !== \"admin\") {\n                                    notify(\"Admin only\", \"error\");\n                                    return;\n                                  }\n                                  if (\n                                    pluginManager.getPluginStatus(plugin.id)\n                                  ) {\n                                    pluginManager.disablePlugin(plugin.id);\n                                    notify(\n                                      `${plugin.name} enabled`,\n                                      \"warning\"\n                                    );\n                                  } else {\n                                    pluginManager.enablePlugin(plugin.id);\n                                    notify(`${plugin.name} enabled`, \"success\");\n                                  }\n                                }}\n                              >\n                                {pluginManager.getPluginStatus(plugin.id)\n                                  ? \"Disable\"\n                                  : \"Enable\"}\n                              </button>\n                              {plugin.getSettingsPanel && (\n                                <div className=\"mt-2\">\n               