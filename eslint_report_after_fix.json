ne\"\n                  onClick={() => exportTasks(\"json\")}\n                >\n                  Export JSON\n                </Button>\n                <Button size=\"sm\" variant=\"destructive\" onClick={clearLogs}>\n                  Clear Logs\n                </Button>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => handleEnhancement(\"Manual admin enhancement\")}\n                >\n                  Trigger Enhancement\n                </Button>\n                <Button size=\"sm\" variant=\"outline\" onClick={downloadAllData}>\n                  Download All Data\n                </Button>\n              </div>\n              <div className=\"overflow-x-auto max-h-64\">\n                <table className=\"w-full text-xs\">\n                  <thead>\n                    <tr>\n                      <th>ID</th>\n                      <th>User</th>\n                      <th>Type</th>\n                      <th>Description/File</th>\n                      <th>Status</th>\n                      <th>Timestamp</th>\n                      <th>Duration</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {aiTasks.map((t, i) => (\n                      <tr key={i}>\n                        <td>{t.id || i}</td>\n                        <td>{t.user || \"admin\"}</td>\n                        <td>{t.type}</td>\n                        <td>{t.desc || t.file || \"-\"}</td>\n                        <td>\n                          <Badge variant={getBadgeVariant(t.status)}>\n                            {t.status}\n                          </Badge>\n                        </td>\n                        <td>{new Date(t.timestamp).toLocaleString()}</td>\n                        <td>{t.duration ? `${t.duration}s` : \"-\"}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n     