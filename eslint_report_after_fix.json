    "source": "\"use client\";\nimport React, { useEffect, useState, useCallback } from \"react\";\nimport Button from \"@mui/material/Button\";\nimport Card from \"@mui/material/Card\";\nimport CardContent from \"@mui/material/CardContent\";\nimport CardHeader from \"@mui/material/CardHeader\";\nimport Typography from \"@mui/material/Typography\";\n// import { Badge } from \"@/components/ui/badge\";\n// import { Progress } from \"@/components/ui/progress\";\nimport { FloatingPreviewWindow } from \"./FloatingPreviewWindow\";\nimport { AIRequestRouter } from \"../src/services/AIRequestRouter\";\nimport { MultiUserSessionManager } from \"../src/services/MultiUserSessionManager\";\nimport { ContextEngine } from \"../src/services/ContextEngine\";\nimport { useMaster } from \"./MasterContext\";\nimport QmoiAutoDistribution from \"./QmoiAutoDistribution\";\nimport { QmoiMediaManager } from \"./QmoiMediaManager\";\nimport {\n  FaWallet,\n  FaChild,\n  FaRobot,\n  FaKey,\n  FaMapMarkerAlt,\n  FaChalkboardTeacher,\n  FaVideo,\n  FaDownload,\n  FaHeart,\n  FaCog,\n  FaBell,\n  FaShieldAlt,\n  FaLock,\n  FaUnlock,\n  FaTools,\n  FaNetworkWired,\n  FaDatabase,\n  FaMemory,\n  FaMicrochip,\n  FaChartLine,\n  FaCoins,\n  FaChartBar,\n} from \"react-icons/fa\";\nimport { useToast } from \"@/components/ui/use-toast\";\nimport { useAIContext } from \"./AIContext\";\nimport { useMediaGenerationStatus } from \"../hooks/useMediaGenerationStatus\";\nimport { useGlobalAutomation } from \"../hooks/useGlobalAutomation\";\nimport { useprodiceHealth } from \"../hooks/useprodiceHealth\";\nimport QIStateWindow from \"./QIStateWindow\";\nimport CashonTradingPanel from \"./CashonTradingPanel\";\nimport type { BadgeVariant } from \"../types/index\";\n\n// Types\ninterface ChatMessage {\n  type: \"user\" | \"ai\" | \"system\";\n  content: string;\n  timestamp?: number;\n}\n\ninterface AITask {\n  id: string;\n  user?: string;\n  type: string;\n  desc?: string;\n  file?: string;\n  status: \"pending\" | \"completed\" | \"error\";\n  timestamp: string;\n  duration?: number;\n  project?: string;\n  files?: string[];\n}\n\ninterface Trade {\n  id: string;\n  pair: string;\n  amount: number;\n  profit: number;\n  status: string;\n}\n\ninterface TradingStats {\n  analytics: {\n    totalTrades: number;\n    successRate: number;\n    totalProfit: number;\n    totalLoss: number;\n    netProfit: number;\n    winCount?: number;\n    lossCount?: number;\n    confidence?: number;\n    pairs?: string[];\n  };\n  trades: Trade[];\n}\n\ninterface AutomationTask {\n  id: string;\n  name: string;\n  type: \"scheduled\" | \"triggered\" | \"continuous\";\n  status: \"active\" | \"paused\" | \"completed\" | \"failed\";\n  schedule?: {\n    interval: number; // in seconds\n    lastRun: string;\n    nextRun: string;\n  };\n  stats: {\n    totalRuns: number;\n    successRate: number;\n    lastError?: string;\n  };\n}\n\ninterface AutomationState {\n  isEnabled: boolean;\n  tasks: AutomationTask[];\n  settings: {\n    maxConcurrentTasks: number;\n    autoRetry: boolean;\n    retryLimit: number;\n    notificationLevel: \"all\" | \"errors\" | \"none\";\n  };\n}\n\ninterface ErrorBoundaryProps {\n  children: React.ReactNode;\n}\n\ninterface ErrorBoundaryState {\n  hasError: boolean;\n  error?: Error;\n}\n\ninterface EmotionalState {\n  bond: number; // 0-100\n  mood: \"happy\" | \"neutral\" | \"sad\";\n  lastInteraction: string;\n  preferences: string[];\n}\n\ninterface AutomationRule {\n  id: string;\n  name: string;\n  trigger: \"time\" | \"event\" | \"condition\";\n  condition?: string;\n  action: string;\n  enabled: boolean;\n  lastRun?: string;\n  nextRun?: string;\n}\n\ninterface OptimizationTask {\n  id: string;\n  type: \"performance\" | \"security\" | \"storage\" | \"network\";\n  status: \"pending\" | \"running\" | \"completed\" | \"failed\";\n  progress: number;\n  description: string;\n  result?: string;\n  error?: string;\n}\n\ninterface prodiceEnhancement {\n  id: string;\n  type: \"feature\" | \"optimization\" | \"security\" | \"automation\";\n  name: string;\n  description: string;\n  status: \"suggested\" | \"implemented\" | \"rejected\";\n  priority: \"low\" | \"medium\" | \"high\";\n  impact: string;\n}\n\ninterface SystemDiagnostic {\n  category: \"performance\" | \"security\" | \"storage\" | \"network\";\n  issues: {\n    id: string;\n    severity: \"low\" | \"medium\" | \"high\";\n    description: string;\n    fix?: string;\n  }[];\n}\n\n// Error Boundary Component\nclass QIErrorBoundary extends React.Component<\n  ErrorBoundaryProps,\n  ErrorBoundaryState\n> {\n  constructor(props: ErrorBoundaryProps) {\n    super(props);\n    this.state = { hasError: false };\n  }\n\n  static getDerivedStateFromError(error: Error): ErrorBoundaryState {\n    return { hasError: true, error };\n  }\n\n  componentDidCatch(error: Error, errorInfo: React.ErrorInfo): void {\n    (globalThis.console as any)?.error?.(\"QI Error:\", error, errorInfo);\n  }\n\n  render(): React.ReactNode {\n    if (this.state.hasError) {\n      return (\n        <div className=\"p-4 bg-red-50 rounded-lg\">\n          <h2 className=\"text-red-600 font-semibold\">Something went wrong</h2>\n          <p className=\"text-red-500\">{this.state.error?.message}</p>\n          <Button\n            variant=\"outline\"\n            onClick={() => this.setState({ hasError: false })}\n            className=\"mt-2\"\n          >\n            Try again\n          </Button>\n        </div>\n      );\n    }\n\n    return this.props.children;\n  }\n}\n\n// Constants\nconst MASTER_EMAILS = [\n  \"victor@kwemoi@gmail.com\",\n  \"thealphakenya@gmail.com\",\n  \"leah@chebet.com\",\n];\nconst REFRESH_INTERVAL = 30000; // 30 seconds\n\n// Utility functions\nfunction isMasterOrSister(): boolean {\n  try {\n    if (typeof window === \"undefined\") return false;\n    const email = localStorage.getItem(\"userEmail\") || \"\";\n    return MASTER_EMAILS.includes(email);\n  } catch (error) {\n    (globalThis.console as any)?.error?.(\"Failed to check master/sister status:\", error);\n    return false;\n  }\n}\n\n// Main component\nfunction QIComponent() {\n  const { toast } = useToast();\n  const {\n    chatHistory,\n    setChatHistory,\n    optimizeprodice,\n    scanForErrors,\n    selfHeal,\n  } = useAIContext();\n\n  const [aiTasks, setAiTasks] = useState<AITask[]>([]);\n  const [tradingStats, setTradingStats] = useState<TradingStats | null>(null);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [showAllStats, setShowAllStats] = useState<boolean>(false);\n  const [showQIChat, setShowQIChat] = useState<boolean>(false);\n  const [masterLogs, setMasterLogs] = useState<\n    { time: string; action: string }[]\n  >([]);\n  const [error, setError] = useState<string | null>(null);\n\n  // New state variables for enhanced features\n  const [showPreviewWindow, setShowPreviewWindow] = useState<boolean>(false);\n  const [previewContent, setPreviewContent] = useState<{\n    type: string;\n    url: string;\n  } | null>(null);\n  const [showprodiceSettings, setShowprodiceSettings] = useState<boolean>(false);\n  const [showWalletPanel, setShowWalletPanel] = useState<boolean>(false);\n  const [showDownloadManager, setShowDownloadManager] =\n    useState<boolean>(false);\n  const [showBluetoothprodices, setShowBluetoothprodices] =\n    useState<boolean>(false);\n  const [showNetworkSettings, setShowNetworkSettings] =\n    useState<boolean>(false);\n  const [showLifeGoals, setShowLifeGoals] = useState<boolean>(false);\n  const [showInventionProjects, setShowInventionProjects] =\n    useState<boolean>(false);\n\n  const { status: mediaStatus } = useMediaGenerationStatus();\n  const { status: automationStatusRaw } = useGlobalAutomation();\n  const automationStatus: AutomationState | null =\n    automationStatusRaw as AutomationState | null;\n  const prodiceHealthData = useprodiceHealth();\n\n  // Fetch AI tasks and trading stats\n  useEffect(() => {\n    let isMounted = true;\n    let timeoutId: NodeJS.Timeout;\n\n    async function fetchData() {\n      setLoading(true);\n      setError(null);\n      try {\n        const adminToken = localStorage.getItem(\"adminToken\") || \"\";\n\n        const [tradingRes, aiRes] = await Promise.all([\n          fetch(\"/api/qi-trading?action=stats\", {\n            headers: { \"x-admin-token\": adminToken },\n          }),\n          fetch(\"/api/qmoi-model?allStats=1\", {\n            headers: { \"x-admin-token\": adminToken },\n          }),\n        ]);\n\n        if (!tradingRes.ok) throw new Error(\"Failed to fetch trading stats\");\n        if (!aiRes.ok) throw new Error(\"Failed to fetch AI tasks\");\n\n        const [tradingData, aiData] = await Promise.all([\n          tradingRes.json(),\n          aiRes.json(),\n        ]);\n\n        if (isMounted) {\n          setTradingStats(tradingData);\n          setAiTasks(aiData.tasks || []);\n        }\n      } catch (error) {\n        (globalThis.console as any)?.error?.(\"Failed to fetch data:\", error);\n        if (isMounted) {\n          setError(\n            error instanceof Error ? error.message : \"Failed to fetch data\",\n          );\n          toast({\n            title: \"Error\",\n            description: \"Failed to fetch data\",\n            variant: \"destructive\",\n          });\n          setTradingStats(null);\n          setAiTasks([]);\n        }\n      } finally {\n        if (isMounted) {\n          setLoading(false);\n        }\n      }\n    }\n\n    fetchData();\n    timeoutId = setInterval(fetchData, REFRESH_INTERVAL);\n\n    return () => {\n      isMounted = false;\n      clearInterval(timeoutId);\n    };\n  }, [toast]);\n\n  // Handle enhancement requests\n  const handleEnhancement = async (desc: string) => {\n    try {\n      const adminToken = localStorage.getItem(\"adminToken\") || \"\";\n\n      const newMessage: ChatMessage = {\n        type: \"system\",\n        content: `Enhancement triggered: ${desc}`,\n        timestamp: Date.now(),\n      };\n      setChatHistory([...chatHistory, newMessage]);\n\n      const response = await fetch(\"/api/qmoi-model?enhance=1\", {\n        method: \"POST\",\n        headers: { \"x-admin-token\": adminToken },\n        body: JSON.stringify({ desc }),\n      });\n\n      if (!response.ok) throw new Error(\"Failed to trigger enhancement\");\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Failed to trigger enhancement:\", error);\n      toast({\n        title: \"Error\",\n        description: \"Failed to trigger enhancement\",\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  // Export tasks\n  const exportTasks = useCallback(\n    (type: \"csv\" | \"json\") => {\n      if (!aiTasks.length) {\n        toast({\n          title: \"Error\",\n          description: \"No tasks available to export\",\n          variant: \"destructive\",\n        });\n        return;\n      }\n\n      try {\n        if (type === \"csv\") {\n          const header =\n            \"ID,User,Type,Description/File,Status,Timestamp,Duration\\n\";\n          const rows = aiTasks\n            .map(\n              (t) =>\n                `${t.id},${t.user || \"admin\"},${t.type},${\n                  t.desc || t.file || \"-\"\n                },${t.status},${t.timestamp},${t.duration || \"-\"}`,\n            )\n            .join(\"\\n\");\n          const csv = header + rows;\n          const blob = new Blob([csv], { type: \"text/csv\" });\n          const url = URL.createObjectURL(blob);\n          const a = document.createElement(\"a\");\n          a.href = url;\n          a.download = `ai-tasks-${new Date().toISOString().slice(0, 10)}.csv`;\n          a.click();\n          URL.revokeObjectURL(url);\n        } else {\n          const blob = new Blob([JSON.stringify(aiTasks, null, 2)], {\n            type: \"application/json\",\n          });\n          const url = URL.createObjectURL(blob);\n          const a = document.createElement(\"a\");\n          a.href = url;\n          a.download = `ai-tasks-${new Date().toISOString().slice(0, 10)}.json`;\n          a.click();\n          URL.revokeObjectURL(url);\n        }\n      } catch (error) {\n        (globalThis.console as any)?.error?.(\"Failed to export tasks:\", error);\n        toast({\n          title: \"Error\",\n          description: \"Failed to export tasks\",\n          variant: \"destructive\",\n        });\n      }\n    },\n    [aiTasks, toast],\n  );\n\n  // Clear logs\n  const clearLogs = useCallback(() => {\n    setMasterLogs([]);\n    toast({\n      title: \"Success\",\n      description: \"Logs cleared successfully\",\n    });\n  }, [toast]);\n\n  // Download all data\n  const downloadAllData = useCallback(() => {\n    try {\n      const data = {\n        aiTasks,\n        tradingStats,\n        chatHistory,\n        masterLogs,\n        timestamp: new Date().toISOString(),\n      };\n      const blob = new Blob([JSON.stringify(data, null, 2)], {\n        type: \"application/json\",\n      });\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `qi-data-${new Date().toISOString().slice(0, 10)}.json`;\n      a.click();\n      URL.revokeObjectURL(url);\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Failed to download data:\", error);\n      toast({\n        title: \"Error\",\n        description: \"Failed to download data\",\n        variant: \"destructive\",\n      });\n    }\n  }, [aiTasks, tradingStats, chatHistory, masterLogs, toast]);\n\n  // Log master actions\n  const logMasterAction = useCallback((action: string) => {\n    setMasterLogs((prev) => [\n      ...prev,\n      { time: new Date().toLocaleString(), action },\n    ]);\n  }, []);\n\n  // Fix Badge variant types\n  const getBadgeVariant = (status: string): BadgeVariant => {\n    switch (status) {\n      case \"completed\":\n        return \"secondary\";\n      case \"pending\":\n      case \"generating\":\n        return \"outline\";\n      case \"error\":\n        return \"destructive\";\n      default:\n        return \"default\";\n    }\n  };\n\n  // Fix file types counting\n  const getFileTypes = (tasks: AITask[]): Record<string, number> => {\n    const types: Record<string, number> = {};\n    tasks\n      .filter((t) => t.type === \"file-upload\")\n      .forEach((t) => {\n        const ext = t.file?.split(\".\").pop() || \"unknown\";\n        types[ext] = (types[ext] || 0) + 1;\n      });\n    return types;\n  };\n\n  // Fix duration calculations\n  const calculateAvgDuration = (durations: (number | undefined)[]): string => {\n    const validDurations = durations.filter(\n      (d): d is number => d !== undefined,\n    );\n    if (validDurations.length === 0) return \"-\";\n    const avgDuration =\n      validDurations.reduce((a, b) => a + b, 0) / validDurations.length;\n    return `${avgDuration.toFixed(1)}s`;\n  };\n\n  // New state for enhanced features\n  const [emotionalState, setEmotionalState] = useState<EmotionalState>({\n    bond: 0,\n    mood: \"neutral\",\n    lastInteraction: new Date().toISOString(),\n    preferences: [],\n  });\n\n  const [automationRules, setAutomationRules] = useState<AutomationRule[]>([]);\n  const [showAutomationRules, setShowAutomationRules] = useState(false);\n  const [showEmotionalState, setShowEmotionalState] = useState(false);\n  const [showSecuritySettings, setShowSecuritySettings] = useState(false);\n  const [showNotificationCenter, setShowNotificationCenter] = useState(false);\n\n  // Emotional bonding effect\n  useEffect(() => {\n    const interval = setInterval(() => {\n      setEmotionalState((prev) => ({\n        ...prev,\n        bond: Math.min(100, prev.bond + 0.1),\n        lastInteraction: new Date().toISOString(),\n      }));\n    }, 60000); // Increase bond every minute\n\n    return () => clearInterval(interval);\n  }, []);\n\n  // Handle automation rule changes\n  const handleAutomationRuleChange = useCallback(\n    (rule: AutomationRule) => {\n      setAutomationRules((prev) =>\n        prev.map((r) => (r.id === rule.id ? rule : r)),\n      );\n      toast({\n        title: \"Automation Updated\",\n        description: `Rule \"${rule.name}\" has been ${\n          rule.enabled ? \"enabled\" : \"enabled\"\n        }`,\n      });\n    },\n    [toast],\n  );\n\n  // New state for autonomous optimization\n  const [optimizationTasks, setOptimizationTasks] = useState<\n    OptimizationTask[]\n  >([]);\n  const [prodiceEnhancements, setprodiceEnhancements] = useState<\n    prodiceEnhancement[]\n  >([]);\n  const [systemDiagnostics, setSystemDiagnostics] = useState<\n    SystemDiagnostic[]\n  >([]);\n  const [showOptimizationPanel, setShowOptimizationPanel] = useState(false);\n  const [showTradingPanel, setShowTradingPanel] = useState(false);\n  const [showAnalyticsPanel, setShowAnalyticsPanel] = useState(false);\n  const [showCashonTradingPanel, setShowCashonTradingPanel] = useState(false);\n  const [showMediaManagerPanel, setShowMediaManagerPanel] = useState(false);\n\n  // Add router initialization\n  const sessionManager = new MultiUserSessionManager();\n  const contextEngine = new ContextEngine();\n  const aiRequestRouter = new AIRequestRouter(sessionManager, contextEngine);\n\n  // Add state for master console\n  const [showMasterConsole, setShowMasterConsole] = useState(false);\n  const [consoleInput, setConsoleInput] = useState(\"\");\n  const [consoleOutput, setConsoleOutput] = useState<string[]>([]);\n\n  const handleConsoleSend = async () => {\n    if (!consoleInput.trim()) return;\n    setConsoleOutput([...consoleOutput, `> ${consoleInput}`]);\n    try {\n      const response = await aiRequestRouter.handleRequest({\n        userId: \"master\", // get from context or props\n        source: \"chat\",\n        message: consoleInput,\n      });\n      if (response && response.message) {\n        setConsoleOutput([...consoleOutput, response.message]);\n      }\n    } catch (error) {\n      setConsoleOutput([\n        ...consoleOutput,\n        \"Error: \" + (error instanceof Error ? error.message : \"Unknown error\"),\n      ]);\n    }\n    setConsoleInput(\"\");\n  };\n\n  const { isMaster } = useMaster();\n\n  return (\n    <QIErrorBoundary>\n      <Card>\n        <QIStateWindow userEmail={\"demo@demo.com\"} userPhone={\"0000000000\"} />\n        <CardHeader>\n          <CardTitle>\n            Q-I{\" \"}\n            {showQIChat && <span style={{ color: \"#0a0\" }}>🗣️ Talk Mode</span>}\n          </CardTitle>\n          <div className=\"flex gap-2 mt-2\">\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowAllStats((v) => !v)}\n            >\n              All AI Stats\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowQIChat(true)}\n            >\n              QI Chat (App Control)\n            </Button>\n          </div>\n          <div className=\"flex gap-2 mt-2\">\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowPreviewWindow(true)}\n            >\n              {React.createElement(FaVideo as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Preview Window\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowprodiceSettings(true)}\n            >\n              {React.createElement(FaRobot as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              prodice Settings\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowWalletPanel(true)}\n            >\n              {React.createElement(FaWallet as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Wallet\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowDownloadManager(true)}\n            >\n              {React.createElement(FaDownload as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Downloads\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowBluetoothprodices(true)}\n            >\n              {React.createElement(FaMapMarkerAlt as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Bluetooth\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowNetworkSettings(true)}\n            >\n              {React.createElement(FaKey as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Network\n            </Button>\n            {isMasterOrSister() && (\n              <>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => setShowLifeGoals(true)}\n                >\n                  {React.createElement(FaChild as React.ElementType, {\n                    className: \"mr-2\",\n                  })}{\" \"}\n                  Life Goals\n                </Button>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => setShowInventionProjects(true)}\n                >\n                  {React.createElement(\n                    FaChalkboardTeacher as React.ElementType,\n                    { className: \"mr-2\" },\n                  )}{\" \"}\n                  Inventions\n                </Button>\n              </>\n            )}\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowEmotionalState(true)}\n            >\n              {React.createElement(FaHeart as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Emotional State\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowAutomationRules(true)}\n            >\n              {React.createElement(FaCog as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Automation\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowSecuritySettings(true)}\n            >\n              {React.createElement(FaShieldAlt as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Security\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowNotificationCenter(true)}\n            >\n              {React.createElement(FaBell as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Notifications\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowOptimizationPanel(true)}\n            >\n              {React.createElement(FaTools as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Optimization\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowTradingPanel(true)}\n            >\n              {React.createElement(FaChartLine as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Trading\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowCashonTradingPanel(true)}\n            >\n              {React.createElement(FaCoins as React.ElementType, {\n                className: \"mr-2\",\n              })}{\" \"}\n              Cashon Trading\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowAnalyticsPanel(true)}\n            >\n              {React.createElement(FaChartBar as React.ElementType, {\n                className: \"mr-2\",\n              })}\n              Analytics\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowMediaManagerPanel(true)}\n            >\n              {React.createElement(FaVideo as React.ElementType, {\n                className: \"mr-2\",\n              })}\n              Media Manager\n            </Button>\n          </div>\n        </CardHeader>\n        <CardContent>\n          {error && (\n            <div className=\"p-4 mb-4 bg-red-50 rounded-lg\">\n              <p className=\"text-red-600\">{error}</p>\n              <Button\n                size=\"sm\"\n                variant=\"outline\"\n                onClick={() => setError(null)}\n                className=\"mt-2\"\n              >\n                Dismiss\n              </Button>\n            </div>\n          )}\n          {loading && (\n            <div className=\"flex justify-center items-center p-4\">\n              <Progress value={undefined} className=\"w-full\" />\n            </div>\n          )}\n\n          {/* prodice Health Overview */}\n          <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n            <h3 className=\"font-semibold mb-2\">prodice Health</h3>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">CPU Usage</span>\n                <span className=\"text-lg font-bold\">\n                  {prodiceHealthData.metrics.cpuUsage.toFixed(1)}%\n                </span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">Memory Usage</span>\n                <span className=\"text-lg font-bold\">\n                  {prodiceHealthData.metrics.memoryUsage.toFixed(1)}MB\n                </span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">Disk Usage</span>\n                <span className=\"text-lg font-bold\">\n                  {prodiceHealthData.metrics.diskUsage.toFixed(1)}%\n                </span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">Battery</span>\n                <span className=\"text-lg font-bold\">\n                  {prodiceHealthData.metrics.batteryLevel?.toFixed(1)}%\n                </span>\n              </div>\n            </div>\n            <div className=\"flex gap-2 mt-2\">\n              <Button size=\"sm\" variant=\"outline\" onClick={optimizeprodice}>\n                Optimize prodice\n              </Button>\n              <Button size=\"sm\" variant=\"outline\" onClick={scanForErrors}>\n                Scan for Errors\n              </Button>\n              <Button size=\"sm\" variant=\"outline\" onClick={selfHeal}>\n                Self Heal\n              </Button>\n            </div>\n          </div>\n\n          {/* File Upload Progress */}\n          {showDownloadManager && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Download Manager</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Active Downloads</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement pause all */\n                    }}\n                  >\n                    Pause All\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* prodice Settings Panel */}\n          {showprodiceSettings && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">prodice Settings</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Wallpaper</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement wallpaper change */\n                    }}\n                  >\n                    Change Wallpaper\n                  </Button>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Appearance</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement appearance settings */\n                    }}\n                  >\n                    Customize\n                  </Button>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Installed Apps</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement app management */\n                    }}\n                  >\n                    Manage Apps\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Wallet Panel */}\n          {showWalletPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Wallet Management</h3>\n              <div className=\"space-y-4\">\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Total Balance</span>\n                    <span className=\"text-lg font-bold\">$0.00</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">24h Change</span>\n                    <span className=\"text-lg font-bold text-green-500\">\n                      +0.00%\n                    </span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Active Trades</span>\n                    <span className=\"text-lg font-bold\">0</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">\n                      Pending Orders\n                    </span>\n                    <span className=\"text-lg font-bold\">0</span>\n                  </div>\n                </div>\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-sm\">Recent Transactions</span>\n                    <Button\n                      size=\"sm\"\n                      variant=\"outline\"\n                      onClick={() => {\n                        /* [production READY]: Add funds */\n                      }}\n                    >\n                      Add Funds\n                    </Button>\n                  </div>\n                  <div className=\"space-y-2\">\n                    {/* [production READY]: Add transaction list */}\n                    <div className=\"text-sm text-gray-500\">No transactions</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Download Manager */}\n          {showDownloadManager && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Download Manager</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Active Downloads</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement pause all */\n                    }}\n                  >\n                    Pause All\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Bluetooth prodices */}\n          {showBluetoothprodices && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Bluetooth prodices</h3>\n              <div className=\"space-y-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => {\n                    /* [production READY]: Implement bluetooth scan */\n                  }}\n                >\n                  Scan for prodices\n                </Button>\n                <div className=\"text-sm text-gray-500\">No prodices found</div>\n              </div>\n            </div>\n          )}\n\n          {/* Network Settings */}\n          {showNetworkSettings && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Network Settings</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">WiFi Networks</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Implement wifi scan */\n                    }}\n                  >\n                    Scan\n                  </Button>\n                </div>\n                <div className=\"text-sm text-gray-500\">No networks found</div>\n              </div>\n            </div>\n          )}\n\n          {/* Life Goals (Master/Sister Only) */}\n          {showLifeGoals && isMasterOrSister() && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Life Goals</h3>\n              <div className=\"space-y-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => {\n                    /* [production READY]: Implement add goal */\n                  }}\n                >\n                  Add Goal\n                </Button>\n                <div className=\"text-sm text-gray-500\">No goals set</div>\n              </div>\n            </div>\n          )}\n\n          {/* Invention Projects (Master/Sister Only) */}\n          {showInventionProjects && isMasterOrSister() && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Invention Projects</h3>\n              <div className=\"space-y-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => {\n                    /* [production READY]: Implement add project */\n                  }}\n                >\n                  New Project\n                </Button>\n                <div className=\"text-sm text-gray-500\">No projects yet</div>\n              </div>\n            </div>\n          )}\n\n          {/* Emotional State Panel */}\n          {showEmotionalState && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Emotional State</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Bond Level</span>\n                  <div className=\"flex items-center gap-2\">\n                    <Progress value={emotionalState.bond} className=\"w-full\" />\n                    <span className=\"text-lg font-bold\">\n                      {emotionalState.bond.toFixed(1)}%\n                    </span>\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Current Mood</span>\n                  <Badge\n                    variant={\n                      emotionalState.mood === \"happy\"\n                        ? \"default\"\n                        : emotionalState.mood === \"sad\"\n                          ? \"destructive\"\n                          : \"outline\"\n                    }\n                  >\n                    {emotionalState.mood}\n                  </Badge>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">\n                    Last Interaction\n                  </span>\n                  <span className=\"text-sm\">\n                    {new Date(emotionalState.lastInteraction).toLocaleString()}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Preferences</span>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {emotionalState.preferences.map((pref, i) => (\n                      <Badge key={i} variant=\"outline\">\n                        {pref}\n                      </Badge>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Automation Rules Panel */}\n          {showAutomationRules && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Automation Rules</h3>\n              <div className=\"space-y-4\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Active Rules</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Add new rule */\n                    }}\n                  >\n                    Add Rule\n                  </Button>\n                </div>\n                <div className=\"space-y-2\">\n                  {automationRules.map((rule) => (\n                    <div\n                      key={rule.id}\n                      className=\"p-2 bg-white rounded flex justify-between items-center\"\n                    >\n                      <div>\n                        <span className=\"font-medium\">{rule.name}</span>\n                        <p className=\"text-xs text-gray-500\">\n                          {rule.trigger}: {rule.condition || \"always\"}\n                        </p>\n                      </div>\n                      <div className=\"flex gap-2\">\n                        <Button\n                          size=\"sm\"\n                          variant={rule.enabled ? \"default\" : \"outline\"}\n                          onClick={() =>\n                            handleAutomationRuleChange({\n                              ...rule,\n                              enabled: !rule.enabled,\n                            })\n                          }\n                        >\n                          {rule.enabled\n                            ? React.createElement(FaUnlock as React.ElementType)\n                            : React.createElement(FaLock as React.ElementType)}\n                        </Button>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Security Settings Panel */}\n          {showSecuritySettings && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Security Settings</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Master Access</span>\n                  <Badge variant={isMaster ? \"default\" : \"destructive\"}>\n                    {isMaster ? \"Enabled\" : \"enabled\"}\n                  </Badge>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Data Encryption</span>\n                  <Badge variant=\"default\">Enabled</Badge>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Audit Logging</span>\n                  <Badge variant=\"default\">Active</Badge>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Notification Center */}\n          {showNotificationCenter && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Notification Center</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Recent Notifications</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Clear notifications */\n                    }}\n                  >\n                    Clear All\n                  </Button>\n                </div>\n                <div className=\"space-y-2\">\n                  {/* [production READY]: Add notification list */}\n                  <div className=\"text-sm text-gray-500\">\n                    No new notifications\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Optimization Panel */}\n          {showOptimizationPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">System Optimization</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">CPU Usage</span>\n                  <div className=\"flex items-center gap-2\">\n                    {React.createElement(FaMicrochip as React.ElementType, {\n                      className: \"text-blue-500\",\n                    })}\n                    <span className=\"text-lg font-bold\">\n                      {prodiceHealthData.metrics.cpuUsage.toFixed(1)}%\n                    </span>\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Memory Usage</span>\n                  <div className=\"flex items-center gap-2\">\n                    {React.createElement(FaMemory as React.ElementType, {\n                      className: \"text-green-500\",\n                    })}\n                    <span className=\"text-lg font-bold\">\n                      {prodiceHealthData.metrics.memoryUsage.toFixed(1)}MB\n                    </span>\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Storage</span>\n                  <div className=\"flex items-center gap-2\">\n                    {React.createElement(FaDatabase as React.ElementType, {\n                      className: \"text-purple-500\",\n                    })}\n                    <span className=\"text-lg font-bold\">\n                      {prodiceHealthData.metrics.diskUsage.toFixed(1)}%\n                    </span>\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Network</span>\n                  <div className=\"flex items-center gap-2\">\n                    {React.createElement(FaNetworkWired as React.ElementType, {\n                      className: \"text-orange-500\",\n                    })}\n                    <span className=\"text-lg font-bold\">Active</span>\n                  </div>\n                </div>\n              </div>\n              <div className=\"space-y-4\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Active Optimization Tasks</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      /* [production READY]: Start new optimization */\n                    }}\n                  >\n                    Start Optimization\n                  </Button>\n                </div>\n                <div className=\"space-y-2\">\n                  {optimizationTasks.map((task) => (\n                    <div key={task.id} className=\"p-2 bg-white rounded\">\n                      <div className=\"flex justify-between items-center mb-1\">\n                        <span className=\"font-medium\">{task.description}</span>\n                        <Badge\n                          variant={\n                            task.status === \"completed\"\n                              ? \"default\"\n                              : task.status === \"failed\"\n                                ? \"destructive\"\n                                : \"outline\"\n                          }\n                        >\n                          {task.status}\n                        </Badge>\n                      </div>\n                      <Progress value={task.progress} className=\"w-full\" />\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Trading Panel */}\n          {showTradingPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Autonomous Trading</h3>\n              <div className=\"text-gray-500\">Feature available.</div>\n            </div>\n          )}\n\n          {/* Analytics Panel */}\n          {showAnalyticsPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Advanced Analytics</h3>\n              <div className=\"space-y-4\">\n                <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Daily Profit</span>\n                    <span className=\"text-lg font-bold\">\n                      $\n                      {tradingStats?.analytics.totalProfit?.toFixed(2) ||\n                        \"0.00\"}\n                    </span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Win Rate</span>\n                    <span className=\"text-lg font-bold\">\n                      {tradingStats?.analytics.successRate?.toFixed(1)}%\n                    </span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Sharpe Ratio</span>\n                    <span className=\"text-lg font-bold\">\n                      {tradingStats?.analytics.confidence?.toFixed(2) || \"0.00\"}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"space-y-4\">\n                  <div className=\"p-2 bg-white rounded\">\n                    <h4 className=\"font-medium mb-2\">System Performance</h4>\n                    <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                      <div className=\"flex flex-col\">\n                        <span className=\"text-xs text-gray-500\">CPU Usage</span>\n                        <span className=\"text-sm font-medium\">\n                          {prodiceHealthData.metrics.cpuUsage.toFixed(1)}%\n                        </span>\n                      </div>\n                      <div className=\"flex flex-col\">\n                        <span className=\"text-xs text-gray-500\">\n                          Memory Usage\n                        </span>\n                        <span className=\"text-sm font-medium\">\n                          {prodiceHealthData.metrics.memoryUsage.toFixed(1)}MB\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"p-2 bg-white rounded\">\n                    <h4 className=\"font-medium mb-2\">prodice Usage Analytics</h4>\n                    <div className=\"text-gray-500\">\n                      Detailed analytics available.\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Cashon Trading Panel */}\n          {showCashonTradingPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <CashonTradingPanel />\n            </div>\n          )}\n\n          {/* Media Manager Panel */}\n          {showMediaManagerPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <div className=\"flex justify-between items-center mb-4\">\n                <h3 className=\"font-semibold\">QMOI Media Manager</h3>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => setShowMediaManagerPanel(false)}\n                >\n                  Close\n                </Button>\n              </div>\n              <QmoiMediaManager />\n            </div>\n          )}\n\n          {showAllStats && (\n            <div className=\"mb-4 p-2 bg-gray-100 rounded\">\n              <h3 className=\"font-semibold mb-2\">\n                All AI Stats (All Sessions/Users/Projects)\n              </h3>\n              <div className=\"flex flex-wrap gap-4 mb-2\">\n                <div>\n                  <b>Total AI Tasks:</b> {aiTasks.length}\n                </div>\n                <div>\n                  <b>Enhancements:</b>{\" \"}\n                  {aiTasks.filter((t) => t.type === \"enhancement\").length}\n                </div>\n                <div>\n                  <b>File Uploads:</b>{\" \"}\n                  {aiTasks.filter((t) => t.type === \"file-upload\").length}\n                </div>\n                <div>\n                  <b>Last Task:</b>{\" \"}\n                  {aiTasks.length > 0\n                    ? new Date(\n                        aiTasks[aiTasks.length - 1].timestamp,\n                      ).toLocaleString()\n                    : \"N/A\"}\n                </div>\n                <div>\n                  <b>Unique Users:</b>{\" \"}\n                  {new Set(aiTasks.map((t) => t.user || \"admin\")).size}\n                </div>\n                <div>\n                  <b>Enhancement Success Rate:</b>{\" \"}\n                  {(() => {\n                    const e = aiTasks.filter((t) => t.type === \"enhancement\");\n                    return e.length\n                      ? (\n                          (e.filter((t) => t.status === \"completed\").length /\n                            e.length) *\n                          100\n                        ).toFixed(1) + \"%\"\n                      : \"N/A\";\n                  })()}\n                </div>\n                <div>\n                  <b>File Types:</b>{\" \"}\n                  {(() => {\n                    const types = getFileTypes(aiTasks);\n                    return (\n                      Object.entries(types)\n                        .map(([k, v]) => `${k}: ${v}`)\n                        .join(\", \") || \"N/A\"\n                    );\n                  })()}\n                </div>\n                <div>\n                  <b>Avg Task Duration:</b>{\" \"}\n                  {calculateAvgDuration(aiTasks.map((t) => t.duration))}\n                </div>\n              </div>\n              <div className=\"flex gap-2 mb-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => exportTasks(\"csv\")}\n                >\n                  Export CSV\n                </Button>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => exportTasks(\"json\")}\n                >\n                  Export JSON\n                </Button>\n                <Button size=\"sm\" variant=\"destructive\" onClick={clearLogs}>\n                  Clear Logs\n                </Button>\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => handleEnhancement(\"Manual admin enhancement\")}\n                >\n                  Trigger Enhancement\n                </Button>\n                <Button size=\"sm\" variant=\"outline\" onClick={downloadAllData}>\n                  Download All Data\n                </Button>\n              </div>\n              <div className=\"overflow-x-auto max-h-64\">\n                <table className=\"w-full text-xs\">\n                  <thead>\n                    <tr>\n                      <th>ID</th>\n                      <th>User</th>\n                      <th>Type</th>\n                      <th>Description/File</th>\n                      <th>Status</th>\n                      <th>Timestamp</th>\n                      <th>Duration</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {aiTasks.map((t, i) => (\n                      <tr key={i}>\n                        <td>{t.id || i}</td>\n                        <td>{t.user || \"admin\"}</td>\n                        <td>{t.type}</td>\n                        <td>{t.desc || t.file || \"-\"}</td>\n                        <td>\n                          <Badge variant={getBadgeVariant(t.status)}>\n                            {t.status}\n                          </Badge>\n                        </td>\n                        <td>{new Date(t.timestamp).toLocaleString()}</td>\n                        <td>{t.duration ? `${t.duration}s` : \"-\"}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n          <div className=\"flex flex-col gap-4\">\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">AI Tasks Overview</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Total Tasks</span>\n                  <span className=\"text-lg font-bold\">{aiTasks.length}</span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Pending Tasks</span>\n                  <span className=\"text-lg font-bold\">\n                    {aiTasks.filter((t) => t.status === \"pending\").length}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Completed Tasks</span>\n                  <span className=\"text-lg font-bold\">\n                    {aiTasks.filter((t) => t.status === \"completed\").length}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Failed Tasks</span>\n                  <span className=\"text-lg font-bold\">\n                    {aiTasks.filter((t) => t.status === \"error\").length}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Avg Duration</span>\n                  <span className=\"text-lg font-bold\">\n                    {calculateAvgDuration(aiTasks.map((t) => t.duration))}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Last Task</span>\n                  <span className=\"text-lg font-bold\">\n                    {aiTasks.length > 0\n                      ? new Date(\n                          aiTasks[aiTasks.length - 1].timestamp,\n                        ).toLocaleString()\n                      : \"N/A\"}\n                  </span>\n                </div>\n              </div>\n            </div>\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">Trading Stats Overview</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Total Trades</span>\n                  <span className=\"text-lg font-bold\">\n                    {tradingStats?.analytics.totalTrades || 0}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Winning Trades</span>\n                  <span className=\"text-lg font-bold\">\n                    {tradingStats?.analytics.winCount || 0}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Losing Trades</span>\n                  <span className=\"text-lg font-bold\">\n                    {tradingStats?.analytics.lossCount || 0}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Total Profit</span>\n                  <span className=\"text-lg font-bold text-green-600\">\n                    {tradingStats?.analytics.totalProfit !== undefined\n                      ? `${tradingStats.analytics.totalProfit.toFixed(2)} USDT`\n                      : \"N/A\"}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Total Loss</span>\n                  <span className=\"text-lg font-bold text-red-600\">\n                    {tradingStats?.analytics.totalLoss !== undefined\n                      ? `${Math.abs(tradingStats.analytics.totalLoss).toFixed(\n                          2,\n                        )} USDT`\n                      : \"N/A\"}\n                  </span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Net Profit</span>\n                  <span className=\"text-lg font-bold\">\n                    {tradingStats?.analytics.netProfit !== undefined\n                      ? `${tradingStats.analytics.netProfit.toFixed(2)} USDT`\n                      : \"N/A\"}\n                  </span>\n                </div>\n              </div>\n            </div>\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">Media Generation Status</h3>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">\n                  Last Generated Media\n                </span>\n                <span className=\"text-lg font-bold\">\n                  {mediaStatus?.lastGenerated\n                    ? new Date(mediaStatus.lastGenerated).toLocaleString()\n                    : \"N/A\"}\n                </span>\n              </div>\n              <div className=\"flex flex-col mt-2\">\n                <span className=\"text-xs text-gray-500\">\n                  Next Scheduled Media\n                </span>\n                <span className=\"text-lg font-bold\">\n                  {mediaStatus?.nextScheduled\n                    ? new Date(mediaStatus.nextScheduled).toLocaleString()\n                    : \"N/A\"}\n                </span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">Status</span>\n                <Badge variant={getBadgeVariant(mediaStatus?.status || \"idle\")}>\n                  {mediaStatus?.status === \"generating\"\n                    ? \"Media is being generated\"\n                    : mediaStatus?.status === \"completed\"\n                      ? \"Media generation completed\"\n                      : \"N/A\"}\n                </Badge>\n              </div>\n            </div>\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">Global Automation Status</h3>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xs text-gray-500\">Status</span>\n                <Badge\n                  variant={getBadgeVariant(\n                    automationStatus?.isEnabled ? \"active\" : \"paused\",\n                  )}\n                >\n                  {automationStatus?.isEnabled ? \"Enabled\" : \"enabled\"}\n                </Badge>\n              </div>\n              <div className=\"flex flex-col mt-2\">\n                <span className=\"text-xs text-gray-500\">Last Run</span>\n                <span className=\"text-lg font-bold\">\n                  {automationStatus?.tasks && automationStatus.tasks.length > 0\n                    ? new Date(\n                        automationStatus.tasks[\n                          automationStatus.tasks.length - 1\n                        ].schedule?.lastRun || \"\",\n                      ).toLocaleString()\n                    : \"N/A\"}\n                </span>\n              </div>\n              <div className=\"flex flex-col mt-2\">\n                <span className=\"text-xs text-gray-500\">Next Run</span>\n                <span className=\"text-lg font-bold\">\n                  {automationStatus?.tasks && automationStatus.tasks.length > 0\n                    ? new Date(\n                        automationStatus.tasks[\n                          automationStatus.tasks.length - 1\n                        ].schedule?.nextRun || \"\",\n                      ).toLocaleString()\n                    : \"N/A\"}\n                </span>\n              </div>\n            </div>\n          </div>\n          {showQIChat && (\n            <div className=\"mt-4 p-4 bg-gray-50 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">QI Chat (App Control)</h3>\n              <div className=\"flex flex-col gap-2\">\n                <div className=\"flex gap-2\">\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => setChatHistory([])}\n                  >\n                    Clear Chat\n                  </Button>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Talk Mode</span>\n                  <div className=\"flex gap-2\">\n                    <Button\n                      size=\"sm\"\n                      variant={showQIChat ? \"destructive\" : \"outline\"}\n                      onClick={() => setShowQIChat((t) => !t)}\n                    >\n                      {showQIChat ? \"Disable Talk Mode\" : \"Enable Talk Mode\"}\n                    </Button>\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">\n                    Pending Enhancements\n                  </span>\n                  <div className=\"flex flex-col gap-1\">\n                    {aiTasks\n                      .filter((t) => t.type === \"enhancement\")\n                      .map((e, i) => (\n                        <div key={i} className=\"p-2 bg-gray-100 rounded\">\n                          {e.desc || e.file || \"-\"}\n                        </div>\n                      ))}\n                  </div>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Chat History</span>\n                  <div className=\"flex flex-col gap-1\">\n                    {chatHistory.length === 0 && (\n                      <span className=\"text-gray-400 text-sm\">\n                        No chat history\n                      </span>\n                    )}\n                    {chatHistory.map((msg, i) => (\n                      <div\n                        key={i}\n                        className={`p-2 rounded ${\n                          msg.type === \"user\" ? \"bg-blue-100\" : \"bg-green-100\"\n                        }`}\n                      >\n                        {msg.type === \"user\" ? \"You: \" : \"AI: \"}\n                        {msg.content}\n                      </div>\n                    ))}\n                  </div>\n                </div>\n                <div className=\"flex gap-2\">\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => setShowQIChat(false)}\n                  >\n                    Close QI Chat\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Preview Window */}\n          {showPreviewWindow && (\n            <FloatingPreviewWindow\n              onClose={() => setShowPreviewWindow(false)}\n              content={previewContent}\n              onContentChange={setPreviewContent}\n            />\n          )}\n          {isMaster && (\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              onClick={() => setShowMasterConsole((v) => !v)}\n            >\n              {showMasterConsole\n                ? \"Close Master Console\"\n                : \"Open Master Console\"}\n            </Button>\n          )}\n          {showMasterConsole && (\n            <div className=\"mt-4 p-4 bg-gray-900 text-green-200 rounded-lg shadow\">\n              <h3 className=\"font-semibold mb-2\">Master Console</h3>\n              <div className=\"flex flex-col gap-2\">\n                <textarea\n                  value={consoleInput}\n                  onChange={(e) => setConsoleInput(e.target.value)}\n                  className=\"bg-gray-800 text-green-200 p-2 rounded\"\n                  rows={2}\n                  [production READY]=\"Enter command, file edit, or version query...\"\n                />\n                <Button size=\"sm\" variant=\"outline\" onClick={handleConsoleSend}>\n                  Send\n                </Button>\n                <div className=\"mt-2 max-h-40 overflow-y-auto bg-gray-800 p-2 rounded\">\n                  {consoleOutput.map((line, i) => (\n                    <div key={i} className=\"text-xs font-mono\">\n                      {line}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n          {isMaster && (\n            <div className=\"my-8\">\n              <QmoiAutoDistribution />\n            </div>\n          )}\n        </CardContent>\n      </Card>\n    </QIErrorBoundary>\n  );\n}\n\nexport default QIComponent;\n",
