    "source": "#!/usr/bin/env node\nconst fs = require(\"fs\");\nconst path = require(\"path\");\n\nconst root = path.resolve(__dirname, \"..\");\nconst targets = [\"src\", \"app\", \"tests\", \"scripts\", \"tools\"];\nconst paramNames = [\n  \"req\",\n  \"res\",\n  \"request\",\n  \"response\",\n  \"params\",\n  \"query\",\n  \"options\",\n  \"error\",\n  \"err\",\n  \"e\",\n  \"ev\",\n  \"event\",\n];\n\nfunction walk(dir) {\n  const files = [];\n  if (!fs.existsSync(dir)) return files;\n  for (const name of fs.readdirSync(dir)) {\n    const p = path.join(dir, name);\n    try {\n      const st = fs.statSync(p);\n      if (st.isDirectory()) files.push(...walk(p));\n      else if (/\\.tsx?$|\\.ts$|\\.js$/.test(p)) files.push(p);\n    } catch (err) {\n      // ignore\n    }\n  }\n  return files;\n}\n\nfunction backup(file) {\n  const bak = file + \".bak\";\n  if (!fs.existsSync(bak)) fs.copyFileSync(file, bak);\n}\n\nfunction fixFile(file) {\n  let src = fs.readFileSync(file, \"utf8\");\n  const original = src;\n  for (const name of paramNames) {\n    const declRe = new RegExp(\"([,(\\\\s])\" + name + \"(\\\\s*[:=,)\\\\?])\", \"g\");\n    src = src.replace(declRe, (m, p1, p2) => `${p1}_${name}${p2}`);\n    const idRe = new RegExp(\"\\\\b\" + name + \"\\\\b(?!\\\\s*:)\", \"g\");\n    src = src.replace(idRe, `_${name}`);\n  }\n  src = src.replace(/:\\s*any(\\b)/g, \": unknown$1\");\n  if (src !== original) {\n    backup(file);\n    fs.writeFileSync(file, src, \"utf8\");\n    console.log(\"patched\", path.relative(root, file));\n  }\n}\n\nfor (const t of targets) {\n  const dir = path.join(root, t);\n  const files = walk(dir);\n  for (const f of files) {\n    try {\n      fixFile(f);\n    } catch (err) {\n      console.error(\"err\", f, err && err.message);\n    }\n  }\n}\n\nconsole.log(\"done\");\n",
