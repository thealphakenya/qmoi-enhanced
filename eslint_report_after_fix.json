    "source": "import React, { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport {\n  Download,\n  Filter,\n  Search,\n  Calendar,\n  Activity,\n  Shield,\n  Unlock,\n  Eye,\n  BarChart3,\n  History,\n  Settings,\n  RefreshCw,\n} from \"lucide-react\";\n\ninterface prodiceOwnershipLog {\n  id: number;\n  timestamp: string;\n  action: string;\n  prodice_id: string;\n  prodice_info: unknown;\n  restriction_type?: string;\n  organization?: string;\n  severity?: string;\n  success: boolean;\n  duration_ms: number;\n  error_message?: string;\n  master_user: string;\n  session_id: string;\n  ip_address: string;\n  user_agent: string;\n  additional_data: unknown;\n}\n\ninterface UnlockLog {\n  id: number;\n  timestamp: string;\n  prodice_id: string;\n  unlock_method: string;\n  attempt_number: number;\n  success: boolean;\n  duration_ms: number;\n  error_details?: string;\n  bypass_techniques: string[];\n  verification_results: unknown;\n}\n\ninterface MasterLog {\n  id: number;\n  timestamp: string;\n  master_user: string;\n  action: string;\n  target_prodice?: string;\n  success: boolean;\n  details: unknown;\n  session_id: string;\n}\n\ninterface prodiceHistory {\n  prodice_id: string;\n  first_detected: string;\n  last_activity: string;\n  total_attempts: number;\n  successful_unlocks: number;\n  organizations_detected: string[];\n  status: string;\n}\n\ninterface Statistics {\n  total_detections: number;\n  total_unlock_attempts: number;\n  successful_unlocks: number;\n  failed_unlocks: number;\n  master_actions: number;\n  unique_prodices: number;\n  organizations_detected: string[];\n  success_rate: number;\n}\n\ninterface QMOIOwnprodiceLogsProps {\n  isMaster: boolean;\n  onExport?: (data: unknown, type: string) => void;\n}\n\nexport function QMOIOwnprodiceLogs({\n  isMaster,\n  onExport,\n}: QMOIOwnprodiceLogsProps) {\n  const [activeTab, setActiveTab] = useState(\"overview\");\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Data states\n  const [ownershipLogs, setOwnershipLogs] = useState<prodiceOwnershipLog[]>([]);\n  const [unlockLogs, setUnlockLogs] = useState<UnlockLog[]>([]);\n  const [masterLogs, setMasterLogs] = useState<MasterLog[]>([]);\n  const [prodiceHistory, setprodiceHistory] = useState<prodiceHistory[]>([]);\n  const [statistics, setStatistics] = useState<Statistics | null>(null);\n\n  // Filter states\n  const [logType, setLogType] = useState(\"all\");\n  const [prodiceFilter, setprodiceFilter] = useState(\"\");\n  const [dateFrom, setDateFrom] = useState(\"\");\n  const [dateTo, setDateTo] = useState(\"\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [limit, setLimit] = useState(100);\n\n  // UI states\n  const [showFilters, setShowFilters] = useState(false);\n  const [autoRefresh, setAutoRefresh] = useState(true);\n  const [refreshInterval, setRefreshInterval] = useState(30);\n\n  useEffect(() => {\n    if (isMaster) {\n      loadLogs();\n      if (autoRefresh) {\n        const interval = setInterval(loadLogs, refreshInterval * 1000);\n        return () => clearInterval(interval);\n      }\n    }\n  }, [\n    isMaster,\n    logType,\n    prodiceFilter,\n    dateFrom,\n    dateTo,\n    limit,\n    autoRefresh,\n    refreshInterval,\n  ]);\n\n  const loadLogs = async () => {\n    if (!isMaster) return;\n\n    setLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\"/api/qmoi/own-prodice-logs\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({\n          log_type: logType,\n          prodice_id: prodiceFilter || undefined,\n          date_from: dateFrom || undefined,\n          date_to: dateTo || undefined,\n          limit,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to load logs\");\n      }\n\n      const data = await response.json();\n\n      if (data.ownership_logs) setOwnershipLogs(data.ownership_logs);\n      if (data.unlock_logs) setUnlockLogs(data.unlock_logs);\n      if (data.master_logs) setMasterLogs(data.master_logs);\n      if (data.prodice_history) setprodiceHistory(data.prodice_history);\n      if (data.statistics) setStatistics(data.statistics);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load logs\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleExport = async (type: string) => {\n    if (!isMaster) return;\n\n    try {\n      const response = await fetch(\"/api/qmoi/own-prodice-logs/export\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({\n          type,\n          prodice_id: prodiceFilter || undefined,\n          date_from: dateFrom || undefined,\n          date_to: dateTo || undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to export logs\");\n      }\n\n      const blob = await response.blob();\n      const url = window.URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `qmoi-own-prodice-logs-${type}-${\n        new Date().toISOString().split(\"T\")[0]\n      }.json`;\n      document.body.appendChild(a);\n      a.click();\n      window.URL.revokeObjectURL(url);\n      document.body.removeChild(a);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to export logs\");\n    }\n  };\n\n  const formatTimestamp = (timestamp: string) => {\n    return new Date(timestamp).toLocaleString();\n  };\n\n  const getSeverityColor = (severity?: string) => {\n    switch (severity?.toLowerCase()) {\n      case \"critical\":\n        return \"destructive\";\n      case \"high\":\n        return \"destructive\";\n      case \"medium\":\n        return \"default\";\n      case \"low\":\n        return \"secondary\";\n      default:\n        return \"secondary\";\n    }\n  };\n\n  const getSuccessColor = (success: boolean) => {\n    return success ? \"bg-green-500\" : \"bg-red-500\";\n  };\n\n  if (!isMaster) {\n    return (\n      <Card>\n        <CardContent className=\"p-6\">\n          <Alert>\n            <Shield className=\"h-4 w-4\" />\n            <AlertDescription>\n              Master access required to view QMOI Own prodice logs and history.\n            </AlertDescription>\n          </Alert>\n        </CardContent>\n      </Card>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <Card>\n        <CardHeader>\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Unlock className=\"h-5 w-5\" />\n                QMOI Own prodice Logs & History\n              </CardTitle>\n              <p className=\"text-sm text-muted-foreground\">\n                Master-only access to prodice ownership detection and unlock logs\n              </p>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={() => setShowFilters(!showFilters)}\n              >\n                <Filter className=\"h-4 w-4 mr-2\" />\n                Filters\n              </Button>\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={loadLogs}\n                enabled={loading}\n              >\n                <RefreshCw\n                  className={`h-4 w-4 mr-2 ${loading ? \"animate-spin\" : \"\"}`}\n                />\n                Refresh\n              </Button>\n            </div>\n          </div>\n        </CardHeader>\n      </Card>\n\n      {/* Filters */}\n      {showFilters && (\n        <Card>\n          <CardContent className=\"p-4\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              <div>\n                <label className=\"text-sm font-medium\">Log Type</label>\n                <Select value={logType} onValueChange={setLogType}>\n                  <SelectTrigger>\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">All Logs</SelectItem>\n                    <SelectItem value=\"ownership\">\n                      Ownership Detection\n                    </SelectItem>\n                    <SelectItem value=\"unlock\">Unlock Attempts</SelectItem>\n                    <SelectItem value=\"master\">Master Actions</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n\n              <div>\n                <label className=\"text-sm font-medium\">prodice ID</label>\n                <Input\n                  [production READY]=\"Filter by prodice ID\"\n                  value={prodiceFilter}\n                  onChange={(e) => setprodiceFilter(e.target.value)}\n                />\n              </div>\n\n              <div>\n                <label className=\"text-sm font-medium\">Date From</label>\n                <Input\n                  type=\"date\"\n                  value={dateFrom}\n                  onChange={(e) => setDateFrom(e.target.value)}\n                />\n              </div>\n\n              <div>\n                <label className=\"text-sm font-medium\">Date To</label>\n                <Input\n                  type=\"date\"\n                  value={dateTo}\n                  onChange={(e) => setDateTo(e.target.value)}\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 mt-4\">\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"checkbox\"\n                  id=\"autoRefresh\"\n                  checked={autoRefresh}\n                  onChange={(e) => setAutoRefresh(e.target.checked)}\n                />\n                <label htmlFor=\"autoRefresh\" className=\"text-sm\">\n                  Auto-refresh\n                </label>\n              </div>\n\n              {autoRefresh && (\n                <Select\n                  value={refreshInterval.toString()}\n                  onValueChange={(v: string) => setRefreshInterval(parseInt(v))}\n                >\n                  <SelectTrigger className=\"w-32\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"10\">10 seconds</SelectItem>\n                    <SelectItem value=\"30\">30 seconds</SelectItem>\n                    <SelectItem value=\"60\">1 minute</SelectItem>\n                    <SelectItem value=\"300\">5 minutes</SelectItem>\n                  </SelectContent>\n                </Select>\n              )}\n            </div>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Statistics Overview */}\n      {statistics && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n          <Card>\n            <CardContent className=\"p-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm font-medium\">Total Detections</p>\n                  <p className=\"text-2xl font-bold\">\n                    {statistics.total_detections}\n                  </p>\n                </div>\n                <Activity className=\"h-8 w-8 text-blue-500\" />\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm font-medium\">Unlock Attempts</p>\n                  <p className=\"text-2xl font-bold\">\n                    {statistics.total_unlock_attempts}\n                  </p>\n                </div>\n                <Unlock className=\"h-8 w-8 text-green-500\" />\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm font-medium\">Success Rate</p>\n                  <p className=\"text-2xl font-bold\">\n                    {statistics.success_rate.toFixed(1)}%\n                  </p>\n                </div>\n                <BarChart3 className=\"h-8 w-8 text-purple-500\" />\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardContent className=\"p-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm font-medium\">Unique prodices</p>\n                  <p className=\"text-2xl font-bold\">\n                    {statistics.unique_prodices}\n                  </p>\n                </div>\n                <Eye className=\"h-8 w-8 text-orange-500\" />\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      )}\n\n      {/* Main Content */}\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList className=\"grid w-full grid-cols-4\">\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n          <TabsTrigger value=\"ownership\">Ownership Logs</TabsTrigger>\n          <TabsTrigger value=\"unlock\">Unlock Logs</TabsTrigger>\n          <TabsTrigger value=\"master\">Master Logs</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Recent Activity</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {ownershipLogs.slice(0, 5).map((log) => (\n                  <div\n                    key={log.id}\n                    className=\"flex items-center justify-between p-3 border rounded-lg\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <Badge variant={getSeverityColor(log.severity)}>\n                        {log.restriction_type || \"Detection\"}\n                      </Badge>\n                      <div>\n                        <p className=\"font-medium\">{log.prodice_id}</p>\n                        <p className=\"text-sm text-muted-foreground\">\n                          {log.organization} • {formatTimestamp(log.timestamp)}\n                        </p>\n                      </div>\n                    </div>\n                    <Badge variant={log.success ? \"default\" : \"destructive\"}>\n                      {log.success ? \"Success\" : \"Failed\"}\n                    </Badge>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader>\n              <CardTitle>prodice History</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <Table>\n                <TableHeader>\n                  <TableRow>\n                    <TableHead>prodice ID</TableHead>\n                    <TableHead>First Detected</TableHead>\n                    <TableHead>Last Activity</TableHead>\n                    <TableHead>Attempts</TableHead>\n                    <TableHead>Success Rate</TableHead>\n                    <TableHead>Status</TableHead>\n                  </TableRow>\n                </TableHeader>\n                <TableBody>\n                  {prodiceHistory.slice(0, 10).map((prodice) => (\n                    <TableRow key={prodice.prodice_id}>\n                      <TableCell className=\"font-medium\">\n                        {prodice.prodice_id}\n                      </TableCell>\n                      <TableCell>\n                        {formatTimestamp(prodice.first_detected)}\n                      </TableCell>\n                      <TableCell>\n                        {formatTimestamp(prodice.last_activity)}\n                      </TableCell>\n                      <TableCell>{prodice.total_attempts}</TableCell>\n                      <TableCell>\n                        <div className=\"flex items-center gap-2\">\n                          <Progress\n                            value={\n                              (prodice.successful_unlocks /\n                                prodice.total_attempts) *\n                              100\n                            }\n                            className=\"w-20\"\n                          />\n                          <span className=\"text-sm\">\n                            {prodice.successful_unlocks}/{prodice.total_attempts}\n                          </span>\n                        </div>\n                      </TableCell>\n                      <TableCell>\n                        <Badge\n                          variant={\n                            prodice.status === \"active\" ? \"default\" : \"secondary\"\n                          }\n                        >\n                          {prodice.status}\n                        </Badge>\n                      </TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"ownership\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <div className=\"flex items-center justify-between\">\n                <CardTitle>Ownership Detection Logs</CardTitle>\n                <Button onClick={() => handleExport(\"ownership\")} size=\"sm\">\n                  <Download className=\"h-4 w-4 mr-2\" />\n                  Export\n                </Button>\n              </div>\n            </CardHeader>\n            <CardContent>\n              <Table>\n                <TableHeader>\n                  <TableRow>\n                    <TableHead>Timestamp</TableHead>\n                    <TableHead>prodice ID</TableHead>\n                    <TableHead>Organization</TableHead>\n                    <TableHead>Restriction Type</TableHead>\n                    <TableHead>Severity</TableHead>\n                    <TableHead>Success</TableHead>\n                    <TableHead>Master User</TableHead>\n                  </TableRow>\n                </TableHeader>\n                <TableBody>\n                  {ownershipLogs.map((log) => (\n                    <TableRow key={log.id}>\n                      <TableCell>{formatTimestamp(log.timestamp)}</TableCell>\n                      <TableCell className=\"font-medium\">\n                        {log.prodice_id}\n                      </TableCell>\n                      <TableCell>{log.organization || \"Unknown\"}</TableCell>\n                      <TableCell>\n                        <Badge variant=\"outline\">\n                          {log.restriction_type || \"Unknown\"}\n                        </Badge>\n                      </TableCell>\n                      <TableCell>\n                        <Badge variant={getSeverityColor(log.severity)}>\n                          {log.severity || \"Unknown\"}\n                        </Badge>\n                      </TableCell>\n                      <TableCell>\n                        <Badge\n                          variant={log.success ? \"default\" : \"destructive\"}\n                        >\n                          {log.success ? \"Success\" : \"Failed\"}\n                        </Badge>\n                      </TableCell>\n                      <TableCell>{log.master_user}</TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"unlock\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <div className=\"flex items-center justify-between\">\n                <CardTitle>Unlock Attempt Logs</CardTitle>\n                <Button onClick={() => handleExport(\"unlock\")} size=\"sm\">\n                  <Download className=\"h-4 w-4 mr-2\" />\n                  Export\n                </Button>\n              </div>\n            </CardHeader>\n            <CardContent>\n              <Table>\n                <TableHeader>\n                  <TableRow>\n                    <TableHead>Timestamp</TableHead>\n                    <TableHead>prodice ID</TableHead>\n                    <TableHead>Method</TableHead>\n                    <TableHead>Attempt #</TableHead>\n                    <TableHead>Duration</TableHead>\n                    <TableHead>Success</TableHead>\n                    <TableHead>Error</TableHead>\n                  </TableRow>\n                </TableHeader>\n                <TableBody>\n                  {unlockLogs.map((log) => (\n                    <TableRow key={log.id}>\n                      <TableCell>{formatTimestamp(log.timestamp)}</TableCell>\n                      <TableCell className=\"font-medium\">\n                        {log.prodice_id}\n                      </TableCell>\n                      <TableCell>\n                        <Badge variant=\"outline\">{log.unlock_method}</Badge>\n                      </TableCell>\n                      <TableCell>{log.attempt_number}</TableCell>\n                      <TableCell>{log.duration_ms}ms</TableCell>\n                      <TableCell>\n                        <Badge\n                          variant={log.success ? \"default\" : \"destructive\"}\n                        >\n                          {log.success ? \"Success\" : \"Failed\"}\n                        </Badge>\n                      </TableCell>\n                      <TableCell>\n                        {log.error_details && (\n                          <span className=\"text-red-500 text-sm\">\n                            {log.error_details.substring(0, 50)}...\n                          </span>\n                        )}\n                      </TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"master\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <div className=\"flex items-center justify-between\">\n                <CardTitle>Master Action Logs</CardTitle>\n                <Button onClick={() => handleExport(\"master\")} size=\"sm\">\n                  <Download className=\"h-4 w-4 mr-2\" />\n                  Export\n                </Button>\n              </div>\n            </CardHeader>\n            <CardContent>\n              <Table>\n                <TableHeader>\n                  <TableRow>\n                    <TableHead>Timestamp</TableHead>\n                    <TableHead>Master User</TableHead>\n                    <TableHead>Action</TableHead>\n                    <TableHead>Target prodice</TableHead>\n                    <TableHead>Success</TableHead>\n                    <TableHead>Session ID</TableHead>\n                  </TableRow>\n                </TableHeader>\n                <TableBody>\n                  {masterLogs.map((log) => (\n                    <TableRow key={log.id}>\n                      <TableCell>{formatTimestamp(log.timestamp)}</TableCell>\n                      <TableCell className=\"font-medium\">\n                        {log.master_user}\n                      </TableCell>\n                      <TableCell>\n                        <Badge variant=\"outline\">{log.action}</Badge>\n                      </TableCell>\n                      <TableCell>{log.target_prodice || \"N/A\"}</TableCell>\n                      <TableCell>\n                        <Badge\n                          variant={log.success ? \"default\" : \"destructive\"}\n                        >\n                          {log.success ? \"Success\" : \"Failed\"}\n                        </Badge>\n                      </TableCell>\n                      <TableCell className=\"text-sm text-muted-foreground\">\n                        {log.session_id}\n                      </TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n\n      {/* Error Display */}\n      {error && (\n        <Alert variant=\"destructive\">\n          <AlertDescription>{error}</AlertDescription>\n        </Alert>\n      )}\n    </div>\n  );\n}\n",
    "usedDeprecatedRules": [
      { "ruleId": "no-extra-semi", "replacedBy": [] },
      { "ruleId": "no-mixed-spaces-and-tabs", "replacedBy": [] }
    ]
  },
