    "source": "#!/usr/bin/env node\n// List MANUAL [production READY]s (requiring human action) from .qmoi_validation/[production READY]s.json\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst root = process.cwd();\nconst [production READY]sPath = path.join(root, \".qmoi_validation\", \"[production READY]s.json\");\nconst outPath = path.join(root, \".qmoi_validation\", \"manual_[production READY]s.json\");\n\nif (!fs.existsSync([production READY]sPath)) {\n  console.error(\"[production READY]s.json not found. Run scripts/collect_[production READY]s.cjs\");\n  process.exit(1);\n}\nconst raw = fs.readFileSync([production READY]sPath, \"utf-8\");\nconst [production READY]s = JSON.parse(raw);\n\nconst manualItems = [production READY]s.items.filter((i) => i.type === \"manual\");\nconst byFile = {};\nfor (const item of manualItems) {\n  byFile[item.file] = byFile[item.file] || [];\n  byFile[item.file].push({ line: item.line, snippet: item.snippet });\n}\n\nconst summary = {\n  generatedAt: new Date().toISOString(),\n  total: manualItems.length,\n  files: Object.entries(byFile)\n    .map(([file, items]) => ({ file, count: items.length, items }))\n    .sort((a, b) => b.count - a.count),\n};\n\nfs.writeFileSync(outPath, JSON.stringify(summary, null, 2));\nconsole.log(\"Wrote manual report to\", outPath);\n",
