e: boolean,\n  ) => {\n    setAutomation((prev) => ({ ...prev, [key]: value }));\n  };\n\n  const updateQmoiApp = async () => {\n    [production READY]: Advanced automation controls, logs, scheduling */}\n                    </CardContent>\n                  </Card>\n                </TabsContent>\n              )}\n            </div>\n          </Tabs>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default SettingsPanel;\n",
