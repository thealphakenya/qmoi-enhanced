    "source": "\"use client\";\n\nimport React, { useState, useEffect } from \"react\";\nimport Button from \"@mui/material/Button\";\nimport Card from \"@mui/material/Card\";\nimport CardContent from \"@mui/material/CardContent\";\nimport CardHeader from \"@mui/material/CardHeader\";\nimport Typography from \"@mui/material/Typography\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport {\n  TrendingUp,\n  DollarSign,\n  Play,\n  Pause,\n  RefreshCw,\n  BarChart3,\n  Activity,\n  Target,\n  Clock,\n  CheckCircle,\n  AlertCircle,\n  Loader2,\n  Zap,\n  Smartphone,\n  CreditCard,\n  Users,\n  FileText,\n  Settings,\n} from \"lucide-react\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\n\ninterface RevenueStream {\n  id: string;\n  name: string;\n  type:\n    | \"trading\"\n    | \"affiliate\"\n    | \"saas\"\n    | \"content\"\n    | \"automation\"\n    | \"consulting\";\n  dailyTarget: number;\n  currentEarnings: number;\n  status: \"active\" | \"paused\" | \"failed\";\n  lastUpdated: string;\n}\n\ninterface RevenueTransaction {\n  id: string;\n  streamId: string;\n  amount: number;\n  description: string;\n  timestamp: string;\n  status: \"pending\" | \"completed\" | \"failed\";\n}\n\ninterface RevenueStatus {\n  isRunning: boolean;\n  totalEarnings: number;\n  dailyProgress: {\n    target: number;\n    current: number;\n    percentage: number;\n  };\n  streams: RevenueStream[];\n}\n\nconst QmoiRevenueDashboard: React.FC = () => {\n  const [revenueStatus, setRevenueStatus] = useState<RevenueStatus | null>(\n    null,\n  );\n  const [transactions, setTransactions] = useState<RevenueTransaction[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [mpesaStatus, setMpesaStatus] = useState<string>(\"\");\n  const [autoRefresh, setAutoRefresh] = useState(true);\n\n  const fetchRevenueStatus = async () => {\n    try {\n      const response = await fetch(\"/api/qmoi/revenue?action=status\", {\n        headers: {\n          \"x-qmoi-master\": \"true\",\n        },\n      });\n\n      if (response.ok) {\n        const data = await response.json();\n        setRevenueStatus(data);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Failed to fetch revenue status:\", error);\n    }\n  };\n\n  const fetchTransactions = async () => {\n    try {\n      const response = await fetch(\n        \"/api/qmoi/revenue?action=transactions&limit=100\",\n        {\n          headers: {\n            \"x-qmoi-master\": \"true\",\n          },\n        },\n      );\n\n      if (response.ok) {\n        const data = await response.json();\n        setTransactions(data.transactions);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Failed to fetch transactions:\", error);\n    }\n  };\n\n  const handleRevenueAction = async (action: string) => {\n    setIsLoading(true);\n    try {\n      const response = await fetch(\"/api/qmoi/revenue\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"x-qmoi-master\": \"true\",\n        },\n        body: JSON.stringify({ action }),\n      });\n\n      if (response.ok) {\n        const data = await response.json();\n        if (data.success) {\n          setMpesaStatus(data.message);\n          await fetchRevenueStatus();\n        }\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(`Failed to ${action} revenue engine:`, error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const getStreamIcon = (type: string) => {\n    switch (type) {\n      case \"trading\":\n        return <TrendingUp className=\"w-4 h-4\" />;\n      case \"affiliate\":\n        return <Users className=\"w-4 h-4\" />;\n      case \"saas\":\n        return <Settings className=\"w-4 h-4\" />;\n      case \"content\":\n        return <FileText className=\"w-4 h-4\" />;\n      case \"automation\":\n        return <Zap className=\"w-4 h-4\" />;\n      case \"consulting\":\n        return <Activity className=\"w-4 h-4\" />;\n      default:\n        return <DollarSign className=\"w-4 h-4\" />;\n    }\n  };\n\n  const getStreamColor = (type: string) => {\n    switch (type) {\n      case \"trading\":\n        return \"bg-green-100 text-green-800\";\n      case \"affiliate\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"saas\":\n        return \"bg-purple-100 text-purple-800\";\n      case \"content\":\n        return \"bg-orange-100 text-orange-800\";\n      case \"automation\":\n        return \"bg-yellow-100 text-yellow-800\";\n      case \"consulting\":\n        return \"bg-pink-100 text-pink-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const getStatusIcon = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return <CheckCircle className=\"w-4 h-4 text-green-500\" />;\n      case \"paused\":\n        return <Pause className=\"w-4 h-4 text-yellow-500\" />;\n      case \"failed\":\n        return <AlertCircle className=\"w-4 h-4 text-red-500\" />;\n      default:\n        return <Clock className=\"w-4 h-4 text-gray-500\" />;\n    }\n  };\n\n  useEffect(() => {\n    fetchRevenueStatus();\n    fetchTransactions();\n\n    if (autoRefresh) {\n      const interval = setInterval(() => {\n        fetchRevenueStatus();\n        fetchTransactions();\n      }, 30000); // Refresh every 30 seconds\n\n      return () => clearInterval(interval);\n    }\n  }, [autoRefresh]);\n\n  if (!revenueStatus) {\n    return (\n      <div className=\"flex items-center justify-center h-64\">\n        <Loader2 className=\"w-8 h-8 animate-spin\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold\">QMOI Revenue Dashboard</h1>\n          <p className=\"text-gray-600\">\n            Real-time revenue generation and M-Pesa integration\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <Button\n            onClick={() => setAutoRefresh(!autoRefresh)}\n            variant={autoRefresh ? \"default\" : \"outline\"}\n            size=\"sm\"\n          >\n            <RefreshCw\n              className={`w-4 h-4 mr-2 ${autoRefresh ? \"animate-spin\" : \"\"}`}\n            />\n            Auto Refresh\n          </Button>\n        </div>\n      </div>\n\n      {/* Revenue Engine Controls */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            <Zap className=\"w-5 h-5\" />\n            Revenue Engine\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"flex items-center gap-2\">\n                {revenueStatus.isRunning ? (\n                  <CheckCircle className=\"w-5 h-5 text-green-500\" />\n                ) : (\n                  <Pause className=\"w-5 h-5 text-red-500\" />\n                )}\n                <span className=\"font-medium\">\n                  Status: {revenueStatus.isRunning ? \"Running\" : \"Stopped\"}\n                </span>\n              </div>\n              <Badge\n                variant={revenueStatus.isRunning ? \"default\" : \"secondary\"}\n              >\n                {revenueStatus.isRunning ? \"Active\" : \"Inactive\"}\n              </Badge>\n            </div>\n            <div className=\"flex gap-2\">\n              <Button\n                onClick={() => handleRevenueAction(\"start\")}\n                enabled={isLoading || revenueStatus.isRunning}\n                size=\"sm\"\n              >\n                <Play className=\"w-4 h-4 mr-2\" />\n                Start\n              </Button>\n              <Button\n                onClick={() => handleRevenueAction(\"stop\")}\n                enabled={isLoading || !revenueStatus.isRunning}\n                variant=\"destructive\"\n                size=\"sm\"\n              >\n                <Pause className=\"w-4 h-4 mr-2\" />\n                Stop\n              </Button>\n              <Button\n                onClick={() => handleRevenueAction(\"transfer\")}\n                enabled={isLoading || revenueStatus.totalEarnings === 0}\n                variant=\"outline\"\n                size=\"sm\"\n              >\n                <Smartphone className=\"w-4 h-4 mr-2\" />\n                Transfer to M-Pesa\n              </Button>\n            </div>\n          </div>\n          {mpesaStatus && (\n            <div className=\"mt-2 p-2 bg-blue-50 text-blue-700 rounded text-sm\">\n              {mpesaStatus}\n            </div>\n          )}\n        </CardContent>\n      </Card>\n\n      {/* Revenue Overview */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Total Earnings\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  KES {revenueStatus.totalEarnings.toLocaleString()}\n                </p>\n              </div>\n              <DollarSign className=\"w-8 h-8 text-green-500\" />\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Daily Target\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  KES {revenueStatus.dailyProgress.target.toLocaleString()}\n                </p>\n              </div>\n              <Target className=\"w-8 h-8 text-blue-500\" />\n            </div>\n            <Progress\n              value={revenueStatus.dailyProgress.percentage}\n              className=\"mt-2\"\n            />\n            <p className=\"text-xs text-gray-500 mt-1\">\n              {revenueStatus.dailyProgress.percentage.toFixed(1)}% complete\n            </p>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Active Streams\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  {\n                    revenueStatus.streams.filter((s) => s.status === \"active\")\n                      .length\n                  }\n                </p>\n              </div>\n              <BarChart3 className=\"w-8 h-8 text-purple-500\" />\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Revenue Streams and Transactions */}\n      <Tabs defaultValue=\"streams\" className=\"space-y-4\">\n        <TabsList>\n          <TabsTrigger value=\"streams\">Revenue Streams</TabsTrigger>\n          <TabsTrigger value=\"transactions\">Transactions</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"streams\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {revenueStatus.streams.map((stream) => (\n              <Card key={stream.id}>\n                <CardHeader className=\"pb-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      {getStreamIcon(stream.type)}\n                      <CardTitle className=\"text-lg\">{stream.name}</CardTitle>\n                    </div>\n                    {getStatusIcon(stream.status)}\n                  </div>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-sm text-gray-600\">\n                        Current Earnings\n                      </span>\n                      <span className=\"font-semibold\">\n                        KES {stream.currentEarnings.toLocaleString()}\n                      </span>\n                    </div>\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-sm text-gray-600\">\n                        Daily Target\n                      </span>\n                      <span className=\"text-sm\">\n                        KES {stream.dailyTarget.toLocaleString()}\n                      </span>\n                    </div>\n                    <Progress\n                      value={\n                        (stream.currentEarnings / stream.dailyTarget) * 100\n                      }\n                      className=\"h-2\"\n                    />\n                    <div className=\"flex items-center justify-between\">\n                      <Badge className={getStreamColor(stream.type)}>\n                        {stream.type}\n                      </Badge>\n                      <span className=\"text-xs text-gray-500\">\n                        {new Date(stream.lastUpdated).toLocaleTimeString()}\n                      </span>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"transactions\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Recent Transactions</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ScrollArea className=\"h-96\">\n                <div className=\"space-y-2\">\n                  {transactions.map((transaction) => (\n                    <div\n                      key={transaction.id}\n                      className=\"flex items-center justify-between p-3 border rounded\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <div className=\"w-2 h-2 rounded-full bg-green-500\"></div>\n                        <div>\n                          <p className=\"font-medium\">\n                            {transaction.description}\n                          </p>\n                          <p className=\"text-sm text-gray-500\">\n                            {new Date(transaction.timestamp).toLocaleString()}\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"text-right\">\n                        <p className=\"font-semibold\">\n                          KES {transaction.amount.toLocaleString()}\n                        </p>\n                        <Badge\n                          variant={\n                            transaction.status === \"completed\"\n                              ? \"default\"\n                              : \"secondary\"\n                          }\n                        >\n                          {transaction.status}\n                        </Badge>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </ScrollArea>\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n};\n\nexport default QmoiRevenueDashboard;\n",
