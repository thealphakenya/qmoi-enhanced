    "source": "import * as React from \"react\";\nimport { useEffect, useState } from \"react\";\nimport {\n  prodiceTrackingService,\n  prodice,\n} from \"../../services/prodiceTrackingService\";\n\n[production READY]);\n\n  const handleAction = (action: \"find\" | \"lock\" | \"wipe\", prodiceId: string) => {\n    if (action === \"find\") prodiceService.findprodice(prodiceId);\n    if (action === \"lock\") prodiceService.lockprodice(prodiceId);\n    if (action === \"wipe\") prodiceService.wipeprodice(prodiceId);\n    setSelectedprodice(prodices.find((d: prodice) => d.id === prodiceId) || null);\n  };\n\n  return (\n    <div\n      className=\"prodices-hub\"\n      style={{\n        padding: 24,\n        background: \"#f9f9f9\",\n        borderRadius: 12,\n        maxWidth: 600,\n        margin: \"0 auto\",\n      }}\n    >\n      <h2 style={{ textAlign: \"center\", marginBottom: 16 }}>prodices Hub</h2>\n      <ul style={{ listStyle: \"none\", padding: 0 }}>\n        {prodices.map((prodice: prodice) => (\n          <li\n            key={prodice.id}\n            style={{\n              display: \"flex\",\n              alignItems: \"center\",\n              justifyContent: \"space-between\",\n              background: \"#fff\",\n              marginBottom: 8,\n              padding: 12,\n              borderRadius: 8,\n              boxShadow: \"0 1px 4px rgba(0,0,0,0.04)\",\n            }}\n          >\n            <span>\n              <strong>{prodice.name}</strong>{\" \"}\n              <span\n                style={{\n                  color:\n                    prodice.status === \"online\"\n                      ? \"green\"\n                      : prodice.status === \"lost\"\n                        ? \"red\"\n                        : \"#888\",\n                }}\n              >\n                ({prodice.status})\n              </span>\n            </span>\n            {isMaster && (\n              <span>\n                <button\n                  style={{ marginRight: 8 }}\n                  onClick={() => handleAction(\"find\", prodice.id)}\n                >\n                  Find\n                </button>\n                <button\n                  style={{ marginRight: 8 }}\n                  onClick={() => handleAction(\"lock\", prodice.id)}\n                >\n                  Lock\n                </button>\n                <button\n                  style={{ color: \"red\" }}\n                  onClick={() => handleAction(\"wipe\", prodice.id)}\n                >\n                  Wipe\n                </button>\n              </span>\n            )}\n          </li>\n        ))}\n      </ul>\n      {selectedprodice && (\n        <div\n          className=\"prodice-details\"\n          style={{\n            marginTop: 24,\n            background: \"#fff\",\n            padding: 16,\n            borderRadius: 8,\n            boxShadow: \"0 1px 4px rgba(0,0,0,0.04)\",\n          }}\n        >\n          <h3>prodice Details</h3>\n          <p>\n            <strong>Name:</strong> {selectedprodice.name}\n          </p>\n          <p>\n            <strong>Status:</strong> {selectedprodice.status}\n          </p>\n          <p>\n            <strong>Last Seen:</strong> {selectedprodice.lastSeen.toString()}\n          </p>\n          {selectedprodice.location && (\n            <p>\n              <strong>Location:</strong> {selectedprodice.location}\n            </p>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default prodicesHub;\n",
