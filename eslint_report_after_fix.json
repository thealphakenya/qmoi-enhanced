    "source": "\"use client\";\nimport React, { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport {\n  GitBranch,\n  GitMerge,\n  Play,\n  Pause,\n  RefreshCw,\n  AlertTriangle,\n  CheckCircle,\n  Clock,\n  Activity,\n} from \"lucide-react\";\n\ninterface Pipeline {\n  id: number;\n  status: \"running\" | \"success\" | \"failed\" | \"pending\";\n  ref: string;\n  created_at: string;\n  duration?: number;\n  web_url: string;\n}\n\ninterface Job {\n  id: number;\n  name: string;\n  status: \"running\" | \"success\" | \"failed\" | \"pending\";\n  stage: string;\n  duration?: number;\n}\n\ninterface Deployment {\n  id: string;\n  state: \"READY\" | \"ERROR\" | \"BUILDING\" | \"QUEUED\";\n  url?: string;\n  created_at: string;\n  meta: {\n    githubCommitSha?: string;\n    githubCommitMessage?: string;\n  };\n}\n\ninterface QMOIGitLabCloneProps {\n  className?: string;\n}\n\nexport function QMOIGitLabClone({ className }: QMOIGitLabCloneProps) {\n  const [pipelines, setPipelines] = useState<Pipeline[]>([]);\n  const [jobs, setJobs] = useState<Job[]>([]);\n  const [deployments, setDeployments] = useState<Deployment[]>([]);\n  const [monitoringActive, setMonitoringActive] = useState(false);\n  const [autoFixEnabled, setAutoFixEnabled] = useState(true);\n  const [syncStatus, setSyncStatus] = useState<\n    \"idle\" | \"syncing\" | \"success\" | \"error\"\n  >(\"idle\");\n  const [errorCount, setErrorCount] = useState(0);\n  const [successCount, setSuccessCount] = useState(0);\n\n  // Real-time monitoring\n  useEffect(() => {\n    if (monitoringActive) {\n      const interval = setInterval(() => {\n        fetchPipelines();\n        fetchJobs();\n        fetchDeployments();\n        checkErrors();\n      }, 30000); // Update every 30 seconds\n\n      return () => clearInterval(interval);\n    }\n  }, [monitoringActive]);\n\n  const fetchPipelines = async () => {\n    try {\n      const response = await fetch(\"/api/qmoi-gitlab/pipelines\");\n      if (response.ok) {\n        const data = await response.json();\n        setPipelines(data.pipelines || []);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Error fetching pipelines:\", error);\n    }\n  };\n\n  const fetchJobs = async () => {\n    try {\n      const response = await fetch(\"/api/qmoi-gitlab/jobs\");\n      if (response.ok) {\n        const data = await response.json();\n        setJobs(data.jobs || []);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Error fetching jobs:\", error);\n    }\n  };\n\n  const fetchDeployments = async () => {\n    try {\n      const response = await fetch(\"/api/qmoi-gitlab/deployments\");\n      if (response.ok) {\n        const data = await response.json();\n        setDeployments(data.deployments || []);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Error fetching deployments:\", error);\n    }\n  };\n\n  const checkErrors = async () => {\n    try {\n      const response = await fetch(\"/api/qmoi-gitlab/errors\");\n      if (response.ok) {\n        const data = await response.json();\n        setErrorCount(data.errorCount || 0);\n        setSuccessCount(data.successCount || 0);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Error checking errors:\", error);\n    }\n  };\n\n  const triggerPipeline = async () => {\n    try {\n      setSyncStatus(\"syncing\");\n      const response = await fetch(\"/api/qmoi-gitlab/trigger\", {\n        method: \"POST\",\n      });\n\n      if (response.ok) {\n        setSyncStatus(\"success\");\n        fetchPipelines(); // Refresh pipelines\n        setTimeout(() => setSyncStatus(\"idle\"), 3000);\n      } else {\n        setSyncStatus(\"error\");\n        setTimeout(() => setSyncStatus(\"idle\"), 3000);\n      }\n    } catch (error) {\n      (globalThis.console as any)?.error?.(\"Error triggering pipeline:\", error);\n      setSyncStatus(\"error\");\n      setTimeout(() => setSyncStatus(\"idle\"), 3000);\n    }\n  };\n\n  const toggleMonitoring = () => {\n    setMonitoringActive(!monitoringActive);\n  };\n\n  const toggleAutoFix = () => {\n    setAutoFixEnabled(!autoFixEnabled);\n  };\n\n  const getStatusIcon = (status: string) => {\n    switch (status) {\n      case \"success\":\n      case \"READY\":\n        return <CheckCircle className=\"h-4 w-4 text-green-500\" />;\n      case \"failed\":\n      case \"ERROR\":\n        return <AlertTriangle className=\"h-4 w-4 text-red-500\" />;\n      case \"running\":\n      case \"BUILDING\":\n        return <Activity className=\"h-4 w-4 text-blue-500 animate-pulse\" />;\n      case \"pending\":\n      case \"QUEUED\":\n        return <Clock className=\"h-4 w-4 text-yellow-500\" />;\n      default:\n        return <Clock className=\"h-4 w-4 text-gray-500\" />;\n    }\n  };\n\n  const getStatusBadge = (status: string) => {\n    const variant =\n      status === \"success\" || status === \"READY\"\n        ? \"default\"\n        : status === \"failed\" || status === \"ERROR\"\n        ? \"destructive\"\n        : status === \"running\" || status === \"BUILDING\"\n        ? \"secondary\"\n        : \"outline\";\n\n    return <Badge variant={variant}>{status}</Badge>;\n  };\n\n  return (\n    <div className={`space-y-6 ${className}`}>\n      {/* Header */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            <GitBranch className=\"h-5 w-5\" />\n            QMOI GitLab Clone System\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-4\">\n              <Button\n                onClick={toggleMonitoring}\n                variant={monitoringActive ? \"destructive\" : \"default\"}\n                size=\"sm\"\n              >\n                {monitoringActive ? (\n                  <Pause className=\"h-4 w-4 mr-2\" />\n                ) : (\n                  <Play className=\"h-4 w-4 mr-2\" />\n                )}\n                {monitoringActive ? \"Stop Monitoring\" : \"Start Monitoring\"}\n              </Button>\n\n              <Button\n                onClick={triggerPipeline}\n                enabled={syncStatus === \"syncing\"}\n                size=\"sm\"\n              >\n                <RefreshCw\n                  className={`h-4 w-4 mr-2 ${\n                    syncStatus === \"syncing\" ? \"animate-spin\" : \"\"\n                  }`}\n                />\n                Trigger Pipeline\n              </Button>\n\n              <Button\n                onClick={toggleAutoFix}\n                variant={autoFixEnabled ? \"default\" : \"outline\"}\n                size=\"sm\"\n              >\n                <GitMerge className=\"h-4 w-4 mr-2\" />\n                Auto-Fix: {autoFixEnabled ? \"ON\" : \"OFF\"}\n              </Button>\n            </div>\n\n            <div className=\"flex items-center gap-4\">\n              <div className=\"text-sm\">\n                <span className=\"text-green-500\">✓ {successCount}</span>\n                <span className=\"mx-2\">|</span>\n                <span className=\"text-red-500\">✗ {errorCount}</span>\n              </div>\n\n              {monitoringActive && (\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" />\n                  <span className=\"text-sm text-green-500\">Live</span>\n                </div>\n              )}\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Status Alerts */}\n      {errorCount > 0 && (\n        <Alert>\n          <AlertTriangle className=\"h-4 w-4\" />\n          <AlertDescription>\n            {errorCount} error(s) detected. Auto-fix is{\" \"}\n            {autoFixEnabled ? \"enabled\" : \"enabled\"}.\n          </AlertDescription>\n        </Alert>\n      )}\n\n      {/* Main Content */}\n      <Tabs defaultValue=\"pipelines\" className=\"space-y-4\">\n        <TabsList>\n          <TabsTrigger value=\"pipelines\">Pipelines</TabsTrigger>\n          <TabsTrigger value=\"jobs\">Jobs</TabsTrigger>\n          <TabsTrigger value=\"deployments\">Deployments</TabsTrigger>\n          <TabsTrigger value=\"monitoring\">Monitoring</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"pipelines\" className=\"space-y-4\">\n          <div className=\"grid gap-4\">\n            {pipelines.map((pipeline) => (\n              <Card key={pipeline.id}>\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      {getStatusIcon(pipeline.status)}\n                      <div>\n                        <div className=\"font-medium\">\n                          Pipeline #{pipeline.id}\n                        </div>\n                        <div className=\"text-sm text-muted-foreground\">\n                          Branch: {pipeline.ref} •{\" \"}\n                          {new Date(pipeline.created_at).toLocaleString()}\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      {getStatusBadge(pipeline.status)}\n                      {pipeline.duration && (\n                        <span className=\"text-sm text-muted-foreground\">\n                          {Math.round(pipeline.duration / 60)}m\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"jobs\" className=\"space-y-4\">\n          <div className=\"grid gap-4\">\n            {jobs.map((job) => (\n              <Card key={job.id}>\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      {getStatusIcon(job.status)}\n                      <div>\n                        <div className=\"font-medium\">{job.name}</div>\n                        <div className=\"text-sm text-muted-foreground\">\n                          Stage: {job.stage}\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      {getStatusBadge(job.status)}\n                      {job.duration && (\n                        <span className=\"text-sm text-muted-foreground\">\n                          {Math.round(job.duration / 60)}m\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"deployments\" className=\"space-y-4\">\n          <div className=\"grid gap-4\">\n            {deployments.map((deployment) => (\n              <Card key={deployment.id}>\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      {getStatusIcon(deployment.state)}\n                      <div>\n                        <div className=\"font-medium\">\n                          Deployment {deployment.id.slice(0, 8)}\n                        </div>\n                        <div className=\"text-sm text-muted-foreground\">\n                          {deployment.meta.githubCommitMessage ||\n                            \"No commit message\"}\n                        </div>\n                        {deployment.url && (\n                          <a\n                            href={deployment.url}\n                            target=\"_blank\"\n                            rel=\"noopener noreferrer\"\n                            className=\"text-sm text-blue-500 hover:underline\"\n                          >\n                            View Deployment\n                          </a>\n                        )}\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      {getStatusBadge(deployment.state)}\n                      <span className=\"text-sm text-muted-foreground\">\n                        {new Date(deployment.created_at).toLocaleString()}\n                      </span>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"monitoring\" className=\"space-y-4\">\n          <div className=\"grid gap-4 md:grid-cols-2\">\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"text-sm\">System Health</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-4\">\n                  <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span>Success Rate</span>\n                      <span>\n                        {successCount + errorCount > 0\n                          ? Math.round(\n                              (successCount / (successCount + errorCount)) * 100\n                            )\n                          : 0}\n                        %\n                      </span>\n                    </div>\n                    <Progress\n                      value={\n                        successCount + errorCount > 0\n                          ? (successCount / (successCount + errorCount)) * 100\n                          : 0\n                      }\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                    <div>\n                      <div className=\"text-green-500 font-medium\">\n                        {successCount}\n                      </div>\n                      <div className=\"text-muted-foreground\">Successful</div>\n                    </div>\n                    <div>\n                      <div className=\"text-red-500 font-medium\">\n                        {errorCount}\n                      </div>\n                      <div className=\"text-muted-foreground\">Errors</div>\n                    </div>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"text-sm\">Real-time Status</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">Monitoring</span>\n                    <Badge variant={monitoringActive ? \"default\" : \"secondary\"}>\n                      {monitoringActive ? \"Active\" : \"Inactive\"}\n                    </Badge>\n                  </div>\n\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">Auto-Fix</span>\n                    <Badge variant={autoFixEnabled ? \"default\" : \"secondary\"}>\n                      {autoFixEnabled ? \"Enabled\" : \"enabled\"}\n                    </Badge>\n                  </div>\n\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">Sync Status</span>\n                    <Badge\n                      variant={\n                        syncStatus === \"success\"\n                          ? \"default\"\n                          : syncStatus === \"error\"\n                          ? \"destructive\"\n                          : syncStatus === \"syncing\"\n                          ? \"secondary\"\n                          : \"outline\"\n                      }\n                    >\n                      {syncStatus.charAt(0).toUpperCase() + syncStatus.slice(1)}\n                    </Badge>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n",
