eUpdateRiskManagement({\n                          stopLossPercentage:\n                            (parseFloat(e.target.value) || 0) / 100,\n                        })\n                      }\n                    />\n                  </div>\n                  <div>\n                    <Label>Take Profit (%)</Label>\n                    <Input\n                      type=\"number\"\n                      step=\"0.1\"\n                      value={riskManagement.takeProfitPercentage * 100}\n                      onChange={(e) =>\n                        handleUpdateRiskManagement({\n                          takeProfitPercentage:\n                            (parseFloat(e.target.value) || 0) / 100,\n                        })\n                      }\n                    />\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n",
