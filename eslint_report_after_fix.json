en items-center\">\n                  <span className=\"text-sm\">Active Downloads</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Pausing all downloads\");\n                      toast({\n                        title: \"Success\",\n                        description: \"All downloads paused\",\n                      });\n                    }}\n                  >\n                    Pause All\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* prodice Settings Panel */}\n          {showprodiceSettings && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">prodice Settings</h3>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Wallpaper</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Opening wallpaper settings\");\n                      toast({\n                        title: \"Wallpaper\",\n                        description: \"Opening wallpaper manager...\",\n                      });\n                    }}\n                  >\n                    Change Wallpaper\n                  </Button>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Appearance</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Opening appearance settings\");\n                      toast({\n                        title: \"Appearance\",\n                        description: \"Opening customization panel...\",\n                      });\n                    }}\n                  >\n                    Customize\n                  </Button>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-xs text-gray-500\">Installed Apps</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Opening app management\");\n                      toast({\n                        title: \"App Management\",\n                        description: \"Opening installed apps...\",\n                      });\n                    }}\n                  >\n                    Manage Apps\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Wallet Panel */}\n          {showWalletPanel && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Wallet Management</h3>\n              <div className=\"space-y-4\">\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Total Balance</span>\n                    <span className=\"text-lg font-bold\">$0.00</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">24h Change</span>\n                    <span className=\"text-lg font-bold text-green-500\">\n                      +0.00%\n                    </span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">Active Trades</span>\n                    <span className=\"text-lg font-bold\">0</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs text-gray-500\">\n                      Pending Orders\n                    </span>\n                    <span className=\"text-lg font-bold\">0</span>\n                  </div>\n                </div>\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-sm\">Recent Transactions</span>\n                    <Button\n                      size=\"sm\"\n                      variant=\"outline\"\n                      onClick={() => {\n                        console.log(\"Adding funds\");\n                        toast({\n                          title: \"Add Funds\",\n                          description: \"Opening payment methods...\",\n                        });\n                      }}\n                    >\n                      Add Funds\n                    </Button>\n                  </div>\n                  <div className=\"space-y-2\">\n                    <div className=\"text-sm text-gray-500\">\n                      No transactions yet. Start trading to see activity.\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Download Manager */}\n          {showDownloadManager && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Download Manager</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">Active Downloads</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Pausing downloads\");\n                      toast({\n                        title: \"Downloads\",\n                        description: \"All downloads paused\",\n                      });\n                    }}\n                  >\n                    Pause All\n                  </Button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Bluetooth prodices */}\n          {showBluetoothprodices && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Bluetooth prodices</h3>\n              <div className=\"space-y-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"outline\"\n                  onClick={() => {\n                    console.log(\"Scanning for Bluetooth prodices\");\n                    toast({\n                      title: \"Bluetooth\",\n                      description: \"Scanning for nearby prodices...\",\n                    });\n                  }}\n                >\n                  Scan for prodices\n                </Button>\n                <div className=\"text-sm text-gray-500\">No prodices found</div>\n              </div>\n            </div>\n          )}\n\n          {/* Network Settings */}\n          {showNetworkSettings && (\n            <div className=\"p-4 bg-gray-50 rounded-lg shadow mb-4\">\n              <h3 className=\"font-semibold mb-2\">Network Settings</h3>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-sm\">WiFi Networks</span>\n                  <Button\n                    size=\"sm\"\n                    variant=\"outline\"\n                    onClick={() => {\n                      console.log(\"Scanning WiFi networks\");\n                      toast({\n                        title: \"WiFi\",\n                        description: \"Scanning for available networks...\",\n               