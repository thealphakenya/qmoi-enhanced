n as any)\n                                          .listBuckets === \"function\"\n                                      ) {\n                                        const buckets = await (\n                                          AWSIntegration as any\n                                        ).listBuckets();\n                                        setAwsBuckets(buckets);\n                                        notify(\"Buckets refreshed\", \"info\");\n                                      }\n                                    }}\n                                  >\n                                    Refresh Buckets\n                                  </button>\n                                  <button\n                                    onClick={() => {\n                                      if (role !== \"admin\") {\n                                        notify(\"Admin only\", \"error\");\n                                        return;\n                                      }\n                                      setAwsModalOpen(true);\n                                    }}\n                                    style={{ marginLeft: 8 }}\n                                  >\n                                    Set Credentials\n                                  </button>\n                                  <div>\n                                    Buckets:{\" \"}\n                                    {awsBuckets.length\n                                      ? awsBuckets.join(\", \")\n                                      : \"None\"}\n                                  </div>\n                                </div>\n                              )}\n                              {d.name === \"Azure\" && prodiceStatus[d.name] && (\n                                <div style={{ marginTop: 8, marginBottom: 8 }}>\n                                  <button\n                                    onClick={async () => {\n                                      if (rol