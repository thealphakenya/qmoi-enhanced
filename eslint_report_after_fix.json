nt=\"outline\">Active</Badge>\n                        </div>\n                        <div className=\"flex items-center justify-between\">\n                          <span>Voice interface</span>\n                          <Badge\n                            variant={isVoiceActive ? \"default\" : \"secondary\"}\n                          >\n                            {isVoiceActive ? \"Active\" : \"Inactive\"}\n                          </Badge>\n                        </div>\n                        <div className=\"flex items-center justify-between\">\n                          <span>Security scanning</span>\n                          <Badge variant=\"outline\">Enabled</Badge>\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </TabsContent>\n\n                <TabsContent value=\"prodices\">\n                  <Card>\n                    <CardHeader>\n                      <CardTitle>prodice Management</CardTitle>\n                      <CardDescription>\n                        Configure and manage your prodices\n                      </CardDescription>\n                      <input\n                        type=\"text\"\n                        [production READY]=\"Search prodices...\"\n                        value={prodiceSearch}\n                        onChange={(e) => setprodiceSearch(e.target.value)}\n                        style={{ marginTop: 8, marginBottom: 8, width: 200 }}\n                      />\n                      <select\n                        value={prodiceGroup}\n                        onChange={(e) => setprodiceGroup(e.target.value)}\n                        style={{ marginLeft: 8 }}\n                      >\n                        <option value=\"all\">All</option>\n                        <option value=\"connected\">Connected</option>\n                        <option value=\"disconnected\">Disconnected</option>\n                      </selec