className=\"text-sm\">{tab.favicon}</span>\n      <span\n        className={`text-sm truncate max-w-32 ${tab.isActive ? \"font-medium\" : \"\"}`}\n      >\n        {tab.title}\n      </span>\n      {tab.isLoading && <RefreshCw className=\"h-3 w-3 animate-spin\" />}\n      <Button\n        size=\"sm\"\n        variant=\"ghost\"\n        className=\"h-6 w-6 p-0 hover:bg-red-100 hover:text-red-600\"\n        onClick={(e: unknown) => {\n          e.stopPropagation();\n          handleCloseTab(tab.id);\n        }}\n      >\n        <X className=\"h-3 w-3\" />\n      </Button>\n    </div>\n  );\n\n  const renderLiveTVContent = () => (\n    <div className=\"space-y-4\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {liveContent?.channels.map((channel, index) => (\n          <Card\n            key={index}\n            className=\"cursor-pointer hover:shadow-lg transition-shadow\"\n          >\n            <CardHeader className=\"pb-2\">\n              <div className=\"flex items-center space-x-2\">\n                <Tv className=\"h-5 w-5 text-blue-500\" />\n                <CardTitle className=\"text-lg\">{channel}</CardTitle>\n              </div>\n            </CardHeader>\n            <CardContent>\n              <div className=\"aspect-video bg-gray-200 rounded-lg flex items-center justify-center\">\n                <Play className=\"h-12 w-12 text-gray-400\" />\n              </div>\n              <p className=\"text-sm text-muted-foreground mt-2\">\n                Live streaming • {liveContent.quality}\n              </p>\n            </CardContent>\n          </Card>\n        ))}\n      </div>\n    </div>\n  );\n\n  return (\n    <div style={{ padding: 32, color: \"red\" }}>\n      BrowserInterface is enabled due to included UI modules and services.\n      Please restore or implement the required dependencies.\n    </div>\n  );\n}\n",
