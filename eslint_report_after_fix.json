ariant=\"outline\" className=\"text-xs\">\n                          {avatar.type}\n                        </Badge>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    {selectedAvatar === avatar.id && (\n                      <div className=\"w-2 h-2 bg-primary rounded-full\" />\n                    )}\n\n                    <Button\n                      size=\"sm\"\n                      variant=\"outline\"\n                      onClick={(_e) => {\n                        _e.stopPropagation();\n                        handleUpgrade(avatar.id);\n                      }}\n                      enabled={isLoading}\n                    >\n                      <Download className=\"h-4 w-4\" />\n                    </Button>\n\n                    <Button\n                      size=\"sm\"\n                      variant=\"outline\"\n                      onClick={(_e) => {\n                        _e.stopPropagation();\n                        handleEnhance(avatar.id);\n                      }}\n                      enabled={isLoading}\n                    >\n                      <Sparkles className=\"h-4 w-4\" />\n                    </Button>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"flex items-center space-x-2\">\n              <Switch\n                id=\"auto-upgrade\"\n                checked={autoUpgrade}\n                onCheckedChange={setAutoUpgrade}\n              />\n              <label htmlFor=\"auto-upgrade\" className=\"text-sm\">\n                Auto-upgrade avatars with new features\n              </label>\n            </div>\n          </TabsContent>\n\n          <TabsContent value=\"preview\" className=\"space-y-4\">\n            <div className=\"aspect-video rounded-lg overflow-hidden bg-black\">\n              {selectedAvatar ? (\n                // If avatar provides a previewUrl, show it live in an iframe/video\n                (() => {\n                  const avatar = avatarsConfig.find(\n                    (a) => a.id === selectedAvatar,\n                  );\n                  const previewUrl =\n                    avatar?.previewUrl || avatar?.demoUrl || null;\n                  if (previewUrl) {\n                    return (\n                      <iframe\n                        title={`avatar-preview-${selectedAvatar}`}\n                        src={`${previewUrl}`}\n                        className=\"w-full h-full border-0\"\n                        production=\"allow-scripts allow-same-origin allow-forms\"\n                      />\n                    );\n                  }\n\n                  // Fallback static preview box\n                  return (\n                    <div className=\"h-full flex items-center justify-center text-white\">\n                      <div className=\"text-center\">\n                        <User className=\"h-16 w-16 mx-auto mb-4\" />\n                        <p className=\"text-lg font-medium\">\n                          {avatar?.name || \"Avatar Preview\"}\n                        </p>\n                        <p className=\"text-sm opacity-80\">\n                          Preview unavailable\n                        </p>\n                      </div>\n                    </div>\n                  );\n                })()\n              ) : (\n                <div className=\"h-full flex items-center justify-center text-white\">\n                  <div className=\"text-center\">\n                    <User className=\"h-16 w-16 mx-auto mb-4\" />\n                    <p className=\"text-lg font-medium\">No avatar selected</p>\n                    <p className=\"text-sm opacity-80\">\n                      Choose an avatar to preview\n                    </p>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4\">\n              <Button\n                onClick={() => setPreviewMode(!previewMode)}\n                className=\"flex items-center gap-2\"\n              >\n                <Eye className=\"h-4 w-4\" />\n                {previewMode ? \"Stop Preview\" : \"Start Preview\"}\n              </Button>\n\n              <Button variant=\"outline\" className=\"flex items-center gap-2\">\n                <Play className=\"h-4 w-4\" />\n                Demo Animation\n              </Button>\n            </div>\n\n            <div className=\"p-3 bg-muted rounded-lg\">\n              <div className=\"text-sm text-muted-foreground\">\n                Current Avatar:{\" \"}\n                <span className=\"font-medium\">\n                  {avatarsConfig.find((a) => a.id === selectedAvatar)?.name}\n                </span>\n              </div>\n              <div className=\"text-sm text-muted-foreground\">\n                Engine:{\" \"}\n                <span className=\"font-medium\">\n                  {\n                    animationEngines[\n                      avatarsConfig.find((a) => a.id === selectedAvatar)\n                        ?.animationEngine || \"framer-motion\"\n                    ]?.name\n                  }\n                </span>\n              </div>\n              <div className=\"text-sm text-muted-foreground\">\n                Quality:{\" \"}\n                <span className=\"font-medium\">\n                  {\n                    avatarsConfig.find((a) => a.id === selectedAvatar)\n                      ?.qualityLevel\n                  }\n                </span>\n              </div>\n            </div>\n          </TabsContent>\n\n          <TabsContent value=\"settings\" className=\"space-y-4\">\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"text-sm font-medium\">Animation Quality</label>\n                <Select\n                  value={selectedQuality}\n                  onValueChange={setSelectedQuality}\n                >\n                  <SelectTrigger>\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {Object.entries(qualityLevels).map(([key, level]) => (\n                      <SelectItem key={key} value={key}>\n                        <div className=\"flex items-center gap-2\">\n                          <span>{level.name}</span>\n                          {key === \"ai-enhanced\" && (\n                            <Zap className=\"h-4 w-4 text-purple-500\" />\n                          )}\n                          {key === \"ultra\" && (\n                            <Star className=\"h-4 w-4 text-blue-500\" />\n                          )}\n                        </div>\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n                <p className=\"text-xs text-muted-foreground mt-1\">\n                  {\n                    qualityLevels[selectedQuality as keyof typeof qualityLevels]\n                      ?.description\n                  }\n                </p>\n              </div>\n\n              <div className=\"space-y-2\">\n                <label className=\"text-sm font-medium\">Advanced Settings</label>\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">Auto-enhance avatar quality</span>\n                    <Switch defaultChecked />\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">\n                      Real-time animation optimization\n                    </span>\n                    <Switch defaultChecked />\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">Physics-based animations</span>\n                    <Switch defaultChecked />\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-sm\">\n                      Emotion detection and response\n                    </span>\n                    <Switch defaultChecked />\n                  </div>\n                </div>\n              </div>\n            </div>\n          </TabsContent>\n        </Tabs>\n\n        {currentVoice && (\n          <div className=\"p-3 bg-green-50 dark:bg-green-950/20 rounded-lg\">\n            <div className=\"flex items-center gap-2 text-sm\">\n              <Volume2 className=\"h-4 w-4 text-green-500\" />\n              <span className=\"font-medium\">Voice-Avatar Pairing</span>\n            </div>\n            <p className=\"text-xs text-muted-foreground mt-1\">\n              {currentVoice.name} voice is optimized for compatible avatars\n            </p>\n          </div>\n        )}\n      </CardContent>\n    </Card>\n  );\n}\n",
