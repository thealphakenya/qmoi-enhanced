                onClick={() => setLoginMode("form")}
                className={`flex-1 py-2 rounded-md font-medium transition-colors ${
                  loginMode === "form"
                    ? "bg-white text-blue-600 shadow-sm"
                    : "text-gray-600"
                }`}
              >
                Email Login
              </button>
              <button
                onClick={() => setLoginMode("quick")}
                className={`flex-1 py-2 rounded-md font-medium transition-colors ${
                  loginMode === "quick"
                    ? "bg-white text-blue-600 shadow-sm"
                    : "text-gray-600"
                }`}
