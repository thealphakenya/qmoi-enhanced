                  <p>📋 Admin: admin / adminpass</p>
                  <p>👤 User: user / adminpass</p>
                  <p className="text-blue-600 font-semibold mt-2">Master is System Admin</p>
                </div>
              </form>
            )}

            {/* Quick Login Buttons */}
