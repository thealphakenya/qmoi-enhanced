                  className="w-full bg-gray-100 text-gray-900 py-3 px-4 rounded-lg font-medium hover:bg-gray-200 transition-colors"
                >
                  👤 Demo User
                </button>
              </div>
            )}

            {/* Biometric Login (alternative) */}
            <div className="mt-6">
