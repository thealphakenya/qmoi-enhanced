{
  "version": "1.0",
  "created": "2026-04-03T03:06:36.326332",
  "system": "QMOI Domain Health Automation",
  "health_monitors": {
    "dns_monitor": {
      "enabled": true,
      "check_interval": 3600,
      "retry_attempts": 3,
      "alert_threshold": 1
    },
    "ssl_monitor": {
      "enabled": true,
      "check_interval": 86400,
      "alert_before_expiry_days": 30
    },
    "http_monitor": {
      "enabled": true,
      "check_interval": 300,
      "timeout": 10,
      "retry_attempts": 3
    },
    "ui_feature_monitor": {
      "enabled": true,
      "check_interval": 3600,
      "track_features": [
        "responsive_design",
        "navigation",
        "forms",
        "api_endpoints",
        "authentication",
        "dashboard",
        "real_time_updates"
      ]
    },
    "active_status_monitor": {
      "enabled": true,
      "check_interval": 1800,
      "parked_indicators": [
        "domain for sale",
        "parking service",
        "buy this domain"
      ]
    }
  },
  "remediation_engine": {
    "enabled": true,
    "auto_fix": true,
    "severity_levels": {
      "critical": {
        "score": 0,
        "auto_alert": true,
        "auto_remediate": true,
        "actions": [
          "activate_domain",
          "enable_dns",
          "setup_ssl"
        ]
      },
      "high": {
        "score_range": [
          1,
          40
        ],
        "auto_alert": true,
        "auto_remediate": true,
        "actions": [
          "fix_ssl",
          "enable_caching",
          "setup_cdn"
        ]
      },
      "medium": {
        "score_range": [
          41,
          70
        ],
        "auto_alert": false,
        "auto_remediate": true,
        "actions": [
          "optimize_performance",
          "add_features"
        ]
      },
      "low": {
        "score_range": [
          71,
          100
        ],
        "auto_alert": false,
        "auto_remediate": false,
        "actions": [
          "monitor"
        ]
      }
    }
  },
  "automation_actions": {
    "activate_domain": {
      "type": "dns",
      "description": "Activate DNS records for domain",
      "retry": 3
    },
    "enable_ssl": {
      "type": "certificate",
      "description": "Enable SSL/TLS certificate",
      "provider": "letsencrypt"
    },
    "setup_cdn": {
      "type": "infrastructure",
      "description": "Setup CDN for domain",
      "provider": "cloudflare"
    },
    "activate_ui": {
      "type": "content",
      "description": "Activate UI features and content",
      "auto_populate": true
    },
    "remove_parked_status": {
      "type": "registration",
      "description": "Remove parked domain status and activate"
    }
  },
  "dashboards": {
    "health_dashboard": {
      "refresh_interval": 300,
      "metrics": [
        "total_healthy_domains",
        "health_percentage",
        "domains_needing_remediation",
        "active_domains_count"
      ]
    },
    "remediation_dashboard": {
      "refresh_interval": 60,
      "track": [
        "recent_fixes",
        "failed_remediations",
        "pending_actions"
      ]
    }
  },
  "alerts": {
    "email_alerts": {
      "enabled": true,
      "recipients": [
        "thevictorkenya@outlook.com"
      ],
      "frequency": "immediate"
    },
    "webhook_alerts": {
      "enabled": true,
      "endpoints": []
    },
    "slack_alerts": {
      "enabled": false,
      "webhook": null
    }
  },
  "production": true,
  "RELEASE": false,
  "logLevel": "error",
  "lastEnhanced": "2026-04-08T22:14:05.324792",
