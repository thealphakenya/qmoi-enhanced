# Example Vercel environment file - do NOT commit real secrets here.
# Copy this file to `vercel.env` locally and fill values before deploying.

VERCEL_TOKEN=your_vercel_token_here
NODE_ENV=production

# Example additional env variables used by QMOI (placeholders)
## QMOI service credentials (set these in Vercel/GitHub/GCP secrets - do NOT commit)
QMOI_API_KEY=REPLACE_WITH_QMOI_API_KEY
M_PESA_CLIENT_ID=REPLACE_WITH_M_PESA_CLIENT_ID
M_PESA_CLIENT_SECRET=REPLACE_WITH_M_PESA_CLIENT_SECRET

# WhatsApp notifications (provider selection)
# QMOI_WHATSAPP_PROVIDER can be 'local' (default) or 'twilio'
QMOI_WHATSAPP_PROVIDER=local
# If using a local webhook endpoint for WhatsApp messages (POST {to, message})
QMOI_WHATSAPP_ENDPOINT=http://localhost:3000/api/whatsapp-bot?send=1
# Twilio credentials (if using 'twilio' provider)
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM=REPLACE_WITH_TWILIO_FROM_NUMBER
# Twilio WhatsApp 'From' value, e.g. 'whatsapp:+1415XXXXXXX'
TWILIO_WHATSAPP_FROM=REPLACE_WITH_TWILIO_WHATSAPP_FROM

# WhatsApp Cloud (Meta) credentials - for WhatsApp Cloud API provider
# Set QMOI_WHATSAPP_PROVIDER=whatsapp_cloud to enable
WHATSAPP_CLOUD_TOKEN=REPLACE_WITH_WHATSAPP_CLOUD_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID

# M-Pesa (Safaricom) credentials
MPESA_CONSUMER_KEY=REPLACE_WITH_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_MPESA_CONSUMER_SECRET
MPESA_PASSKEY=REPLACE_WITH_MPESA_PASSKEY
MPESA_BUSINESS_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox # or 'production'
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Pesapal credentials
PESAPAL_CONSUMER_KEY=REPLACE_WITH_PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=REPLACE_WITH_PESAPAL_CONSUMER_SECRET
PESAPAL_ENVIRONMENT=sandbox # or 'production'
PESAPAL_API_URL=
PESAPAL_CALLBACK_URL=https://your-domain.com/api/pesapal/callback

# Airtel Money credentials
AIRTEL_CLIENT_ID=REPLACE_WITH_AIRTEL_CLIENT_ID
AIRTEL_CLIENT_SECRET=REPLACE_WITH_AIRTEL_CLIENT_SECRET
AIRTEL_API_URL=https://openapiuat.airtel.africa

# Toggle to allow destructive/side-effectful production actions (must be explicitly set in production)
PRODUCTION_CONFIRMED=0

# For security: store real secrets in your CI/CD provider or a secret manager (Vault, AWS KMS, GitHub Secrets)
