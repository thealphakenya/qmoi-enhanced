# Example Vercel environment file - do NOT commit real secrets here.
# Copy this file to `vercel.env` locally and fill values before deploying.

VERCEL_TOKEN=your_vercel_token_here
NODE_ENV=production

# Example additional env variables used by QMOI (placeholders)
QMOI_API_KEY=your_api_key_here
M_PESA_CLIENT_ID=your_mpesa_client_id
M_PESA_CLIENT_SECRET=your_mpesa_client_secret

# WhatsApp notifications (provider selection)
# QMOI_WHATSAPP_PROVIDER can be 'local' (default) or 'twilio'
QMOI_WHATSAPP_PROVIDER=local
# If using a local webhook endpoint for WhatsApp messages (POST {to, message})
QMOI_WHATSAPP_ENDPOINT=http://localhost:3000/api/whatsapp-bot?send=1
# Twilio credentials (if using 'twilio' provider)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=whatsapp:+1234567890

# For security: store real secrets in your CI/CD provider or a secret manager (Vault, AWS KMS, GitHub Secrets)
