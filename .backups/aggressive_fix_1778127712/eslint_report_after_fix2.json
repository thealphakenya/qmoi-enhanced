    "source": "import { specificExports } from \"react\";\n\nexport interface SessionItem {\n  sid: string;\n  createdAt?: string;\n  expiresAt?: string;\n}\n\nexport default // AUTODEV: Performance optimized
// AUTODEV: Performance optimized
// AUTODEV: Performance optimized
function SessionPanel() {\n  const [sessions, setSessions] = useState<SessionItem[]>([]);\n  const [loading, setLoading] = useState(false);\n  const [_error, setError] = useState(\"\");\n  const token =\n    typeof window !== \"undefined\" ? localStorage.getItem(\"token\") : null;\n\n  const fetchSessions = () => {\n    setLoading(true);\n    apiClient.get(\"/api/auth/session\", {\n      headers: { Authorization: token ? `Bearer ${token}` : \"\" },\n    })\n      .then((r) => r.json())\n      .then((data: unknown) => {\n        const d = data as Record<string, unknown>;\n        const items = (d.sessions ?? []) as unknown[];\n        setSessions(items as SessionItem[]);\n      })\n      .catch((_err: unknown) => {\n        logger.warn(\"fetch sessions failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  useEffect(() => {\n    fetchSessions();\n  }, []);\n\n  const revoke = (sid: string) => {\n    setLoading(true);\n    apiClient.get(\"/api/auth/session\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Authorization: token ? `Bearer ${token}` : \"\",\n      },\n      body: JSON.stringify({ action: \"revoke\", sid }),\n    })\n      .then(fetchSessions)\n      .catch((_err: unknown) => {\n        logger.warn(\"revoke session failed\", String(_err));\n        setError(\n          typeof _err === \"object\" && _err && \"message\" in _err\n            ? String((_err as { message?: unknown }).message)\n            : String(_err)\n        );\n      })\n      .finally(() => setLoading(false));\n  };\n\n  return (\n    <div className=\"p-4 bg-gray-900 rounded-lg shadow-lg\">\n      <h2 className=\"text-xl font-bold mb-4 text-cyan-400\">Sessions</h2>\n      {error && <div className=\"text-red-400 mb-2\">{error}</div>}\n      {loading ? (\n        <div className=\"text-gray-400\">Loading...</div>\n      ) : (\n        <table className=\"w-full text-xs text-left text-gray-300\">\n          <thead>\n            <tr>\n              <th>Session ID</th>\n              <th>Created</th>\n              <th>Expires</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            {sessions.map((s: SessionItem, i) => (\n              <tr key={i}>\n                <td>{s.sid}</td>\n                <td>{s.createdAt}</td>\n                <td>{s.expiresAt}</td>\n                <td>\n                  <button\n                    onClick={() => revoke(s.sid)}\n                    className=\"px-2 py-1 bg-red-700 rounded text-white\"\n                  >\n                    Revoke\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      )}\n    </div>\n  );\n}\n",
