ground: \"#111\",\n                    color: \"#0ff\",\n                    borderRadius: 4,\n                    padding: 8,\n                    overflowX: \"auto\",\n                  }}\n                >\n                  {JSON.stringify(status.lastResult.fixResults, null, 2)}\n                </pre>\n              </div>\n            </div>\n          ) : (\n            <div style={{ color: \"#888\" }}>No recent results.</div>\n          )}\n        </div>\n      )}\n      <div style={{ marginTop: 24 }}>\n        <h4>Audit Log / History</h4>\n        <div\n          style={{\n            display: \"flex\",\n            alignItems: \"center\",\n            gap: 12,\n            marginBottom: 8,\n          }}\n        >\n          <button\n            onClick={fetchLogs}\n            style={{\n              background: \"#222\",\n              color: \"#0ff\",\n              border: \"1px solid #0ff\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Refresh Logs\n          </button>\n          <button\n            onClick={() => exportToCSV(filteredLogs)}\n            style={{\n              background: \"#222\",\n              color: \"#ff0\",\n              border: \"1px solid #ff0\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Export CSV\n          </button>\n          <button\n            onClick={() => exportToJSON(filteredLogs)}\n            style={{\n              background: \"#222\",\n              color: \"#0f0\",\n              border: \"1px solid #0f0\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Export JSON\n          </button>\n          <label style={{ marginLeft: 16, color: \"#ccc\" }}>Filter: </label>\n          <select\n            value={logFilter}\n            onChange={(_e) =>\n              setLogFilter(\n                (_e.target as HTMLSelectElement).value as \"all\" | \"fix\" | \"cicd\"\n              )\n            }\n            style={{\n              background: \"#111\",\n              color: \"#0ff\",\n              border: \"1px solid #0ff\",\n              borderRadius: 4,\n              padding: \"2px 8px\",\n            }}\n          >\n            <option value=\"all\">All</option>\n            <option value=\"fix\">Fix Cycles</option>\n            <option value=\"cicd\">CI/CD</option>\n          </select>\n        </div>\n        {logsLoading ? (\n          <div style={{ color: \"#ff0\" }}>Loading logs...</div>\n        ) : (\n          <div\n            style={{\n              maxHeight: 220,\n              overflowY: \"auto\",\n              background: \"#181818\",\n              border: \"1px solid #333\",\n              borderRadius: 6,\n              padding: 8,\n            }}\n          >\n            {filteredLogs.length === 0 ? (\n              <div style={{ color: \"#888\" }}>No logs available.</div>\n            ) : (\n              filteredLogs.map((log, i) => (\n                <div\n                  key={i}\n                  style={{\n                    marginBottom: 10,\n                    borderBottom: \"1px solid #333\",\n                    paddingBottom: 6,\n                  }}\n                >\n                  <div style={{ color: \"#0ff\", fontSize: \"0.95em\" }}>\n                    <b>{log.timestamp}</b>{\" \"}\n                    <span style={{ color: \"#fff\" }}>{log.action}</span>\n                  </div>\n                  <pre\n                    style={{\n                      background: \"#111\",\n                      color: \"#eee\",\n                      borderRadius: 4,\n                      padding: 6,\n                      marginTop: 2,\n                      fontSize: \"0.92em\",\n                      overflowX: \"auto\",\n                    }}\n                  >\n                    {log.result}\n                  </pre>\n                </div>\n              ))\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n",
