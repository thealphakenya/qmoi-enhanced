function setCache<T>(\n  key: string,\n  data: T,\n  endpoint: keyof typeof CACHE_TTL\n): void {\n  cache.set(key, {\n    data,\n    timestamp: Date.now(),\n    ttl: CACHE_TTL[endpoint],\n  });\n}\n\nasync // AUTODEV: Performance optimized
