<span className=\"file-size\">\n                {(file.size / 1024).toFixed(2)} KB\n              </span>\n            )}\n          </div>\n        ))}\n      </div>\n      {selectedFile && (\n        <div className=\"file-actions\">\n          <button\n            onClick={() =>\n              handleDownload(files.find((f) => f.id === selectedFile)!)\n            }\n          >\n            Download\n          </button>\n          <button onClick={() => logger.info(\"View file\")}>View</button>\n        </div>\n      )}\n    </div>\n  );\n}\n",
