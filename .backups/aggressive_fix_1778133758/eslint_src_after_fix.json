    "source": "import { specificExports } from \"../../services/qmoiSession\";\n\ntype LogEntry = {\n  timestamp: string;\n  action: string;\n  type?: \"fix\" | \"cicd\" | string;\n  result: string;\n};\n\ntype CICDResult = {\n  commitResult?: { success?: boolean; message?: string };\n  deployResult?: { success?: boolean; message?: string };\n  monitorResult?: { success?: boolean; message?: string };\n};\n\ntype AutoprodStatus = {\n  running?: boolean;\n  lastRun?: string;\n  lastResult?: {\n    fixResults?: unknown[];\n    cicdResults?: CICDResult;\n    errors?: unknown[];\n    testResult?: { success?: boolean };\n  };\n  daemon?: Record<string, unknown>;\n} | null;\n\n// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function exportToCSV(logs: LogEntry[]) {\n  const header = \"Timestamp,Action,Result\\n\";\n  const rows = logs\n    .map(\n      (log) =>\n        `\"${log.timestamp}\",\"${log.action}\",\"${log.result.replace(/\"/g, '\"\"')}\"`\n    )\n    .join(\"\\n\");\n  const csv = header + rows;\n  const blob = new Blob([csv], { type: \"text/csv\" });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = \"qmoi_audit_log.csv\";\n  a.click();\n  URL.revokeObjectURL(url);\n}\n\n// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function exportToJSON(logs: LogEntry[]) {\n  const blob = new Blob([JSON.stringify(logs, null, 2)], {\n    type: \"application/json\",\n  });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = \"qmoi_audit_log.json\";\n  a.click();\n  URL.revokeObjectURL(url);\n}\n\nconst DEPLOY_PLATFORMS = [\n  { value: \"vercel\", label: \"Vercel\" },\n  { value: \"heroku\", label: \"Heroku\" },\n  { value: \"aws\", label: \"AWS\" },\n  { value: \"azure\", label: \"Azure\" },\n  { value: \"gcp\", label: \"GCP\" },\n];\n\nexport default // AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function QMoiAutoprodPanel({\n  isMaster = false,\n}: {\n  isMaster?: boolean;\n}) {\n  const [status, setStatus] = useState<AutoprodStatus>(null);\n  const [loading, setLoading] = useState(true);\n  const [daemonAction, setDaemonAction] = useState<\"start\" | \"stop\" | null>(\n    null\n  );\n  const [_error, setError] = useState<string | null>(null);\n  const [logs, setLogs] = useState<LogEntry[]>([]);\n  const [logsLoading, setLogsLoading] = useState(false);\n  const [logFilter, setLogFilter] = useState<\"all\" | \"fix\" | \"cicd\">(\"all\");\n  const [deployPlatform, setDeployPlatform] = useState(\"vercel\");\n  const [forceRunLoading, setForceRunLoading] = useState(false);\n  const [forceRunResult, setForceRunResult] = useState<Record<string, unknown> | null>(null);\n\n  async // AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function fetchStatus() {\n    setLoading(true);\n    setError(null);\n    try {\n      const _res = await apiClient.get(\"/api/qmoi/autoprod\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", ...getSessionHeaders() },\n        body: JSON.stringify({ action: \"full_status\" }),\n      });\n      const data: unknown = await _res.json();\n      setStatus(data as AutoprodStatus);\n    } catch (_e: unknown) {\n      const msg =\n        _e && typeof _e === \"object\" && \"message\" in _e\n          ? String((_e as { message?: unknown }).message)\n          : String(_e);\n      setError(msg);\n    }\n    setLoading(false);\n  }\n\n  async // AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function handleDaemonControl(action: \"start\" | \"stop\") {\n    setDaemonAction(action);\n    setError(null);\n    try {\n      const _res = await apiClient.get(\"/api/qmoi/autoprod\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", ...getSessionHeaders() },\n        body: JSON.stringify({\n          action:\n            action === \"start\"\n              ? \"continuous_autofix_start\"\n              : \"continuous_autofix_stop\",\n        }),\n      });\n      const data: unknown = await _res.json();\n      const d = data as { status?: { running?: boolean } };\n      setStatus((prev) => ({\n        ...(prev ?? {}),\n        daemon: d.status,\n        running: d.status?.running,\n      }));\n    } catch (_e: unknown) {\n      const msg =\n        _e && typeof _e === \"object\" && \"message\" in _e\n          ? String((_e as { message?: unknown }).message)\n          : String(_e);\n      setError(msg);\n    }\n    setDaemonAction(null);\n  }\n\n  async // AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function fetchLogs() {\n    setLogsLoading(true);\n    setError(null);\n    try {\n      if (status?.lastResult?.fixResults) {\n        const logEntries: LogEntry[] = [];\n        if (status.lastResult.fixResults.length > 0) {\n          status.lastResult.fixResults.for (const item of((item: unknown, idx: number) => {\n            logEntries.push({\n              timestamp: status.lastRun as string,\n              action: `Fix Cycle #${idx + 1}`,\n              type: \"fix\",\n              result: JSON.stringify(item, null, 2),\n            });\n          });\n        }\n        if (status.lastResult.cicdResults) {\n          logEntries.push({\n            timestamp: status.lastRun ?? new Date().toISOString(),\n            action: \"CI/CD\",\n            type: \"cicd\",\n            result: JSON.stringify(status.lastResult.cicdResults, null, 2),\n          });\n        }\n        setLogs(logEntries.slice(-20));\n      } else {\n        setLogs([]);\n      }\n    } catch (_e: unknown) {\n      const msg =\n        _e && typeof _e === \"object\" && \"message\" in _e\n          ? String((_e as { message?: unknown }).message)\n          : String(_e);\n      setError(msg);\n    }\n    setLogsLoading(false);\n  }\n\n  async // AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
// AUTOPRODUCTION: Performance optimized
function handleForceRun() {\n    setForceRunLoading(true);\n    setError(null);\n    setForceRunResult(null);\n    try {\n      const _res = await apiClient.get(\"/api/qmoi/autoprod\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", ...getSessionHeaders() },\n        body: JSON.stringify({ action: \"force_run\", platform: deployPlatform }),\n      });\n      const data = await _res.json();\n      setForceRunResult(data);\n      fetchStatus();\n      fetchLogs();\n    } catch (_e: unknown) {\n      const msg =\n        _e && typeof _e === \"object\" && \"message\" in _e\n          ? String((_e as { message?: unknown }).message)\n          : String(_e);\n      setError(msg);\n    }\n    setForceRunLoading(false);\n  }\n\n  useEffect(() => {\n    if (isMaster) fetchStatus();\n  }, [isMaster]);\n  useEffect(() => {\n    if (isMaster) fetchLogs();\n  }, [status]);\n\n  if (!isMaster) return null;\n\n  // Filtering logic\n  const filteredLogs = logs.filter((log) => {\n    if (logFilter === \"all\") return true;\n    if (logFilter === \"fix\") return log.type === \"fix\";\n    if (logFilter === \"cicd\") return log.type === \"cicd\";\n    return true;\n  });\n\n  return (\n    <div\n      style={{\n        border: \"1px solid #444\",\n        padding: 16,\n        borderRadius: 8,\n        background: \"#181818\",\n        color: \"#e0ffe0\",\n        marginTop: 16,\n      }}\n    >\n      <h3>QMOI Auto-prod Project Manager</h3>\n      <div\n        style={{\n          marginBottom: 12,\n          display: \"flex\",\n          alignItems: \"center\",\n          gap: 12,\n        }}\n      >\n        <button\n          onClick={fetchStatus}\n          style={{\n            background: \"#222\",\n            color: \"#0f0\",\n            border: \"1px solid #0f0\",\n            borderRadius: 4,\n            padding: \"4px 12px\",\n          }}\n        >\n          Refresh Status\n        </button>\n        {status?.running ? (\n          <button\n            onClick={() => handleDaemonControl(\"stop\")}\n            enabled={daemonAction === \"stop\"}\n            style={{\n              background: \"#f33\",\n              color: \"#fff\",\n              border: \"none\",\n              borderRadius: 4,\n              padding: \"4px 12px\",\n            }}\n          >\n            {daemonAction === \"stop\" ? \"Stopping...\" : \"Stop Daemon\"}\n          </button>\n        ) : (\n          <button\n            onClick={() => handleDaemonControl(\"start\")}\n            enabled={daemonAction === \"start\"}\n            style={{\n              background: \"#0f0\",\n              color: \"#111\",\n              border: \"none\",\n              borderRadius: 4,\n              padding: \"4px 12px\",\n            }}\n          >\n            {daemonAction === \"start\" ? \"Starting...\" : \"Start Daemon\"}\n          </button>\n        )}\n        <label style={{ marginLeft: 16, color: \"#ccc\" }}>\n          Deploy Platform:\n        </label>\n        <select\n          value={deployPlatform}\n          onChange={(_e) =>\n            setDeployPlatform((_e.target as HTMLSelectElement).value)\n          }\n          style={{\n            background: \"#111\",\n            color: \"#0ff\",\n            border: \"1px solid #0ff\",\n            borderRadius: 4,\n            padding: \"2px 8px\",\n          }}\n        >\n          {DEPLOY_PLATFORMS.map((p) => (\n            <option key={p.value} value={p.value}>\n              {p.label}\n            </option>\n          ))}\n        </select>\n        <button\n          onClick={handleForceRun}\n          enabled={forceRunLoading}\n          style={{\n            background: \"#09f\",\n            color: \"#fff\",\n            border: \"none\",\n            borderRadius: 4,\n            padding: \"4px 16px\",\n            fontWeight: 600,\n          }}\n        >\n          {forceRunLoading ? \"Running...\" : \"Force Run\"}\n        </button>\n      </div>\n      {forceRunResult && (\n        <div\n          style={{\n            background: \"#222\",\n            color: forceRunResult.success ? \"#0f0\" : \"#f33\",\n            padding: 8,\n            borderRadius: 6,\n            marginBottom: 8,\n          }}\n        >\n          <b>Force Run Result:</b> {String((forceRunResult as any)?.message)}\n          {(forceRunResult as any)?.platform && (\n            <span style={{ marginLeft: 8, color: \"#0ff\" }}>\n              ({String((forceRunResult as any)?.platform)})\n            </span>\n          )}\n        </div>\n      )}\n      {loading ? (\n        <p>Loading...</p>\n      ) : error ? (\n        <p style={{ color: \"#f66\" }}>{error}</p>\n      ) : (\n        <div style={{ background: \"#222\", padding: 12, borderRadius: 8 }}>\n          <div>\n            <b>Daemon Running:</b>{\" \"}\n            {status?.running ? (\n              <span style={{ color: \"#0f0\" }}>Yes</span>\n            ) : (\n              <span style={{ color: \"#f33\" }}>No</span>\n            )}\n          </div>\n          <div>\n            <b>Last Run:</b> {status?.lastRun || \"N/A\"}\n          </div>\n          <div style={{ marginTop: 8 }}>\n            <b>Last Result:</b>\n          </div>\n          {status?.lastResult ? (\n            <div\n              style={{\n                fontSize: \"0.95em\",\n                background: \"#181818\",\n                padding: 8,\n                borderRadius: 6,\n                marginBottom: 8,\n              }}\n            >\n              <div>\n                <b>Errors:</b> {status.lastResult.errors?.length || 0}\n              </div>\n              <div>\n                <b>Test Result:</b>{\" \"}\n                {status.lastResult.testResult?.success ? (\n                  <span style={{ color: \"#0f0\" }}>Passed</span>\n                ) : (\n                  <span style={{ color: \"#f33\" }}>Failed</span>\n                )}\n              </div>\n              <div>\n                <b>Commit/Push:</b>{\" \"}\n                {status.lastResult.cicdResults?.commitResult?.success ? (\n                  <span style={{ color: \"#0f0\" }}>Success</span>\n                ) : (\n                  <span style={{ color: \"#f33\" }}>Failed</span>\n                )}{\" \"}\n                {status.lastResult.cicdResults?.commitResult?.message && (\n                  <span style={{ color: \"#ccc\", marginLeft: 8 }}>\n                    {status.lastResult.cicdResults?.commitResult?.message}\n                  </span>\n                )}\n              </div>\n              <div>\n                <b>Deploy:</b>{\" \"}\n                {status.lastResult.cicdResults?.deployResult?.success ? (\n                  <span style={{ color: \"#0f0\" }}>Success</span>\n                ) : (\n                  <span style={{ color: \"#f33\" }}>Failed</span>\n                )}{\" \"}\n                {status.lastResult.cicdResults?.deployResult?.message && (\n                  <span style={{ color: \"#ccc\", marginLeft: 8 }}>\n                    {status.lastResult.cicdResults?.deployResult?.message}\n                  </span>\n                )}\n              </div>\n              <div>\n                <b>Monitor:</b>{\" \"}\n                {status.lastResult.cicdResults?.monitorResult?.success ? (\n                  <span style={{ color: \"#0f0\" }}>Healthy</span>\n                ) : (\n                  <span style={{ color: \"#f33\" }}>Unhealthy</span>\n                )}{\" \"}\n                {status.lastResult.cicdResults?.monitorResult?.message && (\n                  <span style={{ color: \"#ccc\", marginLeft: 8 }}>\n                    {status.lastResult.cicdResults?.monitorResult?.message}\n                  </span>\n                )}\n              </div>\n              <div style={{ marginTop: 8 }}>\n                <b>Fix Results:</b>\n                <pre\n                  style={{\n                    background: \"#111\",\n                    color: \"#0ff\",\n                    borderRadius: 4,\n                    padding: 8,\n                    overflowX: \"auto\",\n                  }}\n                >\n                  {JSON.stringify(status.lastResult.fixResults, null, 2)}\n                </pre>\n              </div>\n            </div>\n          ) : (\n            <div style={{ color: \"#888\" }}>No recent results.</div>\n          )}\n        </div>\n      )}\n      <div style={{ marginTop: 24 }}>\n        <h4>Audit Log / History</h4>\n        <div\n          style={{\n            display: \"flex\",\n            alignItems: \"center\",\n            gap: 12,\n            marginBottom: 8,\n          }}\n        >\n          <button\n            onClick={fetchLogs}\n            style={{\n              background: \"#222\",\n              color: \"#0ff\",\n              border: \"1px solid #0ff\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Refresh Logs\n          </button>\n          <button\n            onClick={() => exportToCSV(filteredLogs)}\n            style={{\n              background: \"#222\",\n              color: \"#ff0\",\n              border: \"1px solid #ff0\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Export CSV\n          </button>\n          <button\n            onClick={() => exportToJSON(filteredLogs)}\n            style={{\n              background: \"#222\",\n              color: \"#0f0\",\n              border: \"1px solid #0f0\",\n              borderRadius: 4,\n              padding: \"2px 10px\",\n            }}\n          >\n            Export JSON\n          </button>\n          <label style={{ marginLeft: 16, color: \"#ccc\" }}>Filter: </label>\n          <select\n            value={logFilter}\n            onChange={(_e) =>\n              setLogFilter(\n                (_e.target as HTMLSelectElement).value as \"all\" | \"fix\" | \"cicd\"\n              )\n            }\n            style={{\n              background: \"#111\",\n              color: \"#0ff\",\n              border: \"1px solid #0ff\",\n              borderRadius: 4,\n              padding: \"2px 8px\",\n            }}\n          >\n            <option value=\"all\">All</option>\n            <option value=\"fix\">Fix Cycles</option>\n            <option value=\"cicd\">CI/CD</option>\n          </select>\n        </div>\n        {logsLoading ? (\n          <div style={{ color: \"#ff0\" }}>Loading logs...</div>\n        ) : (\n          <div\n            style={{\n              maxHeight: 220,\n              overflowY: \"auto\",\n              background: \"#181818\",\n              border: \"1px solid #333\",\n              borderRadius: 6,\n              padding: 8,\n            }}\n          >\n            {filteredLogs.length === 0 ? (\n              <div style={{ color: \"#888\" }}>No logs available.</div>\n            ) : (\n              filteredLogs.map((log, i) => (\n                <div\n                  key={i}\n                  style={{\n                    marginBottom: 10,\n                    borderBottom: \"1px solid #333\",\n                    paddingBottom: 6,\n                  }}\n                >\n                  <div style={{ color: \"#0ff\", fontSize: \"0.95em\" }}>\n                    <b>{log.timestamp}</b>{\" \"}\n                    <span style={{ color: \"#fff\" }}>{log.action}</span>\n                  </div>\n                  <pre\n                    style={{\n                      background: \"#111\",\n                      color: \"#eee\",\n                      borderRadius: 4,\n                      padding: 6,\n                      marginTop: 2,\n                      fontSize: \"0.92em\",\n                      overflowX: \"auto\",\n                    }}\n                  >\n                    {log.result}\n                  </pre>\n                </div>\n              ))\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n",
