### Example env for LION runtime
# Copy this file to tools/lion.env and customize for your environment.

# Control whether lion will apply changes when running audit commands
LION_APPLY=0

# Defaults for repo and outputs
LION_ROOT=/workspaces/qmoi-enhanced
LION_DOCS_DIR=${LION_ROOT}/docs

# Payment / wallet sandbox keys (use testnet keys)
WALLET_PROVIDER=testnet
WALLET_API_KEY=

# GitHub token for release checks (optional, only for release verification)
GITHUB_TOKEN=

# CI runner tag to prefer when scheduling jobs
CI_RUNNER_TAG=lion-runner
### Example env file for LION runtime (copy to tools/lion.env or repo root .env)
# These are safe defaults; override for production carefully and use a secrets vault for sensitive values.
# Use plain KEY=VAL format.

# Controls whether dry-run applies changes. Default=0 (dry-run).
LION_APPLY=0

# Path to repo root (auto-detected if omitted)
ROOT_DIR=

# GitHub repo for release checks (owner/repo)
GITHUB_REPO=thealphakenya/qmoi-enhanced

# Default base URL for API verification
QMOI_BASEURL=https://staging.q-city.ai

# Payment sandbox keys (placeholders) — store real secrets in a vault in production
PAYMENT_SANDBOX_KEY=changeme

# Wallet testnet RPC endpoint
WALLET_TESTNET_RPC=https://rpc.testnet.example

# Biometrics test harness mode
BIOMETRICS_TEST_MODE=simulated
# Example environment file for LION runtime
# Copy this to tools/lion.env and edit for your environment

# When set to 1 the scripts that modify files will apply changes (use with caution)
LION_APPLY=0

# Prevent using GitHub Codespaces host resources; LION will prefer its own runners
LION_USE_CODESPACE_RESOURCES=0

# Resource profile: small, medium, large, auto
LION_RESOURCES=auto

# Default GitHub repo owner/repo (used by release checks)
GITHUB_REPO=thealphakenya/qmoi-enhanced

# GitHub token (store in CI secrets / vault; do not commit real tokens)
# GITHUB_TOKEN=

# Optional path overrides
LION_LOG_DIR=$PWD/logs
### Example env file for LION runtime
# Copy this to tools/lion.env or to the repo root as .env to have lionctl pick it up automatically.

# When set to 1, lionctl will run scripts that modify files (use with caution).
LION_APPLY=0

# Environment mode: development | staging | production
LION_ENV=production

# Number of parallel runner workers LION may assume when scheduling background tasks
LION_RUNNERS=2

# Default operation timeout for short tasks (seconds)
LION_TIMEOUT=300

# Resource hints for runner pools (informational only)
LION_MAX_MEMORY=4G
LION_MAX_CPUS=2

# GitHub token used by release-checker scripts (recommended to store in secret manager / CI)
# GITHUB_TOKEN=

# Payment testnet / sandbox keys should be configured in a secure vault and referenced here.
# PAYMENT_SANDBOX_DSN=

# Vault / secrets manager endpoint
# SECRETS_VAULT_URL=

