#!/usr/bin/env bash
# tools/lionctl - improved scaffold for LION CLI
# Purpose: lightweight, safe entrypoint for LION operations. Commands are dry-run by default.

set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILES=("$ROOT_DIR/tools/lion.env" "$ROOT_DIR/.env")
for ef in "${ENV_FILES[@]}"; do
  if [ -f "$ef" ]; then
    # shellcheck disable=SC1090
    set -a
    # load simple KEY=VAL lines
    . "$ef"
    set +a
    LOADED_ENV_FILE="$ef"
    break
  fi
done
CMD=${1:-help}
shift || true

# Auto-load environment variables from tools/lion.env or .env if present (safe)
if [ -f "$ROOT_DIR/tools/lion.env" ]; then
  echo "Loading LION environment from $ROOT_DIR/tools/lion.env"
  # export all variables defined in file
  set -o allexport
  # shellcheck disable=SC1090
  source "$ROOT_DIR/tools/lion.env"
  set +o allexport
elif [ -f "$ROOT_DIR/.env" ]; then
  echo "Loading environment from $ROOT_DIR/.env"
  set -o allexport
  # shellcheck disable=SC1090
  source "$ROOT_DIR/.env"
  set +o allexport
fi

# Default production-safe fallbacks
: "${LION_APPLY:=0}"
: "${LION_USE_CODESPACE_RESOURCES:=0}"
: "${LION_RESOURCES:=auto}"

# Load environment variables from repo .env or tools/lion.env if present.
# This allows lionctl to run even when environment variables are not set in the shell.
ENV_CANDIDATES=("$ROOT_DIR/.env" "$ROOT_DIR/tools/lion.env" "$ROOT_DIR/tools/lion.env.local")
for f in "${ENV_CANDIDATES[@]}"; do
  if [ -f "$f" ]; then
    # Export variables found in the file while preserving existing env vars.
    # Use a safe read to avoid evaluating arbitrary commands.
    echo "Loading environment from $f"
    # shellcheck disable=SC1090
    set -a
    # load file
    . "$f"
    set +a
    break
  fi
done

# Set production-safe defaults for key LION variables if not provided.
LION_APPLY_DEFAULT=0
LION_ENV_DEFAULT="production"
LION_RUNNERS_DEFAULT=2
LION_TIMEOUT_DEFAULT=300
LION_MAX_MEMORY_DEFAULT="4G"
LION_MAX_CPUS_DEFAULT=2

LION_APPLY=${LION_APPLY:-${LION_APPLY_DEFAULT}}
LION_ENV=${LION_ENV:-${LION_ENV_DEFAULT}}
LION_RUNNERS=${LION_RUNNERS:-${LION_RUNNERS_DEFAULT}}
LION_TIMEOUT=${LION_TIMEOUT:-${LION_TIMEOUT_DEFAULT}}
LION_MAX_MEMORY=${LION_MAX_MEMORY:-${LION_MAX_MEMORY_DEFAULT}}
LION_MAX_CPUS=${LION_MAX_CPUS:-${LION_MAX_CPUS_DEFAULT}}

# Detect GitHub Codespaces environment and avoid using Codespaces host resources unless explicitly allowed.
if [ -n "${CODESPACES:-}" ] || [ -n "${GITHUB_CODESPACES:-}" ] || [ -d "/workspaces/.codespaces" ]; then
  echo "Detected Codespaces environment. LION_USE_CODESPACE_RESOURCES=${LION_USE_CODESPACE_RESOURCES}"
  if [ "${LION_USE_CODESPACE_RESOURCES}" = "0" ] || [ -z "${LION_USE_CODESPACE_RESOURCES}" ]; then
    echo "Codespaces host resources will NOT be used by LION (safe default)."
    # reduce runners to zero to avoid heavy workloads
    LION_RUNNERS=0
  else
    echo "LION is allowed to use Codespaces host resources (LION_USE_CODESPACE_RESOURCES=1)"
  fi
fi


