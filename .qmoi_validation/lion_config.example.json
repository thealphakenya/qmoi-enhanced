{
  "max_retries": 3,
  "retry_backoff_base": 2.0,
  "retry_jitter": 0.3,
  "default_priority": 50,
  "dry_run": true,
  "concurrency": 2,
  "auto_create_todos": true,
  "batch_size": 10,
  "enable_plugins": true,

  "# Notifications (opt-in):": "Use a CI-secret or environment variable to provide real secrets; do NOT commit secrets into the repo.",
  "notify_webhook": "https://hooks.example.com/qmoi/lion",
  "notify_hmac_secret": "<REPLACE_WITH_SECRET_IN_CI_OR_ENV>",
  "allow_outbound_notifications": false,
  "notify_max_attempts": 2
}
