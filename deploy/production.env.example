# Example production environment file (do NOT commit secrets)
# Copy this to `.env.production` or load into your secrets manager.

# Required: base URL for the QMOI model/API provider (e.g., hosted model service)
QMOI_API_BASE=https://api.your-model-host.example

# API key for the model provider (store this in your secret manager)
QMOI_API_KEY=your_api_key_here

# Memory backend (recommended: managed Redis). Leave empty to use file-based fallback.
QMOI_REDIS_URL=redis://:password@redis-host:6379/0

# Secret used to secure memory sync endpoints between services
QMOI_MEMORY_SECRET=replace-with-a-long-secret

# Proxy timeout (ms)
QMOI_PROXY_TIMEOUT_MS=10000

# Optional: guard to prevent running test helper in production (should be absent or 0)
QMOI_ALLOW_TEST_SERVER=0

# Optional sync/backends configuration (comma-separated)
QMOI_SYNC_BACKENDS=redis,gist
QMOI_GIST_ID=
QMOI_GH_TOKEN=
QMOI_HF_REPO=
QMOI_HF_TOKEN=
QMOI_SYNC_INTERVAL_SECONDS=3600

# Monitoring & logging (example placeholders)
SENTRY_DSN=
LOG_LEVEL=info

# Do not commit this file with real secrets. Use your cloud provider secret store.
