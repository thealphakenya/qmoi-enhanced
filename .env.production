# QMOI Enhanced - Production Environment Configuration
# Last Updated: January 18, 2026

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=production
APP_ENV=production
APP_URL=https://qmoi.app
APP_NAME=QMOI Enhanced
APP_VERSION=2.0.0

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@prod-db.host:5432/qmoi_prod
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000
DATABASE_LOG_QUERIES=false

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your-production-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# OAuth/Social Login (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# EMAIL SERVICE
# ============================================================================
EMAIL_PROVIDER=sendgrid  # or: smtp, aws-ses, mailgun
EMAIL_FROM=noreply@qmoi.app
EMAIL_FROM_NAME=QMOI Enhanced

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES
AWS_REGION=us-east-1
AWS_SES_USER=your-ses-user
AWS_SES_PASSWORD=your-ses-password

# SMTP (Generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

PAYPAL_CLIENT_ID=your-PayPal-client-id
PAYPAL_CLIENT_SECRET=your-PayPal-client-secret
PAYPAL_MODE=live

BRAINTREE_MERCHANT_ID=your-merchant-id
BRAINTREE_PUBLIC_KEY=your-public-key
BRAINTREE_PRIVATE_KEY=your-private-key

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
ERROR_TRACKING_URL=https://sentry.io/api/...
ERROR_TRACKING_TOKEN=your-sentry-token

METRICS_URL=https://api.datadog.com/api/v1/...
METRICS_TOKEN=your-datadog-token

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# STORAGE
# ============================================================================
STORAGE_TYPE=s3  # or: local, gcs, azure
AWS_S3_BUCKET=qmoi-prod-bucket
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key

# ============================================================================
# NOTIFICATIONS
# ============================================================================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# VERCEL (Deployment)
# ============================================================================
VERCEL_ENV=production
VERCEL_URL=qmoi-enhanced.vercel.app

# ============================================================================
# FEATURE FLAGS
# ============================================================================
QMOI_AUTO_SETUP_ENABLED=true
QMOI_AUTO_FIX_ENABLED=true
QMOI_AUTODEV_ENABLED=true
QMOI_AUTO_MONITORING_ENABLED=true
QMOI_AUTO_HEALTH_CHECK_ENABLED=true
QMOI_AUTO_RECOVERY_ENABLED=true

VERCEL_AUTO_DEPLOY=true
VERCEL_AUTO_SCALE=true
VERCEL_AUTO_ROLLBACK=true

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================
REDIS_URL=redis://prod-redis.host:6379
REDIS_PASSWORD=your-redis-password
CACHE_TTL=3600
SESSION_SECRET=your-session-secret

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================
CORS_ORIGINS=https://qmoi.app,https://www.qmoi.app,https://admin.qmoi.app
CORS_CREDENTIALS=true

# Security Headers
SECURITY_HEADER_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
SECURITY_HEADER_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HEADER_X_CONTENT_TYPE_OPTIONS=nosniff

# ============================================================================
# ANALYTICS
# ============================================================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-key

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
SLACK_BOT_TOKEN=xoxb-...

GITHUB_API_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret

GITLAB_API_TOKEN=your-gitlab-token
GITLAB_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# AI & ML SERVICES
# ============================================================================
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

HUGGING_FACE_API_TOKEN=hf_...

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
MAX_REQUEST_SIZE=50mb
REQUEST_TIMEOUT=60000
WORKER_THREADS=4

# Prisma
PRISMA_SKIP_PRISMA_VERSION_CHECK=false
PRISMA_CLIENT_ENGINE_TYPE=wasm

# ============================================================================
# INTERNAL / DO NOT SHARE
# ============================================================================
# These should NEVER be committed to version control
# Always use secret management system (AWS Secrets, HashiCorp Vault, etc.)
