generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  name              String?
  avatar            String?
  role              String   @default("user")
  permissions       String   @default("[]") // JSON string array of permissions
  biometricEnabled  Boolean  @default(false)
  accountStatus     String   @default("active")
  trustScore        Float    @default(0.5)
  lastLogin         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  devices           Device[]
  authProfile       AuthProfile?
  biometricProfile  BiometricProfile?
  profile           Profile?
  sessions          Session[]
}

model AuthProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  email         String   @unique
  username      String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  dateOfBirth   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?
  lastLoginMethod String @default("password")
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BiometricProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  primaryMethod   String?
  backupMethods   String   @default("[]") // JSON array
  securityLevel   String   @default("standard")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captures        BiometricCapture[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  avatar           String?
  bio              String?
  timezone         String?
  language         String?  @default("en")
  website          String?
  location         String?
  company          String?
  jobTitle         String?
  socialLinks      String?
  stylePreferences Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BiometricCapture {
  id            String   @id @default(cuid())
  biometricProfileId String
  method        String // "fingerprint" | "facial" | "voice"
  confidence    Float
  verified      Boolean @default(false)
  timestamp     DateTime @default(now())
  metadata      String? // JSON string
  biometricProfile BiometricProfile @relation(fields: [biometricProfileId], references: [id], onDelete: Cascade)

  @@index([biometricProfileId])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String   @unique
  authMethod    String   @default("password")
  biometricMethod String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastActivityAt DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  isActive      Boolean  @default(true)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String
  platform     String
  status       String   @default("offline")
  lastSync     DateTime?
  location     String?
  battery      Int?
  ipAddress    String?
  osVersion    String?
  memoryTotal  Int?
  memoryUsed   Int?
  memoryFree   Int?
  storageTotal Int?
  storageUsed  Int?
  storageFree  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  riskLevel String
  status    String
  sessionId String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([username])
}

model SystemMetric {
  id           String   @id @default(cuid())
  metricType   String
  metricName   String
  value        Float
  unit         String?
  category     String
  subsystem    String?
  dimensions   String?
  tags         String?
  source       String?
  collectedBy  String?
  createdAt    DateTime @default(now())
  
  @@index([category])
  @@index([metricName])
}

model EmergencyConfig {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  alertThresholds       String   @default("{}")
  autoActions           String   @default("{}")
  notificationChannels  String   @default("[]")
  emergencyContacts     String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String
  status    String   @default("pending")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

// QMOI: Global operations models
model RevenueStream {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model RegionalHub {
  id        String   @id @default(cuid())
  name      String
  region    String
  country   String?
  currency  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  recipientId   String
  recipientType String
  amount        Float
  method        String
  description   String?
  status        String   @default("pending")
  providerRef   String?
  details       Json?
  createdAt     DateTime @default(now())
  processedAt   DateTime?
}

model ProfileQuestionResponse {
  id           String   @id @default(cuid())
  userId       String   @unique
  questionSet  String   @default("default")
  answers      Json
  insights     Json?
  source       String?  @default("qmoi")
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
