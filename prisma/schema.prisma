// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  name              String?
  avatar            String?
  role              String   @default("user")
  permissions       String   @default("[]") // JSON string array of permissions
  biometricEnabled  Boolean  @default(false)
  accountStatus     String   @default("active")
  trustScore        Float    @default(0.5)
  lastLogin         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  devices           Device[]
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String
  platform     String
  status       String   @default("offline")
  lastSync     DateTime?
  location     String?
  battery      Int?
  ipAddress    String?
  osVersion    String?
  memoryTotal  Int?
  memoryUsed   Int?
  memoryFree   Int?
  storageTotal Int?
  storageUsed  Int?
  storageFree  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  riskLevel String
  status    String
  sessionId String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([username])
}

model SystemMetric {
  id           String   @id @default(cuid())
  metricType   String
  metricName   String
  value        Float
  unit         String?
  category     String
  subsystem    String?
  dimensions   String?
  tags         String?
  source       String?
  collectedBy  String?
  createdAt    DateTime @default(now())
  
  @@index([category])
  @@index([metricName])
}

model EmergencyConfig {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  alertThresholds       String   @default("{}")
  autoActions           String   @default("{}")
  notificationChannels  String   @default("[]")
  emergencyContacts     String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String
  status    String   @default("pending")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}
